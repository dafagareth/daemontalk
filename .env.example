# Environment configuration for daemontalk
# Rename this file to .env and configure the values below.

# HTTP server port
PORT=8080

# Environment mode: 'development' or 'production'
# In production, logs will be formatted as JSON instead of readable text.
ENV=development

# Secret admin token for comment moderation and Web Studio editor (/admin?admin=YOUR_TOKEN)
ADMIN_TOKEN=dev-secret-token

# SMTP Configuration for Contact Form (Optional)
# If left blank, contact messages will only be logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# GitHub Token for higher rate limits on popular posts retrieval (Optional)
GITHUB_TOKEN=
