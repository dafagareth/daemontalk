# Environment configuration for daemontalk
# Copy this file to .env and configure the values below.

# HTTP server listening port
PORT=8080

# Wish SSH server port for remote TUI access (ssh daemontalk.com -p 2222)
SSH_PORT=2222

# Environment mode: 'development' or 'production'
# In production, logs are formatted as JSON for structured logging.
ENV=development

# Canonical base URL for RSS feeds, sitemaps, and OpenGraph preview cards
BASE_URL=https://daemontalk.com

# Secret admin token for comment moderation and Web Studio editor (/admin?admin=YOUR_TOKEN)
ADMIN_TOKEN=dev-secret-token

# SMTP Configuration for Contact Form (Optional)
# If left blank, contact messages will be logged without failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# GitHub Token for higher API rate limits on repository metadata (Optional)
GITHUB_TOKEN=
