# DaemonTalk Environment Configuration
# Copy this file to .env: cp .env.example .env

# Server
PORT=8080
ENV=development
BASE_URL=http://localhost:8080

# Security & Admin
ADMIN_TOKEN=dev-secret-token
SESSION_SECRET=change-this-to-a-random-32-character-secret

# Data & Content Paths (Optional, defaults shown)
CONTENT_DIR=content
DATA_DIR=data

# GitHub OAuth for Discussions/Comments (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fast Content Sync Webhook (Optional)
GITHUB_WEBHOOK_SECRET=

# GitHub API Token for Colophon Profile Stats (Optional)
GITHUB_TOKEN=

# SMTP for Contact Form (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=
