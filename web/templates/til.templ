package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ TILPage(ui i18n.UI, posts []post.Post, lang string) {
	<section class="container-page py-8 sm:py-12">
		<div class="mb-8">
			<h1 class="display text-2xl sm:text-3xl font-semibold text-text">{ ui.TIL_Title }</h1>
			<p class="text-sm text-muted mt-1">Short notes on things I&#39;ve learned recently.</p>
		</div>
		if len(posts) == 0 {
			<p class="text-sm text-muted">{ ui.TIL_NoPosts }</p>
		} else {
			<ul>
				for _, p := range posts {
					@tilItem(p, lang)
				}
			</ul>
		}
	</section>
}

templ tilItem(p post.Post, lang string) {
	<li class="py-4">
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h2 class="text-sm font-medium text-link group-hover:underline">{ p.Title }</h2>
				if p.Description != "" {
					<p class="text-xs text-muted mt-1 line-clamp-2">{ p.Description }</p>
				}
				if len(p.Tags) > 0 {
					<div class="flex flex-wrap gap-1.5 mt-2">
						for _, t := range p.Tags {
							<span class="text-xs px-1.5 py-0.5 bg-chip text-muted rounded-none font-mono">{ t }</span>
						}
					</div>
				}
			</div>
			<span class="text-xs text-muted shrink-0 font-mono">{ fmtDate(p) }</span>
		</a>
	</li>
}
