package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ TagPortal(ui i18n.UI, tag string, allPosts []post.Post, lang string, viewCounts map[string]int) {
	<div class="w-full">
		<div class="mb-5 sm:mb-6 pt-3 sm:pt-2 px-4 sm:px-0">
			<div class="flex items-center justify-between gap-4 mb-3 text-xs font-mono text-muted">
				<a href={ templ.SafeURL(blogPrefix(lang) + "/") } class="hover:text-link transition-colors inline-flex items-center gap-1.5 group font-bold uppercase tracking-wider">
					@IconArrowLeft("w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5")
					<span>
						if lang == "id" {
							Semua Tulisan
						} else {
							All Dispatches
						}
					</span>
				</a>
			</div>
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
				<div class="flex items-baseline gap-3">
					<h1 class="text-3xl sm:text-4xl font-sans font-black uppercase tracking-tight text-text">
						{ tag }
					</h1>
				</div>
				<p class="text-xs font-mono text-muted">
					if lang == "id" {
						{ fmt.Sprintf("%d tulisan diterbitkan dalam topik ini", len(allPosts)) }
					} else {
						{ fmt.Sprintf("%d dispatches published in this archive", len(allPosts)) }
					}
				</p>
			</div>
		</div>
		if len(allPosts) == 0 {
			<div class="py-16 sm:py-20 px-6 text-center border sm:border-2 border-border bg-surface/30 my-4 flex flex-col items-center justify-center">
				<div class="w-14 h-14 rounded-full bg-surface border border-border flex items-center justify-center mb-5 text-accent shadow-sm">
					@IconTerminalPrompt("w-7 h-7")
				</div>
				<h2 class="display text-xl sm:text-2xl font-bold text-text mb-3">
					if lang == "id" {
						Yaaa posts nya belum ada, nantikan yaaa di daemontalk...
					} else {
						Oops, no dispatches found for #{ tag } yet. Stay tuned on daemontalk!
					}
				</h2>
				<p class="text-xs sm:text-sm text-muted font-mono max-w-md mb-8 leading-relaxed">
					if lang == "id" {
						Artikel untuk topik ini sedang dalam tahap kurasi dan penulisan mendalam. Silakan cek topik menarik lainnya!
					} else {
						Articles for this topic are currently being curated and written. Check back soon or explore other topics!
					}
				</p>
				<a href={ templ.SafeURL(blogPrefix(lang) + "/") } class="px-5 py-2.5 bg-text text-bg hover:opacity-90 font-mono text-xs font-bold uppercase tracking-wider transition-opacity inline-flex items-center gap-2">
					@IconArrowLeft("w-4 h-4")
					<span>
						if lang == "id" {
							Kembali ke Beranda
						} else {
							Back to Homepage
						}
					</span>
				</a>
			</div>
		} else {
			<div class="border sm:border-2 border-border p-4 sm:p-6 lg:p-8 bg-bg">
				<div id="tag-river-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7">
					for i := 0; i < 8 && i < len(allPosts); i++ {
						@tagArchiveCard(ui, allPosts[i], lang, i)
					}
				</div>
			</div>
			if len(allPosts) > 8 {
				<div id="tag-river-load-more" class="py-8 flex justify-center">
					<button
						hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=8", blogPrefix(lang), tag) }
						hx-trigger="click"
						hx-target="#tag-river-load-more"
						hx-swap="outerHTML"
						class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
						aria-label="Load more dispatches"
						title="Load more dispatches"
					>
						@IconArrowDown("w-5 h-5 transition-transform group-hover:translate-y-0.5")
					</button>
				</div>
			}
		}
	</div>
}

templ tagArchiveCard(ui i18n.UI, p post.Post, lang string, idx int) {
	<article class="flex flex-col justify-between group">
		<div class="sm:hidden flex flex-row-reverse items-start gap-3.5 py-3.5 border-b border-border/40 justify-between">
			if p.Cover != "" {
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="w-24 aspect-[16/9] shrink-0 bg-surface overflow-hidden border border-border block">
					@postThumbnailImg(p)
				</a>
			}
			<div class="flex-1 min-w-0">
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-1">
					<h3 class="display text-sm font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
						{ p.Title }
					</h3>
				</a>
				<div class="text-[10px] font-mono text-muted flex items-center gap-1.5 pt-1">
					<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
					<span>·</span>
					<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
		<div class="hidden sm:flex flex-col justify-between h-full">
			<div>
				if p.Cover != "" {
					<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border border-border group-hover:border-link/60 transition-colors mb-3">
						@postThumbnailImg(p)
					</a>
				}
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-2">
					<h3 class="display text-sm md:text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-3">
						{ p.Title }
					</h3>
				</a>
			</div>
			<div class="text-xs font-mono text-muted flex items-center gap-2 pt-2 mt-auto">
				<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
				<span>·</span>
				<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>
		</div>
	</article>
}

templ TagRiverItems(ui i18n.UI, posts []post.Post, lang string, startIdx int, nextOffset int, remaining int, tag string) {
	<div id="tag-river-grid" hx-swap-oob="beforeend">
		for idx, p := range posts {
			@tagArchiveCard(ui, p, lang, startIdx+idx)
		}
	</div>
	if remaining > 0 {
		<div id="tag-river-load-more" class="py-8 flex justify-center">
			<button
				hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=%d", blogPrefix(lang), tag, nextOffset) }
				hx-trigger="click"
				hx-target="#tag-river-load-more"
				hx-swap="outerHTML"
				class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
				aria-label="Load more dispatches"
				title="Load more dispatches"
			>
				@IconArrowDown("w-5 h-5 transition-transform group-hover:translate-y-0.5")
			</button>
		</div>
	}
}
