package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ TagPortal(ui i18n.UI, tag string, allPosts []post.Post, lang string, viewCounts map[string]int) {
	<div class="w-full">
		<!-- MINIMALIST MONOLITH TAG HEADER & BREADCRUMB -->
		<div class="mb-6 sm:mb-8 pt-3 sm:pt-2 px-4 sm:px-0">
			<!-- Breadcrumb & Back Navigation -->
			<div class="flex items-center justify-between gap-4 mb-4 text-xs font-mono text-muted">
				<a href={ templ.SafeURL(blogPrefix(lang) + "/") } class="hover:text-link transition-colors inline-flex items-center gap-1.5 group font-bold uppercase tracking-wider">
					@IconArrowLeft("w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5")
					<span>
						if lang == "id" {
							Semua Tulisan
						} else {
							All Dispatches
						}
					</span>
				</a>
				<span class="text-[11px] uppercase tracking-widest text-muted/80">Topic Archive</span>
			</div>

			<!-- Large Headline & Dispatches Counter -->
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b-2 border-border">
				<div class="flex items-baseline gap-3">
					<h1 class="text-3xl sm:text-4xl font-sans font-black uppercase tracking-tight text-text">
						{ tag }
					</h1>
				</div>
				<p class="text-xs font-mono text-muted">
					if lang == "id" {
						{ fmt.Sprintf("%d tulisan diterbitkan dalam topik ini", len(allPosts)) }
					} else {
						{ fmt.Sprintf("%d dispatches published in this archive", len(allPosts)) }
					}
				</p>
			</div>
		</div>

		if len(allPosts) == 0 {
			<div class="p-12 text-center text-sm font-mono text-muted border-2 border-border bg-surface">
				No dispatches found for #{ tag }
			</div>
		} else {
			// =========================================================
			// FULL EDITORIAL SPOTLIGHT + STREAM RIVER (CONTINUOUS SCROLL)
			// =========================================================

			// TINGKAT 1: TOPIC HERO SPOTLIGHT (8 : 4 Asymmetric Desktop / Lead + Duet 2-Col Mobile)
			<div class="border-0 sm:border-x-2 sm:border-y-2 sm:border-border w-full mb-0 bg-bg">
				<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
					
					// LEFT (8 cols): Main Featured Lead Story for Tag
					<div class="lg:col-span-8 flex flex-col justify-between group">
						<div>
							if allPosts[0].Cover != "" {
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[0].Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border-b border-border">
									@postThumbnailImg(allPosts[0])
								</a>
							}
							<div class="p-5 sm:p-6 lg:px-7 lg:py-12">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[0].Slug) } class="block mb-3">
									<h2 class="display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text group-hover:text-link transition-colors leading-[1.18] tracking-tight">
										{ allPosts[0].Title }
									</h2>
								</a>
								if allPosts[0].Description != "" {
									<p class="text-sm sm:text-base text-muted line-clamp-3 leading-relaxed mb-4">
										{ allPosts[0].Description }
									</p>
								}
							</div>
						</div>
						<div class="px-5 sm:px-6 lg:px-7 pb-5 flex items-center justify-between text-xs font-mono text-muted border-t border-border/30 pt-3">
							<span class="font-bold text-text">
								if allPosts[0].Author != "" {
									{ allPosts[0].Author }
								} else {
									daemontalk
								}
							</span>
							<div class="flex items-center gap-2">
								<time datetime={ allPosts[0].Date.Format("2006-01-02") }>{ fmtDate(allPosts[0]) }</time>
								<span>·</span>
								<span>{ fmt.Sprintf("%d %s", allPosts[0].ReadTime, ui.Blog_MinRead) }</span>
							</div>
						</div>
					</div>

					// RIGHT (4 cols on Desktop / Duet 2-Col on Mobile): Secondary Stories (allPosts[1..2])
					<div class="lg:col-span-4 grid grid-cols-2 lg:grid-cols-1 divide-x lg:divide-x-0 lg:divide-y divide-[var(--c-border)]">
						if len(allPosts) > 1 {
							for i := 1; i <= 2 && i < len(allPosts); i++ {
								<article class="flex flex-col justify-between flex-1 group">
									<div>
										if allPosts[i].Cover != "" {
											<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[i].Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border-b border-border">
												@postThumbnailImg(allPosts[i])
											</a>
										}
										<div class="p-3.5 sm:p-5">
											<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[i].Slug) } class="block mb-1.5">
												<h3 class="display text-xs sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
													{ allPosts[i].Title }
												</h3>
											</a>
											if allPosts[i].Description != "" {
												<p class="hidden sm:block text-xs text-muted line-clamp-2 leading-relaxed mb-2">
													{ allPosts[i].Description }
												</p>
											}
										</div>
									</div>
									<div class="px-3.5 sm:px-5 pb-3 sm:pb-4 text-[9px] sm:text-[10px] font-mono text-muted flex items-center justify-between border-t border-border/30 pt-2 mt-auto">
										<time>{ fmtDate(allPosts[i]) }</time>
										<span>{ fmt.Sprintf("%d %s", allPosts[i].ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</article>
							}
						}
					</div>

				</div>
			</div>

			// TINGKAT 2: FEATURED TOPIC TRIO (4 : 4 : 4)
			if len(allPosts) > 3 {
				<div class="border-0 sm:border-x-2 sm:border-b-2 sm:border-border w-full mt-0 mb-0 bg-bg">
					<div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--c-border)]">
						for i := 3; i <= 5 && i < len(allPosts); i++ {
							<article class="flex flex-col justify-between group">
								<div>
									if allPosts[i].Cover != "" {
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[i].Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border-b border-border">
											@postThumbnailImg(allPosts[i])
										</a>
									}
									<div class="p-4 sm:p-5">
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + allPosts[i].Slug) } class="block mb-1.5">
											<h3 class="display text-sm sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
												{ allPosts[i].Title }
											</h3>
										</a>
										if allPosts[i].Description != "" {
											<p class="text-xs text-muted line-clamp-2 leading-relaxed mb-2">
												{ allPosts[i].Description }
											</p>
										}
									</div>
								</div>
								<div class="px-4 sm:px-5 pb-4 text-[10px] font-mono text-muted flex items-center justify-between border-t border-border/30 mt-auto pt-2">
									<time>{ fmtDate(allPosts[i]) }</time>
									<span>{ fmt.Sprintf("%d %s", allPosts[i].ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</article>
						}
					</div>
				</div>
			}

			// TINGKAT 3: THE DISPATCH RIVER (2-Kolom Continuous Stream)
			if len(allPosts) > 6 {
				<div class="border-0 sm:border-x-2 sm:border-b-2 sm:border-border w-full mt-0 mb-0 sm:mb-0 bg-bg">
					<div class="flex items-center justify-between px-5 py-3 border-b-2 border-border bg-surface text-xs font-mono font-bold uppercase tracking-wider">
						<span class="text-accent">CHRONOLOGICAL ARCHIVE RIVER</span>
						<span class="text-muted text-[10px] lowercase">{ fmt.Sprintf("%d dispatches in stream", len(allPosts)-6) }</span>
					</div>

					<div id="tag-river-grid" class="grid grid-cols-1 md:grid-cols-2">
						for idx, p := range initialRiverPosts(allPosts, 6, 6) {
							@tagRiverItem(ui, p, lang, idx)
						}
					</div>
				</div>

				if len(allPosts) > 12 {
					<div id="tag-river-load-more" class="py-8 flex justify-center">
						<button
							hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=12", blogPrefix(lang), tag) }
							hx-trigger="click"
							hx-target="#tag-river-load-more"
							hx-swap="outerHTML"
							class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
							aria-label="Load more dispatches"
							title="Load more dispatches"
						>
							@IconArrowDown("w-5 h-5 transition-transform group-hover:translate-y-0.5")
						</button>
					</div>
				}
			}
		}
	</div>
}

func initialRiverPosts(posts []post.Post, offset int, count int) []post.Post {
	if offset >= len(posts) {
		return nil
	}
	end := offset + count
	if end > len(posts) {
		end = len(posts)
	}
	return posts[offset:end]
}

templ TagRiverItems(ui i18n.UI, posts []post.Post, lang string, startIdx int, nextOffset int, remaining int, tag string) {
	<div id="tag-river-grid" hx-swap-oob="beforeend">
		for idx, p := range posts {
			@tagRiverItem(ui, p, lang, startIdx+idx)
		}
	</div>
	if remaining > 0 {
		<div id="tag-river-load-more" class="py-8 flex justify-center">
			<button
				hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=%d", blogPrefix(lang), tag, nextOffset) }
				hx-trigger="click"
				hx-target="#tag-river-load-more"
				hx-swap="outerHTML"
				class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
				aria-label="Load more dispatches"
				title="Load more dispatches"
			>
				@IconArrowDown("w-5 h-5 transition-transform group-hover:translate-y-0.5")
			</button>
		</div>
	}
}

templ tagRiverItem(ui i18n.UI, p post.Post, lang string, idx int) {
	<article class={
		"p-4 sm:p-5 flex flex-col justify-between group border-border/60",
		templ.KV("md:border-r", idx%2 == 0),
		templ.KV("border-t", idx >= 2 || idx == 1),
	}>
		<div>
			if p.Cover != "" {
				<div class="flex flex-row gap-3.5 sm:gap-4 items-start mb-2">
					<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="w-20 h-20 sm:w-36 sm:h-auto sm:aspect-[16/9] shrink-0 bg-surface overflow-hidden border border-border block">
						@postThumbnailImg(p)
					</a>
					<div class="flex-1 min-w-0">
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-1">
							<h4 class="display text-sm sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
								{ p.Title }
							</h4>
						</a>
						if p.Description != "" {
							<p class="hidden sm:block text-xs text-muted line-clamp-2 leading-relaxed">
								{ p.Description }
							</p>
						}
					</div>
				</div>
			} else {
				<div class="flex flex-col mb-2">
					<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-1">
						<h4 class="display text-sm sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
							{ p.Title }
						</h4>
					</a>
					if p.Description != "" {
						<p class="text-xs text-muted line-clamp-2 leading-relaxed">
							{ p.Description }
						</p>
					}
				</div>
			}
		</div>
		<div class="flex items-center justify-between text-[10px] font-mono text-muted pt-2 border-t border-border/30 mt-auto">
			<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p) }</time>
			<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
		</div>
	</article>
}
