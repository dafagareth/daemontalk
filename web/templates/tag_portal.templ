package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ TagPortal(ui i18n.UI, tag string, allPosts []post.Post, lang string, viewCounts map[string]int) {
	<div class="w-full">
		<div class="mb-6 sm:mb-8 pt-1 sm:pt-2">
			<div class="flex items-center justify-between gap-4 mb-3 text-xs font-sans text-muted">
				<a href={ templ.SafeURL(blogPrefix(lang) + "/") } class="hover:text-link transition-colors inline-flex items-center gap-1.5 group font-bold uppercase tracking-wider">
					@IconArrowLeft("w-3.5 h-3.5")
					<span>
						if lang == "id" {
							Semua Tulisan
						} else {
							All Dispatches
						}
					</span>
				</a>
			</div>
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
				<div class="flex items-baseline gap-3">
					<h1 class="text-3xl sm:text-4xl font-sans font-black uppercase tracking-tight text-text">
						{ tag }
					</h1>
				</div>
				<p class="text-xs font-sans text-muted">
					if lang == "id" {
						{ fmt.Sprintf("%d tulisan diterbitkan dalam topik ini", len(allPosts)) }
					} else {
						{ fmt.Sprintf("%d dispatches published in this archive", len(allPosts)) }
					}
				</p>
			</div>
		</div>
		if len(allPosts) == 0 {
			<div class="py-20 sm:py-28 px-6 sm:px-12 text-center border-0 sm:border border-border bg-transparent sm:bg-surface my-4 flex flex-col items-center justify-center font-sans">
				<h2 class="text-xl sm:text-2xl font-bold text-text mb-2 tracking-tight">
					if lang == "id" {
						Arsip #{ tag } Masih Kosong
					} else {
						Archive #{ tag } is Empty
					}
				</h2>
				<p class="text-xs sm:text-sm text-muted font-sans sm:whitespace-nowrap max-w-xl mx-auto mb-6 leading-relaxed">
					if lang == "id" {
						Belum ada artikel yang diterbitkan untuk kategori ini.
					} else {
						No dispatches have been published in this category yet.
					}
				</p>
				<a
					href={ templ.SafeURL(blogPrefix(lang) + "/") }
					class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans font-medium text-muted hover:text-text hover:bg-hover transition-colors group"
				>
					@IconArrowLeft("w-3.5 h-3.5")
					<span>
						if lang == "id" {
							Lihat Semua Tulisan
						} else {
							View All Dispatches
						}
					</span>
				</a>
			</div>
		} else {
			<div class="border-0 sm:border border-border p-0 sm:p-6 lg:p-8 bg-transparent sm:bg-bg">
				<div id="tag-river-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7">
					for i := 0; i < 8 && i < len(allPosts); i++ {
						@tagArchiveCard(ui, allPosts[i], lang, i)
					}
				</div>
			</div>
			if len(allPosts) > 8 {
				<div id="tag-river-load-more" class="py-8 flex justify-center">
					<button
						hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=8", blogPrefix(lang), tag) }
						hx-trigger="click"
						hx-target="#tag-river-load-more"
						hx-swap="outerHTML"
						class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
						aria-label="Load more dispatches"
						title="Load more dispatches"
					>
						@IconArrowDown("w-5 h-5")
					</button>
				</div>
			}
		}
	</div>
}

templ tagArchiveCard(ui i18n.UI, p post.Post, lang string, idx int) {
	<article class="flex flex-col justify-between group">
		<div class="sm:hidden flex flex-row-reverse items-start gap-3.5 py-4 border-b border-border/40 justify-between">
			if p.Cover != "" {
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="w-24 sm:w-28 aspect-[16/9] shrink-0 bg-surface overflow-hidden border border-border block mt-0.5">
					@postThumbnailImg(p)
				</a>
			}
			<div class="flex-1 min-w-0">
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-1.5">
					<h3 class="display text-base font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-3">
						{ p.Title }
					</h3>
				</a>
				<div class="text-xs font-sans text-muted flex items-center gap-1.5 pt-1">
					<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
					<span>·</span>
					<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
		<div class="hidden sm:flex flex-col justify-between h-full">
			<div>
				if p.Cover != "" {
					<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border border-border mb-3">
						@postThumbnailImg(p)
					</a>
				}
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-2">
					<h3 class="display text-base md:text-[17px] font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-3">
						{ p.Title }
					</h3>
				</a>
			</div>
			<div class="text-xs font-sans text-muted flex items-center gap-2 pt-2 mt-auto">
				<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
				<span>·</span>
				<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>
		</div>
	</article>
}

templ TagRiverItems(ui i18n.UI, posts []post.Post, lang string, startIdx int, nextOffset int, remaining int, tag string) {
	<div id="tag-river-grid" hx-swap-oob="beforeend">
		for idx, p := range posts {
			@tagArchiveCard(ui, p, lang, startIdx+idx)
		}
	</div>
	if remaining > 0 {
		<div id="tag-river-load-more" class="py-8 flex justify-center">
			<button
				hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=%d", blogPrefix(lang), tag, nextOffset) }
				hx-trigger="click"
				hx-target="#tag-river-load-more"
				hx-swap="outerHTML"
				class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
				aria-label="Load more dispatches"
				title="Load more dispatches"
			>
				@IconArrowDown("w-5 h-5")
			</button>
		</div>
	}
}
