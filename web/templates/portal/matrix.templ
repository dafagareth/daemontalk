package portal

import (
	"daemontalk/internal/i18n"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
)

templ PortalMatrix(ui i18n.UI, categories []CategorySection, lang string) {
	<section class="w-full bg-bg font-sans">
		<div class="flex items-center justify-between pb-3 mb-4 text-xs text-muted border-b border-border/30">
			<span class="font-mono text-xs font-bold uppercase tracking-wider text-text">
				CATEGORIES
			</span>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
			for _, cat := range categories {
				<div class="flex flex-col justify-between group">
					<div>
						<div class="flex items-center justify-between pb-2 mb-3">
							<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/tag/" + cat.Tag) } class="badge text-xs hover:underline flex items-center gap-1 group">
								<span>#{ cat.Tag }</span>
								@components.IconArrowRight("w-3 h-3 group-hover:translate-x-0.5 transition-transform")
							</a>
							if cat.LeadPost.Slug != "" {
								<span class="text-xs font-mono text-muted">
									{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }
								</span>
							}
						</div>
						if cat.LeadPost.Slug != "" {
							<article class="mb-4">
								<div class="relative aspect-[16/9] w-full bg-surface overflow-hidden mb-2.5 border border-border/30">
									@components.PostThumbnail(cat.LeadPost, shared.Prefix(lang)+"/blog/"+cat.LeadPost.Slug)
								</div>
								<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block group mb-1.5">
									<h3 class="card-title text-sm sm:text-base line-clamp-2">
										{ cat.LeadPost.Title }
									</h3>
								</a>
								if cat.LeadPost.Description != "" {
									<p class="text-xs text-muted line-clamp-2 leading-relaxed">
										{ cat.LeadPost.Description }
									</p>
								}
							</article>
						}
						if len(cat.SubPosts) > 0 {
							<div class="flex flex-col gap-2.5 pt-1">
								for _, sub := range cat.SubPosts {
									<article class="group">
										<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + sub.Slug) } class="block group">
											<h4 class="card-title text-xs sm:text-[13px] font-semibold line-clamp-2 mb-0.5">
												{ sub.Title }
											</h4>
										</a>
										<time class="text-[11px] font-mono text-muted" datetime={ sub.Date.Format("2006-01-02") }>
											{ shared.FmtDate(sub, lang) }
										</time>
									</article>
								}
							</div>
						}
					</div>
					<div class="pt-3 mt-3 flex justify-end">
						<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/tag/" + cat.Tag) } class="text-[11px] font-mono uppercase font-medium text-muted hover:text-accent flex items-center gap-1 group">
							<span>Explore topic</span>
							@components.IconArrowRight("w-3 h-3 group-hover:translate-x-0.5 transition-transform")
						</a>
					</div>
				</div>
			}
		</div>
	</section>
}
