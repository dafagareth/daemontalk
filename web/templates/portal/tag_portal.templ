package portal

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
	"strings"
)

var pillarHighlights = map[string][]string{
	"wire":   {"linux", "kernel", "networking", "security", "storage", "devops", "ebpf", "systemd"},
	"craft":  {"go", "rust", "backend", "database", "sqlite", "architecture", "concurrency", "performance"},
	"tools":  {"cli", "terminal", "neovim", "tmux", "git", "bash", "fzf", "debugging"},
	"radar":  {"ai", "llm", "agents", "open-weight", "inference", "wasm", "quantization"},
	"essays": {"opinion", "career", "freelance", "culture", "critique", "industry"},
}

var pillarDescriptions = map[string]string{
	"wire":   "Bare-metal systems, Linux kernel internals, networking protocols, security, and low-level infrastructure.",
	"craft":  "Software engineering, backend architecture, languages, concurrency patterns, and database design.",
	"tools":  "Developer environments, terminal workflows, CLI utilities, editors, automation, and productivity.",
	"radar":  "Emerging frontiers: machine learning models, local LLMs, AI agents, WebAssembly, and modern experiments.",
	"essays": "Critical perspectives on tech culture, engineering careers, industry realities, and personal manifestos.",
}

var pillarParent = map[string]string{
	"linux": "wire", "kernel": "wire", "networking": "wire", "security": "wire", "storage": "wire", "devops": "wire", "ebpf": "wire", "systemd": "wire",
	"go": "craft", "rust": "craft", "backend": "craft", "database": "craft", "sqlite": "craft", "architecture": "craft", "concurrency": "craft", "performance": "craft",
	"cli": "tools", "terminal": "tools", "neovim": "tools", "tmux": "tools", "git": "tools", "bash": "tools", "fzf": "tools", "debugging": "tools",
	"ai": "radar", "llm": "radar", "agents": "radar", "open-weight": "radar", "inference": "radar", "wasm": "radar", "quantization": "radar",
	"opinion": "essays", "career": "essays", "freelance": "essays", "culture": "essays", "critique": "essays", "industry": "essays",
}

func resolvePillar(tag string) string {
	tl := strings.ToLower(tag)
	if _, ok := pillarHighlights[tl]; ok {
		return tl
	}
	if p, ok := pillarParent[tl]; ok {
		return p
	}
	return ""
}

templ TagPortal(ui i18n.UI, tag string, allPosts []post.Post, lang string, viewCounts map[string]int) {
	{{ currentPillar := resolvePillar(tag) }}
	<div class="w-full">
		<div class="pt-1 sm:pt-2">
			<div class="flex items-center justify-between gap-4 mb-3 text-xs font-sans text-muted">
				<a href={ templ.SafeURL(shared.Prefix(lang) + "/") } class="hover:text-link transition-colors inline-flex items-center gap-1.5 group font-bold uppercase tracking-wider">
					@components.IconArrowLeft("w-3.5 h-3.5")
					<span>
						All Dispatches
					</span>
				</a>
				<span class="text-xs font-sans text-muted tabular-nums">
					{ fmt.Sprintf("%d dispatches", len(allPosts)) }
				</span>
			</div>
			<div class="flex items-baseline gap-3">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-sans font-black uppercase tracking-tight text-text">
					{ tag }
				</h1>
			</div>
			if desc, ok := pillarDescriptions[strings.ToLower(tag)]; ok {
				<p class="text-sm text-muted font-sans mt-2 max-w-2xl leading-relaxed">
					{ desc }
				</p>
			}
			if currentPillar != "" {
				<div class="border-b border-border mt-6 sm:mt-8">
					<div class="flex items-center gap-6 sm:gap-8 overflow-x-auto scrollbar-none text-xs font-sans uppercase tracking-wider">
						<a
							href={ templ.SafeURL(shared.Prefix(lang) + "/blog/tag/" + currentPillar) }
							class={
								"pb-2.5 whitespace-nowrap transition-colors border-b-2 font-semibold",
								templ.KV("border-text text-text font-bold", strings.EqualFold(tag, currentPillar)),
								templ.KV("border-transparent text-muted hover:text-text", !strings.EqualFold(tag, currentPillar)),
							}
						>
							{ "All " + currentPillar }
						</a>
						for _, ct := range pillarHighlights[currentPillar] {
							<a
								href={ templ.SafeURL(shared.Prefix(lang) + "/blog/tag/" + ct) }
								class={
									"pb-2.5 whitespace-nowrap transition-colors border-b-2 font-semibold",
									templ.KV("border-text text-text font-bold", strings.EqualFold(tag, ct)),
									templ.KV("border-transparent text-muted hover:text-text", !strings.EqualFold(tag, ct)),
								}
							>
								{ ct }
							</a>
						}
					</div>
				</div>
			}
		</div>
		if len(allPosts) == 0 {
			<div class="py-20 sm:py-28 px-6 sm:px-12 text-center my-6 flex flex-col items-center justify-center font-sans">
				<h2 class="text-xl sm:text-2xl font-bold text-text mb-2 tracking-tight">
					Archive #{ tag } is Empty
				</h2>
				<p class="text-xs sm:text-sm text-muted font-sans sm:whitespace-nowrap max-w-xl mx-auto mb-6 leading-relaxed">
					No dispatches have been published in this category yet.
				</p>
				<a
					href={ templ.SafeURL(shared.Prefix(lang) + "/") }
					class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans font-medium text-muted hover:text-text hover:bg-hover transition-colors group"
				>
					@components.IconArrowLeft("w-3.5 h-3.5")
					<span>
						View All Dispatches
					</span>
				</a>
			</div>
		} else {
			<!-- Lead Story + Secondary Highlights -->
			<div class="mt-8 sm:mt-10">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
					<!-- Lead Story -->
					<article class={ "flex flex-col group", templ.KV("lg:col-span-7", len(allPosts) > 1), templ.KV("lg:col-span-12", len(allPosts) <= 1) }>
						if allPosts[0].Cover != "" {
							<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + allPosts[0].Slug) } class="block aspect-[16/9] w-full bg-surface overflow-hidden border border-border mb-4">
								@components.PostThumbnailImg(allPosts[0])
							</a>
						}
						<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + allPosts[0].Slug) } class="block group mb-2.5">
							<h2 class="text-xl sm:text-2xl md:text-3xl font-black text-text group-hover:text-link transition-colors leading-tight">
								{ allPosts[0].Title }
							</h2>
						</a>
						if allPosts[0].Description != "" {
							<p class="text-sm text-muted line-clamp-3 leading-relaxed mb-3">
								{ allPosts[0].Description }
							</p>
						}
						<div class="feed-meta">
							<time datetime={ allPosts[0].Date.Format("2006-01-02") }>{ shared.FmtDate(allPosts[0], lang) }</time>
							<span>·</span>
							<span>{ fmt.Sprintf("%d %s", allPosts[0].ReadTime, ui.Blog_MinRead) }</span>
						</div>
					</article>
					<!-- Secondary Dispatches -->
					if len(allPosts) > 1 {
						<div class="lg:col-span-5 flex flex-col divide-y divide-border/60">
							for i := 1; i < 4 && i < len(allPosts); i++ {
								<article class="py-4 first:pt-0 last:pb-0 flex flex-col group">
									<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + allPosts[i].Slug) } class="block group mb-1.5">
										<h3 class="text-base sm:text-lg font-bold text-text group-hover:text-link transition-colors leading-snug">
											{ allPosts[i].Title }
										</h3>
									</a>
									if allPosts[i].Description != "" {
										<p class="text-xs text-muted line-clamp-2 leading-relaxed mb-2">
											{ allPosts[i].Description }
										</p>
									}
									<div class="feed-meta">
										<time datetime={ allPosts[i].Date.Format("2006-01-02") }>{ shared.FmtDate(allPosts[i], lang) }</time>
										<span>·</span>
										<span>{ fmt.Sprintf("%d %s", allPosts[i].ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</article>
							}
						</div>
					}
				</div>
			</div>
			<!-- Archive River (from item 4 onwards) -->
			if len(allPosts) > 4 {
				<div class="mt-12 pt-8 border-t border-border">
					<div class="text-xs font-sans uppercase tracking-wider font-bold text-muted mb-6">
						Archive Dispatches
					</div>
					<div id="tag-river-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
						for i := 4; i < 8 && i < len(allPosts); i++ {
							@tagArchiveCard(ui, allPosts[i], lang, i)
						}
					</div>
				</div>
			} else {
				<div id="tag-river-grid" class="hidden"></div>
			}
			if len(allPosts) > 8 {
				<div id="tag-river-load-more" class="py-8 flex justify-center">
					<button
						hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=8", shared.Prefix(lang), tag) }
						hx-trigger="click"
						hx-target="#tag-river-load-more"
						hx-swap="outerHTML"
						class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
						aria-label="Load more dispatches"
						title="Load more dispatches"
					>
						@components.IconArrowDown("w-5 h-5")
					</button>
				</div>
			}
		}
	</div>
}

templ tagArchiveCard(ui i18n.UI, p post.Post, lang string, idx int) {
	<article class="flex flex-col justify-between group">
		<div class="sm:hidden card-row flex-row-reverse items-start gap-3.5 justify-between">
			if p.Cover != "" {
				<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + p.Slug) } class="w-24 sm:w-28 aspect-[16/9] shrink-0 bg-surface overflow-hidden border border-border block mt-0.5">
					@components.PostThumbnailImg(p)
				</a>
			}
			<div class="flex-1 min-w-0">
				<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + p.Slug) } class="block mb-1.5">
					<h3 class="card-title text-base line-clamp-3">
						{ p.Title }
					</h3>
				</a>
				<div class="feed-meta pt-1">
					<time datetime={ p.Date.Format("2006-01-02") }>{ shared.FmtDate(p, lang) }</time>
					<span>·</span>
					<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
		<div class="hidden sm:flex flex-col justify-between h-full">
			<div>
				if p.Cover != "" {
					<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + p.Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border border-border mb-3">
						@components.PostThumbnailImg(p)
					</a>
				}
				<a href={ templ.SafeURL(shared.Prefix(lang) + "/blog/" + p.Slug) } class="block mb-2">
					<h3 class="card-title text-base md:text-[17px] line-clamp-3">
						{ p.Title }
					</h3>
				</a>
			</div>
			<div class="feed-meta pt-2 mt-auto">
				<time datetime={ p.Date.Format("2006-01-02") }>{ shared.FmtDate(p, lang) }</time>
				<span>·</span>
				<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>
		</div>
	</article>
}

templ TagRiverItems(ui i18n.UI, posts []post.Post, lang string, startIdx int, nextOffset int, remaining int, tag string) {
	<div id="tag-river-grid" hx-swap-oob="beforeend">
		for idx, p := range posts {
			@tagArchiveCard(ui, p, lang, startIdx+idx)
		}
	</div>
	if remaining > 0 {
		<div id="tag-river-load-more" class="py-8 flex justify-center">
			<button
				hx-get={ fmt.Sprintf("%s/blog/tag-posts?tag=%s&offset=%d", shared.Prefix(lang), tag, nextOffset) }
				hx-trigger="click"
				hx-target="#tag-river-load-more"
				hx-swap="outerHTML"
				class="p-2.5 sm:p-3 text-muted hover:text-text hover:bg-hover border border-border transition-colors group cursor-pointer"
				aria-label="Load more dispatches"
				title="Load more dispatches"
			>
				@components.IconArrowDown("w-5 h-5")
			</button>
		</div>
	}
}
