package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsDetailPage(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	t *forum.Topic,
	replies []*forum.Reply,
) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-6">
			<a
				href={ templ.SafeURL(prefix(lang) + "/socket") }
				class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@IconArrowLeft("w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform")
				<span>
					if lang == "id" {
						Kembali ke Socket
					} else {
						Back to Socket
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight">
				{ t.Title }
			</h1>
		</div>
		<div class="sm:border sm:border-muted/30 sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden font-sans space-y-6 sm:space-y-0">
			<!-- TOPIC CARD: cat /dev/socket/{id} -->
			<div class="border border-muted/30 bg-surface/20 sm:border-0 sm:bg-transparent overflow-hidden">
				<div class="border-b border-muted/30 bg-surface px-4 py-3 sm:px-6 sm:py-3.5 flex items-center justify-between text-xs sm:text-sm font-mono select-none flex-wrap gap-3">
					<div class="flex items-center gap-2.5 sm:gap-3 text-text font-bold min-w-0">
						<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
						<code class="text-xs sm:text-sm font-mono truncate">cat /dev/socket/{ fmt.Sprintf("%d", t.ID) }</code>
					</div>
					<div class="flex items-center gap-2 flex-wrap text-muted text-xs">
						if t.IsSolved {
							<span class="px-2 py-0.5 bg-text text-bg font-mono font-bold text-[10px] sm:text-xs uppercase tracking-wider select-none shadow-sm">
								✓ SOLVED
							</span>
						}
						<span>{ fmt.Sprintf("%d views", t.ViewsCount) }</span>
						<span class="text-muted/40">·</span>
						<time datetime={ t.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">{ timeAgoOrDate(t.CreatedAt, lang) }</time>
					</div>
				</div>
				<div class="p-4 sm:p-8 space-y-5">
					<div class="flex items-center justify-between gap-3 text-xs font-mono text-muted">
						<div class="flex items-center gap-3 min-w-0">
							if t.AuthorAvatar != "" {
								<img src={ t.AuthorAvatar } alt={ t.AuthorUsername } class="w-8 h-8 sm:w-9 sm:h-9 rounded-none border border-muted/30 object-cover shrink-0"/>
							} else {
								<img src="/static/images/deleted-user.png" alt="Deleted User" class="w-8 h-8 sm:w-9 sm:h-9 rounded-none border border-muted/30 object-cover shrink-0"/>
							}
							<div class="min-w-0">
								if t.AuthorGitHub != "" {
									<a href={ templ.SafeURL(t.AuthorGitHub) } target="_blank" rel="noopener" class="font-bold text-text hover:text-link hover:underline truncate text-sm sm:text-base block">
										{ "@" + t.AuthorUsername }
									</a>
								} else if t.AuthorUsername != "" && t.AuthorUsername != "ghost" {
									<span class="font-bold text-text truncate text-sm sm:text-base block">{ "@" + t.AuthorUsername }</span>
								} else {
									<span class="font-bold text-text truncate text-sm sm:text-base block">{ t.AuthorName }</span>
								}
								if t.AuthorName != "" && t.AuthorName != t.AuthorUsername && t.AuthorName != "Deleted User" {
									<span class="text-[11px] text-muted/60">({ t.AuthorName })</span>
								}
							</div>
						</div>
						if currentUser != nil && (currentUser.ID == t.UserID || currentUser.Role == "admin") {
							<details class="relative comment-menu">
								<summary class="p-1.5 -m-1 text-muted hover:text-text focus:outline-none cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-center transition-colors" title="Options">
									<svg xmlns="http://www.w3.org/2005/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
								</summary>
								<div class="absolute right-0 mt-2 w-36 bg-surface border border-muted/30 shadow-2xl z-20 font-mono text-xs overflow-hidden py-1">
									<form
										hx-post={ fmt.Sprintf("/socket/%d/delete", t.ID) }
										if lang == "id" {
											hx-confirm="Yakin ingin menghapus topik diskusi ini secara permanen?"
										} else {
											hx-confirm="Delete this discussion topic permanently?"
										}
										class="block"
									>
										<button
											type="submit"
											class="w-full text-left px-3.5 py-2 hover:bg-hover hover:text-rose-500 text-text cursor-pointer transition-colors flex items-center gap-2"
											onclick="this.closest('details').removeAttribute('open')"
										>
											<svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
											<span>
												if lang == "id" {
													Hapus Topik
												} else {
													Delete Topic
												}
											</span>
										</button>
									</form>
								</div>
							</details>
						}
					</div>
					<div class="prose max-w-none text-text text-sm sm:text-base leading-relaxed font-sans">
						@templ.Raw(string(t.BodyHTML))
					</div>
					<div class="flex items-center justify-between pt-4 border-t border-muted/25 text-xs font-mono flex-wrap gap-3">
						<div class="flex items-center gap-2.5 flex-wrap">
							@DiscussionsVoteButton("topic", t.ID, t.VotesCount, t.UserVoted)
							if len(t.Tags) > 0 {
								for _, tag := range t.Tags {
									<a
										href={ templ.SafeURL(fmt.Sprintf("%s/socket?tag=%s", prefix(lang), tag)) }
										class="text-accent hover:underline font-mono text-xs font-bold mr-1"
									>
										{ "#" + tag }
									</a>
								}
							}
						</div>
						<div>
							<button
								type="button"
								onclick="var form = document.getElementById('reply-form'); if(form){ form.scrollIntoView({behavior:'smooth'}); var ta = form.querySelector('textarea'); if(ta){ ta.focus(); } }"
								class="text-muted hover:text-text hover:underline cursor-pointer font-mono text-xs font-semibold"
							>
								if lang == "id" {
									Balas
								} else {
									Reply
								}
							</button>
						</div>
					</div>
				</div>
			</div>
			<!-- REPLIES LIST: grep replies /dev/socket/{id} -->
			<div class="-mx-4 sm:mx-0 border-y border-muted/30 sm:border-y-0 sm:border-t sm:border-muted/30 bg-surface/5 sm:bg-transparent mt-6 sm:mt-0">
				<div class="px-4 sm:px-6 py-3.5 bg-surface border-b border-muted/30 text-xs font-mono flex items-center justify-between text-muted select-none">
					<div class="flex items-center gap-2 text-text font-bold">
						<span class="text-link font-black">❯</span>
						<span>grep --replies /dev/socket/{ fmt.Sprintf("%d", t.ID) }</span>
					</div>
					<span class="text-xs text-muted font-bold">
						if lang == "id" {
							{ fmt.Sprintf("%d BALASAN", len(replies)) }
						} else {
							{ fmt.Sprintf("%d REPLIES", len(replies)) }
						}
					</span>
				</div>
				if len(replies) == 0 {
					<div class="p-8 text-center text-xs font-mono text-muted">
						if lang == "id" {
							Belum ada balasan untuk topik ini.
						} else {
							No replies for this topic yet.
						}
					</div>
				} else {
					<div class="divide-y divide-muted/25">
						for _, r := range replies {
							@DiscussionsReplyItem(ui, lang, currentUser, r, t.ID, t.UserID)
						}
					</div>
				}
			</div>
			<!-- REPLY FORM: write /dev/socket/{id}/reply -->
			<div id="reply-form" class="-mx-4 sm:mx-0 border-y border-muted/30 sm:border-y-0 sm:border-t sm:border-muted/30 bg-surface/5 sm:bg-transparent mt-6 sm:mt-0">
				<div class="border-b border-muted/30 bg-surface px-4 sm:px-6 py-3.5 flex items-center justify-between text-xs font-mono select-none">
					<div class="flex items-center gap-2 text-text font-bold">
						<span class="text-link font-black">❯</span>
						<span>write /dev/socket/{ fmt.Sprintf("%d", t.ID) }/reply</span>
					</div>
					if currentUser != nil {
						<div class="text-muted text-[11px] flex items-center gap-1.5">
							<span>AUTHOR:</span>
							<span class="text-text font-bold">{ "@" + currentUser.Username }</span>
						</div>
					}
				</div>
				<div class="px-4 py-5 sm:p-8">
					if currentUser != nil {
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/socket/%d/reply", t.ID)) }
							class="space-y-4"
						>
							<textarea
								name="body"
								rows="4"
								required
								if lang == "id" {
									placeholder="Tuliskan jawaban atau analisis teknis Anda (Markdown)..."
								} else {
									placeholder="Write your answer or technical analysis (Markdown)..."
								}
								class="w-full p-3.5 text-xs font-mono bg-bg border border-muted/30 text-text placeholder-muted focus:border-[var(--c-link)] focus:outline-none"
							></textarea>
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 text-xs font-mono text-muted">
								<span>
									if lang == "id" {
										[SYS] Markdown & kode · <kbd class="px-1 py-0.5 border border-border bg-bg text-[10px]">Ctrl+Enter</kbd> kirim
									} else {
										[SYS] Markdown & code · <kbd class="px-1 py-0.5 border border-border bg-bg text-[10px]">Ctrl+Enter</kbd> submit
									}
								</span>
								<div class="flex justify-end w-full sm:w-auto">
									<button
										type="submit"
										class="px-5 py-2 bg-text text-bg font-bold font-mono hover:opacity-90 transition-opacity cursor-pointer text-xs uppercase tracking-wider"
									>
										if lang == "id" {
											KIRIM JAWABAN
										} else {
											SUBMIT ANSWER
										}
									</button>
								</div>
							</div>
						</form>
					} else {
						<div class="p-6 bg-bg border border-border text-center space-y-3 text-xs font-mono">
							<p class="text-muted">
								if lang == "id" {
									Masuk dengan GitHub untuk menulis balasan atau memberikan upvote.
								} else {
									Sign in with GitHub to write a reply or upvote.
								}
							</p>
							<a
								href={ templ.SafeURL("/auth/github?return_to=" + prefix(lang) + "/socket/" + t.Slug) }
								class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-text text-bg font-bold hover:opacity-90"
							>
								@IconGitHub()
								if lang == "id" {
									<span>Login dengan GitHub</span>
								} else {
									<span>Sign in with GitHub</span>
								}
							</a>
						</div>
					}
				</div>
			</div>
		</div>
	</section>
}
