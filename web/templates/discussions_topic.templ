package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsTopicPane(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	t *forum.Topic,
	replies []*forum.Reply,
) {
	<div class="flex flex-col min-h-full bg-surface">
		<div class="lg:hidden px-4 py-3 border-b border-border/40 bg-surface flex items-center justify-between sticky top-0 z-20 backdrop-blur-sm select-none shrink-0">
			<a
				href={ templ.SafeURL(prefix(lang) + "/socket") }
				class="inline-flex items-center gap-1.5 text-xs font-sans font-medium text-muted hover:text-text transition-colors"
			>
				@IconArrowLeft("w-3.5 h-3.5")
				<span>
					if lang == "id" {
						Kembali ke Socket
					} else {
						Back to Socket
					}
				</span>
			</a>
			if t.IsSolved {
				<span class="px-2 py-0.5 border border-emerald-500/60 bg-emerald-500/10 text-emerald-500 text-[10px] font-bold tracking-wider uppercase font-sans">
					SOLVED
				</span>
			}
		</div>
		<div class="px-4 sm:px-8 lg:px-10 py-6 sm:py-8 lg:py-10 space-y-6 sm:space-y-8 flex-1">
			<div class="space-y-3 sm:space-y-4 pb-6 border-b border-border/40">
				if t.IsSolved {
					<div class="hidden lg:inline-flex items-center gap-1 px-2 py-0.5 border border-emerald-500/60 bg-emerald-500/10 text-emerald-500 text-[10px] font-bold tracking-wider uppercase font-sans">
						@IconCheck("w-3 h-3")
						<span>SOLVED</span>
					</div>
				}
				<h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-text tracking-tight leading-snug">
					{ t.Title }
				</h1>
				<div class="flex items-center justify-between gap-3 text-xs font-sans text-muted">
					<div class="flex items-center gap-2.5 min-w-0">
						if t.AuthorAvatar != "" {
							<img src={ t.AuthorAvatar } alt={ t.AuthorUsername } class="w-6 h-6 sm:w-7 sm:h-7 rounded-none border border-border object-cover shrink-0"/>
						} else {
							<img src="/static/images/deleted-user.png" alt="Deleted User" class="w-6 h-6 sm:w-7 sm:h-7 rounded-none border border-border object-cover shrink-0"/>
						}
						<div class="flex items-center gap-1.5 truncate">
							if t.AuthorGitHub != "" {
								<a href={ templ.SafeURL(t.AuthorGitHub) } target="_blank" rel="noopener" class="font-bold text-text hover:underline">
									{ "@" + t.AuthorUsername }
								</a>
							} else if t.AuthorUsername != "" && t.AuthorUsername != "ghost" {
								<span class="font-bold text-text">{ "@" + t.AuthorUsername }</span>
							} else {
								<span class="font-bold text-text">{ t.AuthorName }</span>
							}
							<span class="text-muted/40">·</span>
							<time datetime={ t.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">{ timeAgoOrDate(t.CreatedAt, lang) }</time>
							<span class="text-muted/40">·</span>
							<span>{ fmt.Sprintf("%d views", t.ViewsCount) }</span>
						</div>
					</div>
					if currentUser != nil && (currentUser.ID == t.UserID || currentUser.Role == "admin") {
						<details class="relative comment-menu">
							<summary class="p-1.5 -m-1 text-muted hover:text-text focus:outline-none cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-center transition-colors" title="Options">
								@IconMoreVertical("w-4 h-4")
							</summary>
							<div class="absolute right-0 mt-2 w-36 bg-surface border border-border shadow-2xl z-20 font-sans text-xs overflow-hidden py-1">
								<form
									hx-post={ fmt.Sprintf("/socket/%d/delete", t.ID) }
									if lang == "id" {
										hx-confirm="Yakin ingin menghapus topik diskusi ini secara permanen?"
									} else {
										hx-confirm="Delete this discussion topic permanently?"
									}
									class="block"
								>
									<button
										type="submit"
										class="w-full text-left px-3 py-2 hover:bg-hover hover:text-rose-500 text-text cursor-pointer transition-colors flex items-center gap-2"
										onclick="this.closest('details').removeAttribute('open')"
									>
										@IconTrash("w-3.5 h-3.5 text-rose-500")
										<span>
											if lang == "id" {
												Hapus Topik
											} else {
												Delete Topic
											}
										</span>
									</button>
								</form>
							</div>
						</details>
					}
				</div>
			</div>
			<div class="prose max-w-none text-text text-sm sm:text-base leading-relaxed font-sans">
				@templ.Raw(string(t.BodyHTML))
			</div>
			<div class="flex items-center justify-between pt-4 border-t border-border/40 text-xs font-sans">
				<div class="flex items-center gap-3">
					@DiscussionsVoteButton("topic", t.ID, t.VotesCount, t.UserVoted)
				</div>
				<button
					type="button"
					onclick="var form = document.getElementById('reply-form'); if(form){ form.scrollIntoView({behavior:'smooth'}); var ta = form.querySelector('textarea'); if(ta){ ta.focus(); } }"
					class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-border bg-surface hover:bg-hover text-text cursor-pointer font-sans font-semibold text-xs transition-colors"
				>
					@IconComment("w-3.5 h-3.5")
					<span>
						if lang == "id" {
							Balas
						} else {
							Reply
						}
					</span>
				</button>
			</div>
			if t.IsSolved {
				for _, r := range replies {
					if r.IsSolution || (t.SolvedReplyID > 0 && r.ID == t.SolvedReplyID) {
						<div class="px-3.5 py-2 sm:px-4 sm:py-2.5 border border-border bg-bg text-xs font-sans flex items-center justify-between gap-3 select-none">
							<div class="flex items-center gap-2 min-w-0 truncate">
								@IconCheck("w-3.5 h-3.5 text-emerald-500 shrink-0")
								<span class="text-muted truncate">
									if lang == "id" {
										<span>Terpecahkan oleh</span>
									} else {
										<span>Solved by</span>
									}
									if r.AuthorUsername != "" && r.AuthorUsername != "ghost" {
										<strong class="text-text ml-1">{ "@" + r.AuthorUsername }</strong>
									} else {
										<strong class="text-text ml-1">{ r.AuthorName }</strong>
									}
								</span>
							</div>
							<a
								href={ templ.SafeURL(fmt.Sprintf("#reply-%d", r.ID)) }
								onclick="var el = document.getElementById(this.getAttribute('href').slice(1)); if(el){ el.scrollIntoView({behavior:'smooth'}); }"
								class="text-text hover:underline text-xs font-medium shrink-0 flex items-center gap-1"
							>
								if lang == "id" {
									<span>Lihat jawaban</span>
								} else {
									<span>Go to answer</span>
								}
								<span class="text-muted">↓</span>
							</a>
						</div>
					}
				}
			}
			<div class="pt-6 border-t border-border/50 space-y-4">
				<div class="flex items-center justify-between text-xs font-sans text-muted">
					<span class="font-bold text-text uppercase tracking-wider">
						if lang == "id" {
							{ fmt.Sprintf("Balasan (%d)", len(replies)) }
						} else {
							{ fmt.Sprintf("Replies (%d)", len(replies)) }
						}
					</span>
				</div>
				if len(replies) == 0 {
					<div class="py-8 text-center text-xs font-sans text-muted">
						if lang == "id" {
							Belum ada balasan. Jadilah yang pertama menjawab!
						} else {
							No replies yet. Be the first to answer!
						}
					</div>
				} else {
					<div class="divide-y divide-border/40">
						for _, r := range replies {
							@DiscussionsReplyItem(ui, lang, currentUser, r, t.ID, t.UserID)
						}
					</div>
				}
			</div>
			<div id="reply-form" class="pt-6 border-t border-border/50 space-y-3">
				<div class="flex items-center justify-between text-xs font-sans text-muted">
					<span class="font-bold text-text uppercase tracking-wider">
						if lang == "id" {
							Tulis Balasan
						} else {
							Write a Reply
						}
					</span>
					if currentUser != nil {
						<span class="text-muted/80">{ "@" + currentUser.Username }</span>
					}
				</div>
				if currentUser != nil {
					<form
						id="reply-form"
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/socket/%d/reply", t.ID)) }
						class="space-y-3"
					>
						<textarea
							name="body"
							rows="4"
							required
							if lang == "id" {
								placeholder="Tuliskan jawaban atau analisis teknis Anda (Markdown)..."
							} else {
								placeholder="Write your answer or technical analysis (Markdown)..."
							}
							class="w-full p-3.5 text-sm font-sans bg-surface border border-border text-text placeholder:text-muted/50 focus:border-text focus:outline-none leading-relaxed"
						></textarea>
						<div class="flex items-center justify-end pt-1">
							<button
								type="submit"
								class="px-5 py-2 bg-slate-600 hover:bg-slate-500 text-white font-bold font-sans transition-colors cursor-pointer text-xs uppercase tracking-wider"
							>
								Submit
							</button>
						</div>
					</form>
				} else {
					<div class="p-6 bg-bg border border-border/60 text-center space-y-3 text-xs font-sans">
						<p class="text-muted">
							if lang == "id" {
								Masuk dengan GitHub untuk menulis balasan atau memberikan upvote.
							} else {
								Sign in with GitHub to write a reply or upvote.
							}
						</p>
						<a
							href={ templ.SafeURL("/auth/github?return_to=" + prefix(lang) + "/socket/" + t.Slug) }
							class="inline-flex items-center gap-2 px-3.5 py-1.5 border border-border bg-surface hover:bg-hover text-text font-bold"
						>
							@IconGitHub()
							if lang == "id" {
								<span>Login dengan GitHub</span>
							} else {
								<span>Sign in with GitHub</span>
							}
						</a>
					</div>
				}
			</div>
		</div>
	</div>
}

templ DiscussionsEmptyPane(ui i18n.UI, lang string) {
	<div class="p-12 sm:p-16 text-center font-sans my-auto space-y-3 text-muted select-none">
		<div class="w-12 h-12 mx-auto border border-border flex items-center justify-center text-text font-mono text-lg mb-4">
			&gt;_
		</div>
		<p class="text-sm font-bold text-text uppercase tracking-wider">
			if lang == "id" {
				PILIH TOPIK DISKUSI
			} else {
				SELECT A TOPIC
			}
		</p>
		<p class="text-xs text-muted max-w-sm mx-auto leading-relaxed">
			if lang == "id" {
				Pilih salah satu topik diskusi di panel sebelah kiri untuk membaca pembahasan teknis, atau buat topik baru.
			} else {
				Select a discussion topic from the left panel to inspect technical details, or start a new topic.
			}
		</p>
		<div class="pt-3">
			<a
				href={ templ.SafeURL(prefix(lang) + "/socket/new") }
				class="inline-flex items-center gap-1.5 px-3.5 py-1.5 border border-border bg-surface hover:bg-hover text-text font-bold text-xs uppercase tracking-wider transition-colors"
			>
				<span>+</span>
				<span>{ ui.Discussions_New }</span>
			</a>
		</div>
	</div>
}
