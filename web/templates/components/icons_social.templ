templ IconX(classes ...string) {
	{{
		cls := "w-3.5 h-3.5"
		if len(classes) > 0 {
			cls = classes[0]
		}
	}}
	<svg class={ cls } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
}

