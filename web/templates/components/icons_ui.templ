templ IconReactionThumbsUp(active bool) {
	<svg class={ "w-3.5 h-3.5 shrink-0 transition-colors", templ.KV("text-text fill-current", active), templ.KV("text-muted group-hover:text-text", !active) } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
}

