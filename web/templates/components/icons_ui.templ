package components

templ IconArrowUp(class ...string) {
	{{
		cls := "w-3.5 h-3.5"
		if len(class) > 0 {
			cls = class[0]
		}
	}}
	<svg class={ cls } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
}

templ IconArrowDown(class string) {
	<svg class={ class } xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
	</svg>
}

