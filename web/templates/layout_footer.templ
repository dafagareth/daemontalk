package templates

import (
	"strings"

	"daemontalk/internal/i18n"
)

templ footer(ui i18n.UI, lang string) {
	<footer class="w-full border-t border-border mt-8 sm:mt-12 bg-[var(--c-footer)] transition-all">
		<div class="container-page py-12 sm:py-16 min-w-0">
			<!-- Brand and Social Row -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-border/60 pb-8 mb-10">
				<div>
					<a href={ templ.SafeURL(prefix(lang) + "/") } class="flex items-center shrink-0 mb-3 hover:opacity-85 transition-opacity" aria-label="daemontalk">
						@BrandLogo("h-6 w-auto")
					</a>
					<p class="text-[13px] text-muted leading-relaxed max-w-[400px]">
						{ ui.Footer_Bio }
					</p>
				</div>
				<!-- Social icons -->
				<div class="flex items-center gap-1.5">
					@footerSocial("https://github.com/dafagareth", "GitHub") {
						@IconGitHub()
					}
					@footerSocial("https://x.com/daemontalk", "X / Twitter") {
						@IconX()
					}
					@footerSocial("https://facebook.com/daemontalk", "Facebook") {
						@IconFacebook()
					}
					@footerSocial("https://instagram.com/daemontalk", "Instagram") {
						@IconInstagram()
					}
					@footerSocial("https://threads.net/@daemontalk", "Threads") {
						@IconThreads()
					}
					@footerSocial("mailto:realdaemontalk@gmail.com", "Email") {
						@IconEmail()
					}
					@footerSocial("/rss.xml", "RSS") {
						@IconRSS()
					}
				</div>
			</div>

			<!-- 5-Column Grid -->
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-8 gap-y-10 mb-12">
				<!-- Col 1: Read / Navigasi -->
				<div>
					<p class="text-xs font-semibold text-text uppercase tracking-wider mb-4">{ ui.Footer_Read }</p>
					<ul class="space-y-2.5">
						@footerLink(prefix(lang)+"/", ui.Nav_Home)
						@footerLink(prefix(lang)+"/about", "About Daemontalk")
						@footerLink(prefix(lang)+"/behind", "Behind The Lab")
						@footerLink(prefix(lang)+"/terminal", "Terminal Shell")
						@footerLink(prefix(lang)+"/til", "TIL")
						@footerLink(prefix(lang)+"/saved", "Reading List")
						@footerLink(prefix(lang)+"/search", "Search")
						@footerLink(prefix(lang)+"/stats", "Stats")
						<li>
							<button
								type="button"
								onclick="openShortcuts()"
								class="text-xs text-muted hover:text-link transition-colors inline-flex items-center gap-1.5 cursor-pointer font-mono"
							>
								@IconShortcuts()
								<span>Shortcuts</span>
								<kbd class="px-1 py-0.5 rounded-none border border-border bg-surface text-[10px] font-mono leading-none">?</kbd>
							</button>
						</li>
					</ul>
				</div>

				<!-- Col 2: Topics / Kategori -->
				<div>
					<p class="text-xs font-semibold text-text uppercase tracking-wider mb-4">{ ui.Footer_Topics }</p>
					<ul class="space-y-2.5">
						@footerLink(prefix(lang)+"/?tag=linux", "Linux")
						@footerLink(prefix(lang)+"/?tag=go", "Go")
						@footerLink(prefix(lang)+"/?tag=python", "Python")
						@footerLink(prefix(lang)+"/?tag=backend", "Backend")
						@footerLink(prefix(lang)+"/?tag=architecture", "Architecture")
						@footerLink(prefix(lang)+"/?tag=devops", "DevOps")
					</ul>
				</div>

				<!-- Col 3: Open Source -->
				<div>
					<p class="text-xs font-semibold text-text uppercase tracking-wider mb-4">{ ui.Footer_Community }</p>
					<ul class="space-y-2.5">
						@footerLink("https://github.com/dafagareth/daemontalk", "GitHub Repo")
						@footerLink("https://github.com/dafagareth/daemontalk/issues", "Report Issue")
						@footerLink(prefix(lang)+"/contribute", "Writing Guide")
						@footerLink("/download/template.md", "Template (.md)")
						@footerLink(prefix(lang)+"/guestbook", "Guestbook")
					</ul>
				</div>

				<!-- Col 4: Feeds & Legal -->
				<div>
					<p class="text-xs font-semibold text-text uppercase tracking-wider mb-4">{ ui.Footer_Ecosystem }</p>
					<ul class="space-y-2.5">
						@footerLink("/rss.xml", "RSS Feed")
						@footerLink("/feed.json", "JSON Feed")
						@footerLink(prefix(lang)+"/changelog", "Changelog")
						@footerLink(prefix(lang)+"/resume", "Resume / CV")
						@footerLink(prefix(lang)+"/license", "License")
						@footerLink(prefix(lang)+"/terms", ui.Terms_Title)
						@footerLink(prefix(lang)+"/privacy", ui.Privacy_Title)
					</ul>
				</div>

				<!-- Col 5: Other & Tools -->
				<div>
					<p class="text-xs font-semibold text-text uppercase tracking-wider mb-4">{ ui.Footer_Other }</p>
					<ul class="space-y-2.5">
						@footerLink("/daily", "Daily Feed (CLI)")
						@footerLink("/recipes", "CLI Recipes")
						@footerLink(prefix(lang)+"/links", "Curated Links")
						@footerLink("/sitemap.xml", "Sitemap XML")
						@footerLink("/robots.txt", "Robots.txt")
						@footerLink("/manifest.json", "Manifest JSON")
					</ul>
				</div>
			</div>

			<!-- Bottom bar -->
			<div class="border-t border-border/40 pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<p class="text-xs text-muted">{ ui.Footer_Copy } · Built with Go, templ &amp; HTMX.</p>
			</div>
		</div>
	</footer>
}

templ footerSocial(href string, label string) {
	<a
		href={ templ.SafeURL(href) }
		aria-label={ label }
		target="_blank"
		rel="noopener"
		class="w-9 h-9 flex items-center justify-center rounded-none text-muted hover:text-text hover:bg-hover transition-colors"
	>
		{ children... }
	</a>
}

templ footerLink(href string, label string) {
	<li>
		if strings.HasPrefix(href, "http://") || strings.HasPrefix(href, "https://") {
			<a
				href={ templ.SafeURL(href) }
				target="_blank"
				rel="noopener noreferrer"
				class="text-[13px] text-muted hover:text-text transition-colors"
			>{ label }</a>
		} else {
			<a
				href={ templ.SafeURL(href) }
				class="text-[13px] text-muted hover:text-text transition-colors"
			>{ label }</a>
		}
	</li>
}
