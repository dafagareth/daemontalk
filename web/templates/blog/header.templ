package blog

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
	"strings"
)

templ blogHeader(ui i18n.UI, p post.Post, lang string, seriesParts []post.Post) {
	<header class="mb-8 w-full max-w-[42rem] mx-auto">
		if len(p.Tags) > 0 || len(seriesParts) > 1 {
			<div class="flex items-center gap-2 flex-wrap mb-4 text-xs font-mono select-none">
				if len(seriesParts) > 1 {
					<span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-sans font-bold uppercase tracking-wider bg-surface border border-border text-text mr-1">
						@components.IconSeries("w-3 h-3 text-link shrink-0")
						<span>Series: { p.Series }</span>
					</span>
				}
				for _, t := range p.Tags {
					<a
						href={ templ.SafeURL(shared.Prefix(lang) + "/blog/tag/" + t) }
						class="border border-border/70 text-text hover:text-link font-mono text-xs px-2 py-0.5 transition-colors"
					>
						{ t }
					</a>
				}
			</div>
		}
		<div class="mb-6">
			<h1 class="font-sans font-bold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-text leading-[1.2] mb-3">
				{ p.Title }
			</h1>
			if p.Description != "" {
				<p class="text-base sm:text-lg text-muted font-sans leading-relaxed">
					{ p.Description }
				</p>
			}
		</div>
		<div class="pt-4 border-t border-muted/30 flex items-start gap-3 sm:gap-3.5 text-xs font-mono select-none">
			if p.AuthorAvatar != "" {
				<img
					src={ p.AuthorAvatar }
					alt={ p.Author }
					class="w-9 h-9 sm:w-10 sm:h-10 rounded-none border border-muted/30 object-cover shrink-0 mt-0.5"
					loading="lazy"
				/>
			}
			<div class="min-w-0 flex-1 space-y-1">
				<div class="flex items-center gap-2 flex-wrap">
					if p.AuthorGitHub != "" {
						<a
							href={ templ.SafeURL("https://github.com/" + p.AuthorGitHub) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-text hover:text-link transition-colors font-bold text-sm sm:text-base"
						>
							if p.Author != "" {
								{ p.Author }
							} else {
								{ "@" + p.AuthorGitHub }
							}
						</a>
					} else if p.Author != "" {
						<span class="text-text font-bold text-sm sm:text-base">{ p.Author }</span>
					} else {
						<span class="text-text font-bold text-sm sm:text-base">daemontalk</span>
					}
				</div>
				if len(p.Contributors) > 0 {
					<div class="flex items-center gap-1.5 text-muted text-xs flex-wrap">
						<span class="text-muted/70 text-[11px] uppercase font-semibold">contrib:</span>
						for i, c := range p.Contributors {
							{{ cleanHandle := strings.TrimPrefix(c, "@") }}
							<a
								href={ templ.SafeURL("https://github.com/" + cleanHandle) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-text hover:text-link font-medium transition-colors"
							>
								{ "@" + cleanHandle }
							</a>
							if i < len(p.Contributors)-1 {
								<span class="text-muted/40">,</span>
							}
						}
					</div>
				}
				<div class="flex items-center gap-2 text-xs text-muted flex-wrap">
					<time datetime={ p.Date.Format("2006-01-02") } class="text-muted">{ shared.FmtDate(p, lang) }</time>
					<span class="text-muted/40">·</span>
					<span class="text-muted">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
		@blogPostTopBar(ui, p, lang)
	</header>
	if p.Cover != "" {
		<figure class="cover-image-breakout mb-8 sm:mb-10 -mx-4 sm:mx-auto">
			<img
				src={ p.Cover }
				alt={ p.Title }
				loading="lazy"
				class="w-full h-auto block"
			/>
			if p.CoverCaption != "" {
				<figcaption class="text-xs font-sans text-muted mt-2.5 px-4 sm:px-0 flex items-center justify-between gap-4">
					<span>{ p.CoverCaption }</span>
					if p.CoverSource != "" {
						<a href={ templ.SafeURL(p.CoverSource) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-muted hover:text-text underline decoration-muted/40 hover:decoration-text transition-colors shrink-0">
							<span>{ shared.CoverSourceName(p.CoverSource) }</span>
							@components.IconArrowUpRight("w-3 h-3 text-muted/70")
						</a>
					}
				</figcaption>
			}
		</figure>
	}
}
