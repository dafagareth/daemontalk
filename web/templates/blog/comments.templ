package blog

import (
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
	"time"

	"daemontalk/internal/auth"
	"daemontalk/internal/comment"
	"daemontalk/internal/i18n"
)

func fmtCommentTime(t time.Time, lang string) string {
	return shared.TimeAgoOrDate(t.Local(), lang)
}

func reverseRoots(roots []comment.Comment) []comment.Comment {
	n := len(roots)
	out := make([]comment.Comment, n)
	for i, r := range roots {
		out[n-1-i] = r
	}
	return out
}

templ commentsSection(ui i18n.UI, slug string, lang string, comments []comment.Comment, isAdmin bool, visitorName string, authUser *auth.User) {
	<section id="comments-section" class="mt-12 pt-4">
		<div id="comment-form-container" class="mb-8 pb-2 scroll-mt-24">
			<div id="reply-indicator" class="hidden items-center justify-between bg-surface/60 px-3 py-1.5 border border-border text-xs font-sans mb-2.5">
				<span class="text-muted">
					{ ui.Comments_ReplyingTo } <strong id="reply-author-name" class="text-text font-bold"></strong>
				</span>
				<button
					type="button"
					data-reply-cancel-btn
					class="text-muted hover:text-text cursor-pointer ml-1 font-bold p-1 touch-manipulation text-xs"
					title={ ui.Comments_Cancel }
				>
					✕ { ui.Comments_Cancel }
				</button>
			</div>
			<form
				id="main-comment-form"
				class="flex flex-col gap-2.5"
				hx-post={ shared.Prefix(lang) + "/blog/" + slug + "/comments" }
				hx-target="#comment-list"
				hx-swap="outerHTML"
				hx-disabled-elt="find button[type='submit']"
				hx-on::before-request="window._lastSubmittedParentId = document.getElementById('comment-parent-id') ? document.getElementById('comment-parent-id').value : '';"
				hx-on::after-request="if(event.detail.successful){ this.reset(); var ta = this.querySelector('textarea'); if(ta) ta.value = ''; if(window.cancelCommentReply) window.cancelCommentReply(); if(window.onCommentPosted) window.onCommentPosted(window._lastSubmittedParentId); }"
			>
				<input id="comment-parent-id" type="hidden" name="parent_id" value=""/>
				<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true"/>
				<textarea
					id="comment-textarea"
					name="body"
					required
					maxlength="2000"
					rows="3"
					placeholder={ ui.Comments_BodyLabel }
					class="form-textarea"
				></textarea>
				<div class="flex flex-wrap items-center justify-between gap-3 text-xs font-sans">
					<div class="flex items-center gap-2 text-[11px] text-muted">
						<span>
							if authUser != nil {
								By: <strong class="font-medium text-text">{ authUser.Username }</strong>
							} else {
								By: <strong class="font-medium text-text">anonym</strong>
							}
						</span>
						if authUser != nil {
							<span class="text-muted/40">·</span>
							<label class="flex items-center gap-1.5 cursor-pointer hover:text-text select-none">
								<input type="checkbox" name="is_anonymous" value="true" class="checkbox checkbox-xs"/>
								<span>
									Anonymous
								</span>
							</label>
						}
						<span class="text-muted/40">·</span>
						<span class="text-muted/60">
							<kbd class="kbd kbd-xs">Ctrl+Enter</kbd>
						</span>
					</div>
					<div class="flex items-center gap-2">
						<button
							type="button"
							id="reply-cancel-btn"
							data-reply-cancel-btn
							class="btn btn-ghost btn-xs hidden"
						>
							{ ui.Comments_Cancel }
						</button>
						<button
							type="submit"
							class="btn btn-primary btn-sm"
						>
							<span class="htmx-indicator spinner"></span>
							{ ui.Comments_Submit }
						</button>
					</div>
				</div>
			</form>
		</div>
		@commentList(ui, comments, isAdmin, slug, lang, visitorName, authUser)
	</section>
}

templ CommentList(ui i18n.UI, comments []comment.Comment, isAdmin bool, slug string, lang string, visitorName string, authUser *auth.User) {
	@commentList(ui, comments, isAdmin, slug, lang, visitorName, authUser)
}

templ commentList(ui i18n.UI, comments []comment.Comment, isAdmin bool, slug string, lang string, visitorName string, authUser *auth.User) {
	<div id="comment-list" data-slug={ slug }>
		<h2 class="text-sm font-bold font-sans text-text mb-4">
			{ ui.Comments_Heading }
			<span class="text-muted font-normal text-xs">({ fmt.Sprintf("%d", len(comments)) })</span>
		</h2>
		if len(comments) == 0 {
			<p class="text-xs text-muted font-sans">{ ui.Comments_Empty }</p>
		} else {
			{{ roots := reverseRoots(comment.BuildTree(comments)) }}
			<div id="comment-items-container" class="flex flex-col gap-5">
				for i, root := range roots {
					<div
						class={ "comment-root-item", templ.KV("hidden", i >= 3) }
						data-comment-index={ fmt.Sprintf("%d", i) }
					>
						@commentTreeItem(ui, root, isAdmin, slug, lang, visitorName, authUser, 0)
					</div>
				}
			</div>
			if len(roots) > 3 {
				<div id="comment-load-more-container" class="mt-5 pt-1">
					<button
						type="button"
						id="comment-load-more-btn"
						onclick="if(window.handleLoadMoreComments) window.handleLoadMoreComments()"
						class="w-full py-2.5 px-4 text-xs font-sans font-semibold border border-border bg-surface text-text hover:bg-hover transition-colors cursor-pointer flex items-center justify-center gap-2 touch-manipulation select-none"
					>
						<span>{ ui.Comments_LoadMore }</span>
						<span id="comment-remaining-count" class="text-muted font-normal">
							({ fmt.Sprintf("%d", len(roots)-3) })
						</span>
					</button>
				</div>
			}
		}
	</div>
}

templ commentTreeItem(ui i18n.UI, c comment.Comment, isAdmin bool, slug string, lang string, visitorName string, authUser *auth.User, depth int) {
	<div id={ fmt.Sprintf("comment-%d", c.ID) } class="py-2">
		<div class="flex justify-between items-center w-full mb-1.5 font-sans text-xs">
			<div class="flex items-center gap-2">
				if c.AvatarURL != "" {
					<img src={ c.AvatarURL } alt={ c.Name } class="w-5 h-5 rounded-none border border-border object-cover"/>
				} else {
					<div class="w-5 h-5 rounded-none border border-border bg-muted/20 flex items-center justify-center text-[10px] font-bold text-muted">?</div>
				}
				if c.GitHubURL != "" {
					<a href={ templ.SafeURL(c.GitHubURL) } target="_blank" rel="noopener" class="text-sm font-semibold text-text hover:text-link hover:underline">
						{ c.Name }
					</a>
				} else {
					<span class="text-sm font-semibold text-text">
						{ c.Name }
					</span>
				}
				<time datetime={ c.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time text-[11px] text-muted font-sans">{ fmtCommentTime(c.CreatedAt, lang) }</time>
			</div>
			{{ isOwner := (authUser != nil && c.UserID != nil && *c.UserID == authUser.ID) || (visitorName != "" && c.Name == visitorName) }}
			if isOwner || isAdmin {
				<details class="relative comment-menu">
					<summary class="p-2.5 -m-2 text-muted hover:text-text focus:outline-none cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-center transition-colors">
						@components.IconMoreVertical("w-4 h-4")
					</summary>
					<div class="absolute right-0 mt-2 w-36 bg-surface border border-border shadow-2xl z-20 font-sans text-xs overflow-hidden py-1">
						if isOwner && time.Since(c.CreatedAt) < 10*time.Minute {
							<button
								class="w-full text-left px-4 py-2 hover:bg-hover hover:text-text transition-colors cursor-pointer text-text border-b border-border/40"
								hx-get={ shared.Prefix(lang) + "/blog/" + slug + "/comments/" + fmt.Sprintf("%d", c.ID) + "/edit" }
								hx-target={ fmt.Sprintf("#comment-body-%d", c.ID) }
								hx-swap="innerHTML"
								onclick="this.closest('details').removeAttribute('open')"
							>
								Edit
							</button>
						}
						<button
							class="w-full text-left px-4 py-2 hover:bg-hover hover:text-[var(--c-warn)] transition-colors cursor-pointer text-text"
							hx-post={ shared.Prefix(lang) + "/blog/" + slug + "/comments/" + fmt.Sprintf("%d", c.ID) + "/delete" }
							hx-target="#comment-list"
							hx-swap="outerHTML"
							hx-confirm="Hapus komentar ini beserta balasannya?"
							onclick="this.closest('details').removeAttribute('open')"
						>
							Delete
						</button>
						if !isOwner && isAdmin {
							<button
								class="w-full text-left px-4 py-2 hover:bg-hover hover:text-[var(--c-warn)] transition-colors cursor-pointer text-text border-t border-border/40"
								hx-post={ shared.Prefix(lang) + "/blog/" + slug + "/comments/" + fmt.Sprintf("%d", c.ID) + "/report" }
								hx-swap="outerHTML"
								onclick="this.closest('details').removeAttribute('open')"
							>
								Report
							</button>
						}
					</div>
				</details>
			} else {
				<details class="relative comment-menu">
					<summary class="p-2.5 -m-2 text-muted hover:text-text focus:outline-none cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-center transition-colors">
						@components.IconMoreVertical("w-4 h-4")
					</summary>
					<div class="absolute right-0 mt-2 w-36 bg-surface border border-border shadow-2xl z-20 font-sans text-xs overflow-hidden py-1">
						<button
							class="w-full text-left px-4 py-2 hover:bg-hover hover:text-[var(--c-warn)] transition-colors cursor-pointer text-text"
							hx-post={ shared.Prefix(lang) + "/blog/" + slug + "/comments/" + fmt.Sprintf("%d", c.ID) + "/report" }
							hx-swap="outerHTML"
							onclick="this.closest('details').removeAttribute('open')"
						>
							Report
						</button>
					</div>
				</details>
			}
		</div>
		<div id={ fmt.Sprintf("comment-body-%d", c.ID) } class="text-sm text-text break-words leading-relaxed mb-2 font-sans">
			@templ.Raw(string(renderCommentBody(c.Body)))
		</div>
		<div class="flex items-center gap-4 text-xs font-sans">
			<button
				type="button"
				data-reply-btn
				data-reply-id={ fmt.Sprintf("%d", c.ID) }
				data-reply-author={ c.Name }
				class="text-muted hover:text-text cursor-pointer transition-colors inline-flex items-center gap-1.5 py-1 px-1.5 -ml-1.5 touch-manipulation select-none font-medium"
			>
				@components.IconReply("w-3.5 h-3.5 shrink-0")
				<span>{ ui.Comments_Reply }</span>
			</button>
		</div>
		if len(c.Replies) > 1 {
			<details class="comment-replies-group group mt-2.5 text-xs font-sans">
				<summary class="cursor-pointer font-medium text-muted hover:text-text list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-1.5 py-1 px-1.5 -ml-1.5 select-none transition-colors">
					<span class="inline-block transition-transform duration-200 group-open:rotate-90 text-[9px]">▶</span>
					<span class="group-open:hidden">{ fmt.Sprintf(ui.Comments_ShowReplies, len(c.Replies)) }</span>
					<span class="hidden group-open:inline">{ ui.Comments_HideReplies }</span>
				</summary>
				<div class="border-l-2 border-border/80 dark:border-border/90 transition-colors pl-3.5 sm:pl-5 mt-2 space-y-3.5">
					for _, reply := range c.Replies {
						@commentTreeItem(ui, reply, isAdmin, slug, lang, visitorName, authUser, depth+1)
					}
				</div>
			</details>
		} else if len(c.Replies) == 1 {
			<div class="border-l-2 border-border/80 dark:border-border/90 transition-colors pl-3.5 sm:pl-5 mt-2.5 space-y-3.5">
				for _, reply := range c.Replies {
					@commentTreeItem(ui, reply, isAdmin, slug, lang, visitorName, authUser, depth+1)
				}
			</div>
		}
	</div>
}
