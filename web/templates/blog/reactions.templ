package blog

import (
	"daemontalk/internal/i18n"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
)

templ ReactionsBar(ui i18n.UI, reactions map[string]int, slug string, lang string, userReaction string, commentCount int, title string, date string) {
	{{
		active := userReaction == "like"
		count := reactions["like"]
	}}
	<div id="reactions-bar" class="w-full mt-10 mb-8 not-prose font-sans select-none">
		<div class="py-2 flex items-center justify-between gap-3 text-xs">
			<button
				type="button"
				hx-post={ shared.Prefix(lang) + "/blog/" + slug + "/reactions/like" }
				hx-target="#reactions-bar"
				hx-swap="outerHTML"
				class={
					"inline-flex items-center gap-2 px-3 py-1.5 rounded-none border border-border transition-colors cursor-pointer group text-xs font-sans select-none",
					templ.KV("bg-hover text-text font-bold", active),
					templ.KV("bg-surface hover:bg-hover text-text", !active),
				}
				title="Like this article"
				aria-label="Like"
			>
				@components.IconReactionThumbsUp(active)
				<span>
					Like
				</span>
				if count > 0 {
					<span class="text-muted/40 font-normal">·</span>
					<span class="font-bold font-sans text-text tabular-nums">
						{ fmt.Sprintf("%d", count) }
					</span>
				}
			</button>
			<div class="flex items-center gap-1.5 sm:gap-2">
				<button
					type="button"
					onclick="toggleBookmark(this)"
					data-slug={ slug }
					data-title={ title }
					data-date={ date }
					class="bookmark-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none border border-border bg-surface hover:bg-hover text-text transition-colors font-sans font-medium text-xs cursor-pointer select-none"
					title="Save post"
					aria-label="Save post"
				>
					@components.IconBookmark("bookmark-icon w-3.5 h-3.5 shrink-0")
					<span class="bookmark-text">
						Save
					</span>
				</button>
				<div class="relative">
					<button
						type="button"
						onclick="toggleSharePopover(event, 'footer-share-popover-menu')"
						class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none border border-border bg-surface hover:bg-hover text-text transition-colors font-sans font-medium text-xs cursor-pointer select-none"
						title="Share article"
						aria-label="Share article"
					>
						@components.IconShare("w-3.5 h-3.5 shrink-0")
						<span>
							Share
						</span>
					</button>
					<div
						id="footer-share-popover-menu"
						class="hidden absolute right-0 bottom-full mb-2.5 bg-surface border border-border shadow-2xl z-40 font-sans text-xs rounded-none select-none whitespace-nowrap"
					>
						<div class="flex items-stretch h-10">
							<button
								type="button"
								onclick="copyPostUrl(this, event)"
								class="px-4 text-muted hover:text-text hover:bg-hover flex items-center gap-2 cursor-pointer rounded-none transition-colors group font-bold text-xs"
								title="Copy link to clipboard"
							>
								@components.IconLink("w-4 h-4 text-muted group-hover:text-text shrink-0")
								<span class="share-label-text">
									Copy
								</span>
								<span class="share-copied-status hidden text-text font-bold">
									Copied
								</span>
							</button>
							<div class="w-px bg-border"></div>
							<button type="button" onclick="shareToTwitter(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on X" aria-label="Share on X">
								@components.IconX("w-4 h-4 shrink-0")
							</button>
							<button type="button" onclick="shareToBluesky(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on Bluesky" aria-label="Share on Bluesky">
								@components.IconBluesky("w-4 h-4 shrink-0")
							</button>
							<button type="button" onclick="shareToLinkedIn(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on LinkedIn" aria-label="Share on LinkedIn">
								@components.IconLinkedIn("w-4 h-4 shrink-0")
							</button>
							<button type="button" onclick="shareToThreads(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on Threads" aria-label="Share on Threads">
								@components.IconThreads("w-4 h-4 shrink-0")
							</button>
						</div>
					</div>
				</div>
				<div class="relative">
					<button
						type="button"
						onclick="toggleMorePopover(event, 'footer-more-popover-menu')"
						class="inline-flex items-center justify-center px-2 py-1.5 rounded-none border border-border bg-surface hover:bg-hover text-text transition-colors cursor-pointer select-none"
						title="More options"
						aria-label="More options"
					>
						@components.IconMoreHorizontal("w-3.5 h-3.5 shrink-0")
					</button>
					<div
						id="footer-more-popover-menu"
						class="hidden absolute right-0 bottom-full mb-2.5 bg-surface border border-border shadow-2xl z-40 min-w-[220px] font-sans text-xs rounded-none select-none whitespace-nowrap"
					>
						<button
							type="button"
							onclick="copyBibtex(this)"
							data-bibtex={ shared.BibtexFromMeta(slug, title, date) }
							class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
						>
							<span class="flex items-center gap-2.5">
								<span class="font-serif font-bold text-base leading-none text-text">”</span>
								<span>
									Copy BibTeX
								</span>
							</span>
							<span class="bibtex-copied-status hidden text-accent font-bold text-[11px]">
								Copied
							</span>
						</button>
						<div class="h-px bg-border"></div>
						<a
							href={ templ.SafeURL("https://github.com/dafagareth/daemontalk/edit/main/content/posts/" + slug + ".md") }
							target="_blank"
							rel="noopener noreferrer"
							class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
						>
							<span class="flex items-center gap-2.5">
								@components.IconEditSuggest("w-4 h-4 text-muted group-hover:text-text shrink-0")
								<span>
									Edit on GitHub
								</span>
							</span>
							@components.IconArrowUpRight("w-3 h-3 text-muted/60")
						</a>
						<a
							href={ templ.SafeURL(shared.Prefix(lang) + "/contribute") }
							class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
						>
							<span class="flex items-center gap-2.5">
								@components.IconContribute("w-4 h-4 text-muted group-hover:text-text shrink-0")
								<span>
									Contribute
								</span>
							</span>
							@components.IconArrowUpRight("w-3 h-3 text-muted/60")
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}
