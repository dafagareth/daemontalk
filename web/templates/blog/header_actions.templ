package blog

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
)

templ blogPostTopBar(ui i18n.UI, p post.Post, lang string) {
	<div id="article-action-bar" class="mt-4 pt-3.5 border-border flex items-center justify-between gap-3 text-xs not-prose font-sans select-none">
		<div class="relative">
			<button
				type="button"
				onclick="toggleReadingPopover(event)"
				class="btn btn-secondary btn-sm"
				title="Display Settings"
				aria-label="Display Settings"
			>
				<span class="font-serif font-bold text-xs leading-none">Aa</span>
				<span>Display</span>
			</button>
			<div
				id="reading-popover-menu"
				class="hidden absolute left-0 top-full mt-2 w-64 sm:w-72 bg-surface border border-border shadow-2xl z-40 p-3.5 font-sans text-xs rounded-none select-none"
			>
				<div class="space-y-3">
					<div class="flex items-center justify-between pb-2 border-b border-border/60 text-xs">
						<span class="text-text font-bold">
							{ ui.Post_TextSize }
						</span>
						<button
							type="button"
							onclick="toggleReadingPopover(event)"
							class="text-muted hover:text-text px-1 cursor-pointer transition-colors"
							aria-label="Close"
						>
							✕
						</button>
					</div>
					<div class="space-y-3 pt-1">
						<div class="flex items-center gap-3">
							<button
								type="button"
								onclick="setTextSizeIndex(0)"
								class="font-serif font-bold text-xs text-text/80 hover:text-text cursor-pointer select-none leading-none shrink-0"
								title={ ui.Post_TextSize_Small }
							>
								a
							</button>
							<div class="relative flex-1 flex items-center py-2">
								<div class="absolute inset-x-0 flex justify-between items-center pointer-events-none z-0 px-1">
									<span class="w-1.5 h-1.5 rounded-full bg-border"></span>
									<span class="w-1.5 h-1.5 rounded-full bg-border"></span>
									<span class="w-1.5 h-1.5 rounded-full bg-border"></span>
								</div>
								<input
									type="range"
									min="0"
									max="2"
									value="1"
									step="1"
									class="text-size-slider w-full cursor-pointer relative z-10"
									aria-label={ ui.Post_TextSize }
									oninput="setTextSizeIndex(this.value)"
								/>
							</div>
							<button
								type="button"
								onclick="setTextSizeIndex(2)"
								class="font-serif font-bold text-base text-text/80 hover:text-text cursor-pointer select-none leading-none shrink-0"
								title={ ui.Post_TextSize_Large }
							>
								A
							</button>
						</div>
						<div class="flex justify-between items-center text-[11px] font-sans select-none px-0.5 text-muted">
							<button
								type="button"
								onclick="setTextSizeIndex(0)"
								data-size-step="0"
								class="cursor-pointer hover:text-text transition-colors text-muted text-left"
							>
								{ ui.Post_TextSize_Small }
							</button>
							<button
								type="button"
								onclick="setTextSizeIndex(1)"
								data-size-step="1"
								class="cursor-pointer hover:text-text transition-colors text-text font-bold text-center"
							>
								{ ui.Post_TextSize_Medium }
							</button>
							<button
								type="button"
								onclick="setTextSizeIndex(2)"
								data-size-step="2"
								class="cursor-pointer hover:text-text transition-colors text-muted text-right"
							>
								{ ui.Post_TextSize_Large }
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="flex items-center gap-1.5 sm:gap-2">
			<button
				type="button"
				onclick="toggleBookmark(this)"
				data-slug={ p.Slug }
				data-title={ p.Title }
				data-date={ p.Date.Format("2006-01-02") }
				class="bookmark-btn btn btn-secondary btn-sm"
				title="Save post"
				aria-label="Save post"
			>
				@components.IconBookmark("bookmark-icon w-3.5 h-3.5 shrink-0")
				<span class="bookmark-text">
					Save
				</span>
			</button>
			<div class="relative">
				<button
					type="button"
					onclick="toggleSharePopover(event, 'header-share-popover-menu')"
					class="btn btn-secondary btn-sm"
					title="Share article"
					aria-label="Share article"
				>
					@components.IconShare("w-3.5 h-3.5 shrink-0")
					<span>
						Share
					</span>
				</button>
				<div
					id="header-share-popover-menu"
					class="hidden absolute right-0 top-full mt-2.5 bg-surface border border-border shadow-2xl z-40 font-sans text-xs rounded-none select-none whitespace-nowrap"
				>
					<div class="flex items-stretch h-10">
						<button
							type="button"
							onclick="copyPostUrl(this, event)"
							class="px-4 text-muted hover:text-text hover:bg-hover flex items-center gap-2 cursor-pointer rounded-none transition-colors group font-bold text-xs"
							title="Copy link to clipboard"
						>
							@components.IconLink("w-4 h-4 text-muted group-hover:text-text shrink-0")
							<span class="share-label-text">
								Copy
							</span>
							<span class="share-copied-status hidden text-text font-bold">
								Copied
							</span>
						</button>
						<div class="w-px bg-border"></div>
						<button type="button" onclick="shareToTwitter(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on X" aria-label="Share on X">
							@components.IconX("w-4 h-4 shrink-0")
						</button>
						<button type="button" onclick="shareToBluesky(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on Bluesky" aria-label="Share on Bluesky">
							@components.IconBluesky("w-4 h-4 shrink-0")
						</button>
						<button type="button" onclick="shareToLinkedIn(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on LinkedIn" aria-label="Share on LinkedIn">
							@components.IconLinkedIn("w-4 h-4 shrink-0")
						</button>
						<button type="button" onclick="shareToThreads(event)" class="w-10 text-muted hover:text-text hover:bg-hover cursor-pointer rounded-none transition-colors flex items-center justify-center" title="Share on Threads" aria-label="Share on Threads">
							@components.IconThreads("w-4 h-4 shrink-0")
						</button>
					</div>
				</div>
			</div>
			<div class="relative">
				<button
					type="button"
					onclick="toggleMorePopover(event, 'header-more-popover-menu')"
					class="btn btn-secondary btn-sm px-2"
					title="More options"
					aria-label="More options"
				>
					@components.IconMoreHorizontal("w-3.5 h-3.5 shrink-0")
				</button>
				<div
					id="header-more-popover-menu"
					class="hidden absolute right-0 top-full mt-2.5 bg-surface border border-border shadow-2xl z-40 min-w-[220px] font-sans text-xs rounded-none select-none whitespace-nowrap"
				>
					<button
						type="button"
						onclick="copyBibtex(this)"
						data-bibtex={ shared.BibtexFromMeta(p.Slug, p.Title, p.Date.Format("2006-01-02")) }
						class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
					>
						<span class="flex items-center gap-2.5">
							<span class="font-serif font-bold text-base leading-none text-text">”</span>
							<span>
								Copy BibTeX
							</span>
						</span>
						<span class="bibtex-copied-status hidden text-accent font-bold text-[11px]">
							Copied
						</span>
					</button>
					<div class="h-px bg-border"></div>
					<a
						href={ templ.SafeURL("https://github.com/dafagareth/daemontalk/edit/main/content/posts/" + p.Slug + ".md") }
						target="_blank"
						rel="noopener noreferrer"
						class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
					>
						<span class="flex items-center gap-2.5">
							@components.IconEditSuggest("w-4 h-4 text-muted group-hover:text-text shrink-0")
							<span>
								Edit on GitHub
							</span>
						</span>
						@components.IconArrowUpRight("w-3 h-3 text-muted/60")
					</a>
					<a
						href={ templ.SafeURL(shared.Prefix(lang) + "/contribute") }
						class="w-full h-10 px-4 text-left text-muted hover:text-text hover:bg-hover flex items-center justify-between gap-3 cursor-pointer rounded-none transition-colors group"
					>
						<span class="flex items-center gap-2.5">
							@components.IconContribute("w-4 h-4 text-muted group-hover:text-text shrink-0")
							<span>
								Contribute
							</span>
						</span>
						@components.IconArrowUpRight("w-3 h-3 text-muted/60")
					</a>
				</div>
			</div>
		</div>
	</div>
}
