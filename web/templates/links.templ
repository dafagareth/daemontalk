package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/links"
)

templ LinksPage(ui i18n.UI, grouped map[string][]links.Link, order []string) {
	<section class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
		<h1 class="display text-2xl sm:text-3xl font-semibold text-text mb-2">Links</h1>
		<p class="text-sm text-muted mb-10">Curated resources I find useful and return to often.</p>
		<div class="space-y-12">
			for _, cat := range order {
				if catLinks, ok := grouped[cat]; ok {
					<div>
						<h2 class="text-xs font-medium text-muted uppercase tracking-wide mb-4">{ cat }</h2>
						<ul class="space-y-4">
							for _, l := range catLinks {
								@linkItem(l)
							}
						</ul>
					</div>
				}
			}
		</div>
	</section>
}

templ linkItem(l links.Link) {
	<li class="flex items-start gap-4">
		<div class="shrink-0 mt-0.5 w-8 h-8 rounded-none border border-border bg-surface flex items-center justify-center">
			@IconLink("w-3.5 h-3.5 text-muted")
		</div>
		<div class="min-w-0">
			<a
				href={ templ.SafeURL(l.URL) }
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm font-medium text-link hover:underline"
			>
				{ l.Title }
			</a>
			<p class="text-sm text-muted mt-0.5 leading-relaxed">{ l.Description }</p>
		</div>
	</li>
}
