package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

func isRelatedIndonesian(lang string, posts []post.Post) bool {
	if lang == "id" {
		return true
	}
	for _, p := range posts {
		if p.Lang == "id" {
			return true
		}
	}
	return false
}

func relatedCountText(count int, isIndo bool) string {
	if count > 3 {
		count = 3
	}
	if isIndo {
		return fmt.Sprintf("%d tulisan", count)
	}
	return fmt.Sprintf("%d dispatches", count)
}

func limitRelated(posts []post.Post, limit int) []post.Post {
	if len(posts) > limit {
		return posts[:limit]
	}
	return posts
}

templ blogRelated(ui i18n.UI, related []post.Post, currentTags []string, lang string) {
	{{ _ = currentTags }}
	if len(related) > 0 {
		{{ isIndo := isRelatedIndonesian(lang, related) }}
		<section class="w-full font-sans border-t border-border pt-8 sm:pt-10">
			<div class="mb-5 sm:mb-6 flex items-center justify-between font-sans text-xs text-muted select-none">
				<span class="font-bold text-text uppercase tracking-wider">
					if isIndo {
						{ "Bacaan Terkait" }
					} else {
						{ "Related Dispatches" }
					}
				</span>
				<span class="text-[11px] text-muted">{ relatedCountText(len(related), isIndo) }</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
				for _, p := range limitRelated(related, 3) {
					@relatedCard(ui, p, lang, isIndo)
				}
			</div>
		</section>
	}
}

templ relatedCard(ui i18n.UI, p post.Post, lang string, isIndo bool) {
	{{
		cardLang := lang
		cardUI := ui
		if isIndo {
			cardLang = "id"
			cardUI = i18n.Get("id")
		}
	}}
	<article class="flex flex-col h-full group">
		<a
			href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) }
			class="block relative aspect-[16/9] w-full bg-surface mb-3.5 overflow-hidden border border-border"
		>
			@postThumbnailImg(p)
		</a>
		<div class="min-h-[1.25rem] mb-1.5 select-none">
			if len(p.Tags) > 0 {
				<a
					href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + p.Tags[0]) }
					class="text-[11px] font-sans font-bold uppercase tracking-wider text-accent hover:text-link transition-colors"
				>
					#{ p.Tags[0] }
				</a>
			}
		</div>
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block mb-2">
			<h3 class="display text-base sm:text-lg font-bold text-text group-hover:text-link transition-colors line-clamp-3 leading-snug break-words">
				{ p.Title }
			</h3>
		</a>
		if p.Description != "" {
			<p class="text-xs sm:text-sm text-muted line-clamp-2 leading-relaxed font-sans mb-3 break-words">
				{ p.Description }
			</p>
		}
		<div class="mt-auto pt-2 flex items-center gap-1.5 text-xs font-sans text-muted select-none">
			<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, cardLang) }</time>
			<span class="text-muted/40">·</span>
			<span>{ fmt.Sprintf("%d %s", p.ReadTime, cardUI.Blog_MinRead) }</span>
		</div>
	</article>
}
