package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ blogRelated(ui i18n.UI, related []post.Post, lang string) {
	if len(related) > 0 {
		<div class="mt-16 pt-8 border-t-4 border-[var(--c-text)]">
			<h3 class="text-xl font-bold font-sans text-text mb-6 uppercase tracking-widest">{ ui.Post_Related }</h3>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				for _, rp := range related {
					<article class="group flex flex-col gap-0 min-w-0">
						<div class="relative aspect-[16/9] w-full overflow-hidden shrink-0 mb-3 bg-surface">
							@postThumbnail(rp, blogPrefix(lang) + "/blog/" + rp.Slug)
						</div>
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + rp.Slug) } data-slug={ rp.Slug } class="block group mb-1">
							<h3 class="text-sm sm:text-base font-black text-text group-hover:text-link transition-colors line-clamp-3 leading-snug break-words">
								{ rp.Title }
							</h3>
						</a>
						<div class="flex flex-wrap items-center gap-1 sm:gap-2 mb-1 text-[9px] sm:text-[11px] font-mono text-muted uppercase tracking-wider">
							<time datetime={ rp.Date.Format("2006-01-02") }>{ fmtDate(rp) }</time>
							<span>·</span>
							<span>{ fmt.Sprintf("%d %s", rp.ReadTime, ui.Blog_MinRead) }</span>
						</div>
						if rp.Description != "" {
							<p class="text-xs sm:text-sm text-muted line-clamp-2 leading-relaxed mt-1 break-words">
								{ rp.Description }
							</p>
						}
					</article>
				}
			</div>
		</div>
	}
}
