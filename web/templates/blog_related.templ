package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ blogRelated(ui i18n.UI, related []post.Post, currentTags []string, lang string) {
	if len(related) > 0 {
		<section class="w-full font-sans">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 divide-y lg:divide-y-0 lg:divide-x divide-border/60 items-start">
				if len(related) > 0 {
					<article class="lg:col-span-6 flex flex-col justify-between group">
						<div class="space-y-4">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[0].Slug) } class="block w-full aspect-[16/9] overflow-hidden bg-surface border border-border">
								@postThumbnailImg(related[0])
							</a>
							<div class="space-y-2">
								<div class="flex items-center gap-2 text-xs sm:text-sm font-mono text-muted flex-wrap">
									if len(related[0].Tags) > 0 {
										<span class="font-bold uppercase text-accent">#{ related[0].Tags[0] }</span>
										<span>·</span>
									}
									<time datetime={ related[0].Date.Format("2006-01-02") }>{ fmtDate(related[0], lang) }</time>
									<span>·</span>
									<span>{ fmt.Sprintf("%d %s", related[0].ReadTime, ui.Blog_MinRead) }</span>
								</div>
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[0].Slug) } data-slug={ related[0].Slug } class="block">
									<h3 class="text-xl sm:text-2xl lg:text-[26px] font-extrabold text-text group-hover:text-link transition-colors leading-tight line-clamp-2">
										{ related[0].Title }
									</h3>
								</a>
								if related[0].Description != "" {
									<p class="text-sm sm:text-base text-muted line-clamp-3 leading-relaxed font-sans pt-1">
										{ related[0].Description }
									</p>
								}
							</div>
						</div>
						<div class="pt-3 mt-auto">
							<a
								href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[0].Slug) }
								class="inline-flex items-center justify-between w-full text-xs sm:text-sm font-mono text-text font-bold group-hover:text-link transition-colors"
							>
								<span>
									if lang == "id" {
										Baca Artikel Lengkap
									} else {
										Read Full Dispatch
									}
								</span>
								@IconArrowRight("w-4 h-4 transition-transform group-hover:translate-x-1")
							</a>
						</div>
					</article>
				}
				<div class="lg:col-span-6 lg:pl-10 flex flex-col divide-y divide-border/60 pt-6 lg:pt-0">
					for i := 1; i < len(related) && i <= 3; i++ {
						<article class={ templ.KV("pb-5", i < 3 && i < len(related)-1), templ.KV("pt-5", i > 1), "flex flex-col sm:flex-row gap-5 items-start group" }>
							<a
								href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[i].Slug) }
								class="w-full sm:w-44 lg:w-48 xl:w-52 aspect-[16/9] overflow-hidden bg-surface border border-border shrink-0 block"
							>
								@postThumbnailImg(related[i])
							</a>
							<div class="flex-1 min-w-0 space-y-1.5 flex flex-col justify-between">
								<div class="space-y-1.5">
									<div class="flex items-center gap-2 text-xs font-mono text-muted flex-wrap">
										if len(related[i].Tags) > 0 {
											<span class="font-bold uppercase text-accent">#{ related[i].Tags[0] }</span>
											<span>·</span>
										}
										<span>{ fmt.Sprintf("%d %s", related[i].ReadTime, ui.Blog_MinRead) }</span>
									</div>
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[i].Slug) } data-slug={ related[i].Slug } class="block">
										<h4 class="text-base sm:text-lg lg:text-xl font-bold text-text group-hover:text-link transition-colors line-clamp-2 leading-snug">
											{ related[i].Title }
										</h4>
									</a>
									if related[i].Description != "" {
										<p class="text-xs sm:text-sm text-muted line-clamp-2 leading-relaxed font-sans">
											{ related[i].Description }
										</p>
									}
								</div>
								<div class="pt-2">
									<a
										href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + related[i].Slug) }
										class="inline-flex items-center gap-1 text-xs sm:text-sm font-mono text-link hover:underline font-bold"
									>
										<span>
											if lang == "id" {
												Baca Artikel
											} else {
												Read Article
											}
										</span>
										@IconArrowRight("w-3 h-3 transition-transform group-hover:translate-x-0.5")
									</a>
								</div>
							</div>
						</article>
					}
				</div>
			</div>
		</section>
	}
}
