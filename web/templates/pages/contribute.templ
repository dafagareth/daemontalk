package pages

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"daemontalk/web/templates/components"
	"daemontalk/web/templates/shared"
	"fmt"
	"html/template"
)

type ContributeSections struct {
	Dispatches   template.HTML
	Engine       template.HTML
	Corrections  template.HTML
	I18n         template.HTML
	Contributors []post.ContributorStats
}

templ ContributePage(ui i18n.UI, sections ContributeSections, lang string) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh] font-sans">
		<div class="mb-6 font-sans">
			<a
				href={ templ.SafeURL(shared.Prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs font-sans font-medium text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@components.IconArrowLeft("w-3.5 h-3.5")
				<span>
					Back to Dispatches
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight uppercase">
				Writing & Contributor Guide
			</h1>
		</div>
		<div class="w-full font-sans">
			<div class="border-b border-border/40 flex items-center justify-between overflow-x-auto text-xs font-sans select-none" id="contribute-tabs">
				<div class="flex items-center shrink-0">
					<button
						type="button"
						onclick="switchContributeTab('dispatches')"
						id="tab-btn-dispatches"
						class="contribute-tab-btn px-4 sm:px-5 py-3 cursor-pointer transition-colors bg-surface text-text font-bold border-b-2 border-b-link whitespace-nowrap"
					>
						Dispatches
					</button>
					<button
						type="button"
						onclick="switchContributeTab('engine')"
						id="tab-btn-engine"
						class="contribute-tab-btn px-4 sm:px-5 py-3 cursor-pointer transition-colors text-muted hover:text-text bg-chip/30 border-b-2 border-b-transparent whitespace-nowrap"
					>
						Core Engine
					</button>
					<button
						type="button"
						onclick="switchContributeTab('corrections')"
						id="tab-btn-corrections"
						class="contribute-tab-btn px-4 sm:px-5 py-3 cursor-pointer transition-colors text-muted hover:text-text bg-chip/30 border-b-2 border-b-transparent whitespace-nowrap"
					>
						Corrections
					</button>
					<button
						type="button"
						onclick="switchContributeTab('i18n')"
						id="tab-btn-i18n"
						class="contribute-tab-btn px-4 sm:px-5 py-3 cursor-pointer transition-colors text-muted hover:text-text bg-chip/30 border-b-2 border-b-transparent whitespace-nowrap"
					>
						Localization
					</button>
					<button
						type="button"
						onclick="switchContributeTab('contributors')"
						id="tab-btn-contributors"
						class="contribute-tab-btn px-4 sm:px-5 py-3 cursor-pointer transition-colors text-muted hover:text-text bg-chip/30 border-b-2 border-b-transparent whitespace-nowrap flex items-center gap-1.5"
					>
						<span>Contributors</span>
						if len(sections.Contributors) > 0 {
							<span class="px-1.5 py-0.2 bg-chip border border-border text-[10px] text-link font-bold">
								{ fmt.Sprintf("%d", len(sections.Contributors)) }
							</span>
						}
					</button>
				</div>
			</div>
			<div class="py-6 min-h-[350px]">
				<div id="panel-dispatches" class="contribute-panel prose max-w-none font-sans">
					@templ.Raw(string(sections.Dispatches))
				</div>
				<div id="panel-engine" class="contribute-panel hidden prose max-w-none font-sans">
					@templ.Raw(string(sections.Engine))
				</div>
				<div id="panel-corrections" class="contribute-panel hidden prose max-w-none font-sans">
					@templ.Raw(string(sections.Corrections))
				</div>
				<div id="panel-i18n" class="contribute-panel hidden prose max-w-none font-sans">
					@templ.Raw(string(sections.I18n))
				</div>
				<div id="panel-contributors" class="contribute-panel hidden font-sans space-y-6">
					<div>
						<h2 class="text-xl font-bold text-text font-sans">
							Contributors Directory
						</h2>
					</div>
					if len(sections.Contributors) > 0 {
						<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 pt-2 font-sans text-xs">
							for _, c := range sections.Contributors {
								<div class="flex items-center gap-3 py-2">
									<img
										src={ c.AvatarURL }
										alt={ c.Username }
										class="w-10 h-10 rounded-none border border-border object-cover shrink-0"
										loading="lazy"
									/>
									<a
										href={ templ.SafeURL(c.GitHubURL) }
										target="_blank"
										rel="noopener noreferrer"
										class="font-bold text-text hover:text-link hover:underline truncate text-sm"
									>
										{ "@" + c.Username }
									</a>
								</div>
							}
						</div>
					} else {
						<div class="p-8 text-center font-sans text-xs text-muted">
							No contributors registered yet.
						</div>
					}
					<div class="pt-6 border-t border-border/40 font-sans text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<div>
							<strong class="text-text block mb-1">
								Want Your Name Listed Here?
							</strong>
							<span class="text-muted font-sans text-xs">
								Share your tech articles or contribute improvements on GitHub.
							</span>
						</div>
						<a
							href="https://github.com/dafagareth/daemontalk"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-border bg-surface text-link transition-colors font-bold shrink-0"
						>
							<span>GitHub</span>
							@components.IconArrowUpRight("w-3 h-3")
						</a>
					</div>
				</div>
			</div>
		</div>
		<script src={ shared.AssetURL("/static/js/contribute.js") } defer></script>
	</section>
}
