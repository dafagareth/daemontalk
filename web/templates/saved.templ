package templates

import "daemontalk/internal/i18n"

templ SavedPage(ui i18n.UI, lang string) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-6">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@IconArrowLeft("w-3.5 h-3.5")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight uppercase">
				{ ui.Link_ReadingList }
			</h1>
		</div>
		<div
			id="saved-box"
			data-i18n-count={ ui.Saved_Count }
			data-i18n-empty-heading={ ui.Saved_EmptyHeading }
			data-i18n-empty-body={ ui.Saved_EmptyBody }
			data-i18n-remove={ ui.Saved_Remove }
			data-lang={ lang }
			class="border-0 sm:border border-border bg-transparent sm:bg-surface/10 font-sans overflow-hidden"
		>
			<div class="border-b border-border bg-transparent sm:bg-surface/50 px-3 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between gap-3 text-xs font-sans select-none">
				<span class="font-bold text-text uppercase tracking-wider text-xs">
					if lang == "id" {
						ARTIKEL TERSIMPAN
					} else {
						BOOKMARKED DISPATCHES
					}
				</span>
				<span id="saved-count-display" class="text-xs font-sans text-muted font-bold shrink-0">0 { ui.Saved_Count }</span>
			</div>
			<div id="saved-list" class="divide-y divide-border/60">
				<div class="p-8 sm:p-12 text-center font-sans">
					<p class="text-xs text-muted flex items-center justify-center gap-2">
						<span class="w-1.5 h-1.5 bg-accent animate-pulse"></span>
						Reading saved dispatches...
					</p>
				</div>
			</div>
		</div>
	</section>
	<script src="/static/js/saved.js" defer></script>
}
