package templates

import "daemontalk/internal/i18n"

templ SavedPage(ui i18n.UI, lang string) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-6">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@IconArrowLeft("w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight">
				{ ui.Link_ReadingList }
			</h1>
		</div>
		<div
			id="saved-box"
			data-i18n-count={ ui.Saved_Count }
			data-i18n-empty-heading={ ui.Saved_EmptyHeading }
			data-i18n-empty-body={ ui.Saved_EmptyBody }
			data-i18n-remove={ ui.Saved_Remove }
			class="sm:border sm:border-border sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden font-sans"
		>
			<div class="border border-border sm:border-0 sm:border-b sm:border-border bg-surface p-4 sm:p-6 flex items-center justify-between gap-3 text-xs sm:text-sm font-mono text-muted select-none">
				<div class="flex items-center gap-3 text-text font-bold min-w-0">
					<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
					<code class="text-sm sm:text-base font-mono truncate">cat ~/.local/share/daemontalk/saved</code>
				</div>
				<span id="saved-count-display" class="text-xs font-mono text-muted font-bold shrink-0">0 { ui.Saved_Count }</span>
			</div>
			<div id="saved-list" class="divide-y divide-border/60 mt-4 sm:mt-0">
				<div class="p-12 text-center font-mono">
					<p class="text-xs text-muted flex items-center justify-center gap-2">
						<span class="w-1.5 h-1.5 bg-accent animate-pulse"></span>
						Reading saved dispatches...
					</p>
				</div>
			</div>
		</div>
	</section>
	<script src="/static/js/saved.js" defer></script>
}
