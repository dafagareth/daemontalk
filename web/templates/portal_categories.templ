package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

templ portalCategoryTrio(ui i18n.UI, categories []CategorySection, lang string) {
	// BOX 2: TRI-COLUMN CORE TOPICS (4:4:4) - SEAMLESS WIREFRAME
	<div class="border-0 sm:border-x sm:border-b border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--c-border)]">
			for idx, cat := range categories {
				<div class={
					"flex flex-col px-5 sm:px-6 py-8 sm:py-9 lg:py-12 lg:px-7 border-b border-border sm:border-b-0 sm:border-r last:border-0",
					templ.KV("sm:hidden", idx >= 3),
				}>
					<div>
						// Category Header
						<div class="flex items-center justify-between mb-3">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-xs font-mono font-black uppercase tracking-widest text-text hover:text-link">
								{ categoryTitle(cat, lang) }
							</a>
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted hover:text-link flex items-center gap-1 group shrink-0">
								if lang == "id" {
									<span>Lihat Semua</span>
								} else {
									<span>See More</span>
								}
								@IconArrowRight("w-3 h-3 transition-transform group-hover:translate-x-0.5")
							</a>
						</div>

						// Lead Post (Split-Row on Mobile, Stacked on Desktop)
						<article class="group mb-5 sm:mb-6">
							<div class="flex flex-col gap-3 sm:gap-0">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block relative aspect-[16/9] w-auto sm:w-full -mx-5 sm:mx-0 shrink-0 bg-surface mb-3 sm:mb-3 overflow-hidden border-y sm:border border-border">
									@postThumbnailImg(cat.LeadPost)
								</a>
								<div class="flex-1 min-w-0">
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block mb-1.5">
										<h3 class="display text-[17px] font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-3 sm:line-clamp-2">
											{ cat.LeadPost.Title }
										</h3>
									</a>
									if cat.LeadPost.Description != "" {
										<p class="line-clamp-2 text-[13px] text-muted leading-relaxed mb-2">
											{ cat.LeadPost.Description }
										</p>
									}
									<div class="text-[11px] font-mono text-muted mt-1 sm:mt-0">
										<span>{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</div>
							</div>
						</article>
					</div>

					// Sub Posts List (Teks Only)
					if len(cat.SubPosts) > 0 {
						<div class="flex flex-col divide-y divide-border/40 border-t border-border/40 mt-auto pt-1">
							for j, sub := range cat.SubPosts {
								if j < 3 {
									<article class="group">
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class={
											"block pt-3.5 sm:pt-4",
											templ.KV("pb-3.5 sm:pb-4", j != 2 && j != len(cat.SubPosts)-1),
										}>
											<h4 class="display text-[15px] font-semibold text-text/90 group-hover:text-link transition-colors leading-snug line-clamp-2 mb-1.5">
												{ sub.Title }
											</h4>
											<div class="text-[11px] font-mono text-muted">
												<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
											</div>
										</a>
									</article>
								}
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}
