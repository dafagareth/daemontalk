package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ portalCategoryStackedRows(ui i18n.UI, categories []CategorySection, lang string) {
	<div class="border-0 sm:border-x sm:border-b border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="flex flex-col divide-y divide-[var(--c-border)]">
			for idx, cat := range categories {
				<div class="flex flex-col">
					<div class="px-5 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-4 sm:pb-6 flex items-center justify-between bg-bg">
						<div class="text-lg font-display font-black capitalize tracking-tight text-text flex items-center gap-1.5">
							@categoryMultiLinks(cat.Tag, lang, "hover:text-link transition-colors", "text-muted/60 font-sans select-none")
						</div>
					</div>
					if idx == 0 {
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 px-5 sm:px-6 lg:px-8 pb-8">
							<div class="lg:col-span-5 flex flex-col">
								@editorialTowerLeadPost(cat.LeadPost, lang, ui)
							</div>
							<div class="lg:col-span-7 flex flex-col justify-between gap-6">
								if len(cat.SubPosts) > 0 {
									<div class="pb-0 sm:pb-2">
										@editorialTowerTopPost(cat.SubPosts[0], lang, ui)
									</div>
								}
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 flex-1">
									if len(cat.SubPosts) > 1 {
										<div>
											@editorialTowerSubPost(cat.SubPosts[1], lang, ui)
										</div>
									}
									if len(cat.SubPosts) > 2 {
										<div>
											@editorialTowerSubPost(cat.SubPosts[2], lang, ui)
										</div>
									}
								</div>
							</div>
						</div>
					} else {
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-0 px-5 sm:px-0 pb-8 sm:pb-0">
							<div class="px-0 sm:px-6 lg:px-6 mb-0 md:mb-6">
								@editorialShelfLeadPost(cat.LeadPost, lang, ui)
							</div>
							if len(cat.SubPosts) > 0 {
								<div class="px-0 sm:px-6 lg:px-6 mb-0 md:mb-6">
									@editorialLargeShelfPost(cat.SubPosts[0], lang, ui)
								</div>
							}
							if len(cat.SubPosts) > 1 {
								<div class="px-0 sm:px-6 lg:px-6 mb-0 md:mb-6">
									@editorialLargeShelfPost(cat.SubPosts[1], lang, ui)
								</div>
							}
							if len(cat.SubPosts) > 2 {
								<div class="px-0 sm:px-6 lg:px-6 mb-0 md:mb-6">
									@editorialLargeShelfPost(cat.SubPosts[2], lang, ui)
								</div>
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ editorialTowerLeadPost(p post.Post, lang string, ui i18n.UI) {
	<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group block h-full flex flex-col justify-between">
		<div class="flex flex-col items-start justify-between">
			<div class="w-full bg-surface overflow-hidden border border-[var(--c-border)] shrink-0 mb-3 sm:mb-4 aspect-[16/9]">
				@postThumbnailImg(p)
			</div>
			<div class="flex-1 min-w-0 w-full">
				<h2 class="display text-xl sm:text-3xl font-extrabold text-text group-hover:text-link transition-colors leading-tight mb-1.5 sm:mb-3 line-clamp-3 sm:line-clamp-none">
					{ p.Title }
				</h2>
				if p.Description != "" {
					<p class="text-xs sm:text-sm text-muted line-clamp-2 sm:line-clamp-3 leading-relaxed mb-3 sm:mb-4">
						{ p.Description }
					</p>
				}
				<div class="flex items-center gap-2 text-[10px] sm:text-xs font-mono text-muted mt-auto pt-1 sm:pt-0">
					<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
					<span>·</span>
					<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
	</a>
}

templ editorialShelfLeadPost(p post.Post, lang string, ui i18n.UI) {
	<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group block h-full flex flex-col justify-between">
		<div class="flex flex-col items-start justify-between">
			<div class="w-full bg-surface overflow-hidden border border-[var(--c-border)] shrink-0 mb-3 aspect-[16/9]">
				@postThumbnailImg(p)
			</div>
			<div class="flex-1 min-w-0 w-full">
				<h3 class="display text-xl sm:text-lg font-bold text-text group-hover:text-link transition-colors leading-snug mb-1.5 sm:mb-2 line-clamp-3 sm:line-clamp-none">
					{ p.Title }
				</h3>
				if p.Description != "" {
					<p class="text-xs sm:text-sm text-muted line-clamp-2 sm:hidden leading-relaxed mb-3">
						{ p.Description }
					</p>
				}
				<div class="flex items-center gap-2 text-[10px] font-mono text-muted mt-auto pt-1">
					<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
					<span>·</span>
					<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
	</a>
}

templ editorialTowerTopPost(p post.Post, lang string, ui i18n.UI) {
	<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group block h-full flex flex-row-reverse sm:flex-row gap-4 sm:gap-5 items-start justify-between">
		<div class="w-28 xs:w-32 sm:w-5/12 shrink-0 bg-surface overflow-hidden border border-[var(--c-border)] aspect-[16/9]">
			@postThumbnailImg(p)
		</div>
		<div class="flex-1 min-w-0 flex flex-col justify-between h-full">
			<div>
				<h3 class="display text-base sm:text-xl font-bold text-text group-hover:text-link transition-colors leading-snug mb-1.5 line-clamp-3 sm:line-clamp-none">
					{ p.Title }
				</h3>
			</div>
			<div class="flex items-center gap-2 text-[10px] sm:text-[11px] font-mono text-muted mt-auto pt-1">
				<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
				<span>·</span>
				<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>
		</div>
	</a>
}

