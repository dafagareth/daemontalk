package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ portalBox4SplitRiver(ui i18n.UI, leftCats []CategorySection, wirePosts []post.Post, lang string) {
	<div class="border-0 sm:border-x sm:border-b border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
			<div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 divide-y divide-border/40 sm:divide-y-0 sm:divide-x sm:divide-[var(--c-border)]">
				for _, cat := range leftCats {
					<article class="flex flex-col justify-between group py-6 px-5 sm:p-6 lg:p-7">
						<div class="flex flex-col gap-3 sm:gap-4">
							<div class="flex items-center justify-between gap-2">
								<div class="text-xs font-mono font-bold uppercase tracking-widest text-accent flex items-center gap-1.5">
									@categoryMultiLinks(cat.Tag, lang, "hover:underline", "text-muted/60 select-none")
								</div>
								<span class="text-[11px] font-mono text-muted">
									{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }
								</span>
							</div>
							<div class="flex flex-row-reverse sm:flex-col items-start gap-4 sm:gap-0 justify-between">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block relative aspect-[16/9] w-28 xs:w-32 sm:w-full bg-surface overflow-hidden border border-border shrink-0 sm:mb-3">
									@postThumbnailImg(cat.LeadPost)
								</a>
								<div class="flex-1 min-w-0">
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block mb-1.5 sm:mb-2">
										<h3 class="display text-lg sm:text-xl lg:text-2xl font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-3 sm:line-clamp-none">
											{ cat.LeadPost.Title }
										</h3>
									</a>
									if cat.LeadPost.Description != "" {
										<p class="hidden sm:block text-[13px] sm:text-sm text-muted line-clamp-2 leading-relaxed mb-3">
											{ cat.LeadPost.Description }
										</p>
									}
									<div class="flex text-[10px] sm:text-xs font-mono text-muted items-center justify-between mt-auto pt-1 sm:pt-2">
										<span class="font-bold text-text">
											if cat.LeadPost.Author != "" {
												{ cat.LeadPost.Author }
											} else {
												daemontalk team
											}
										</span>
										<time datetime={ cat.LeadPost.Date.Format("2006-01-02") }>{ fmtDate(cat.LeadPost, lang) }</time>
									</div>
								</div>
							</div>
						</div>
					</article>
				}
			</div>
			<div class="lg:col-span-4 flex flex-col bg-surface/30">
				<div class="flex items-center justify-between px-4 py-3 border-b border-border bg-surface text-xs font-mono font-bold uppercase tracking-wider">
					<div class="flex items-center gap-2 text-text">
						<span>RECENT DISPATCHES</span>
					</div>
					<span class="text-[10px] text-muted font-normal uppercase font-mono tracking-wider">INDEX</span>
				</div>
				<div class="px-5 sm:px-6 py-6 flex flex-col divide-y divide-border/40 flex-1 justify-around">
					for _, p := range wirePosts {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group py-4 sm:py-5 block text-text">
							<div class="flex items-center gap-2 mb-1">
								if len(p.Tags) > 0 {
									<span class="text-accent text-[10px] font-bold uppercase tracking-wider">{ p.Tags[0] }</span>
								}
								<span class="text-muted text-[11px]">·</span>
								<time class="text-muted text-[11px] font-mono">{ fmtDate(p, lang) }</time>
							</div>
							<h4 class="display text-base font-bold group-hover:text-link transition-colors leading-snug line-clamp-2 mb-1.5">
								{ p.Title }
							</h4>
							<div class="text-[11px] font-mono text-muted">
								{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }
							</div>
						</a>
					}
				</div>
			</div>
		</div>
	</div>
}
