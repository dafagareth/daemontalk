package templates

import (
	"fmt"
	"time"

	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

func getDailyBriefingDate(articles []post.Post) time.Time {
	now := time.Now()
	if len(articles) > 0 && articles[0].Date.After(now) {
		return articles[0].Date
	}
	return now
}

templ DailyPage(ui i18n.UI, lang string, articles []post.Post, host string) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-6 font-sans">
			<div>
				<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight mb-1">
					{ ui.Daily_Title }
				</h1>
				<p id="daily-date" class="text-xs font-mono text-muted">
					{ fmtFullDate(getDailyBriefingDate(articles), lang) }
				</p>
			</div>
			<span class="text-xs font-mono text-muted">
				{ fmt.Sprintf("%d %s", len(articles), ui.Daily_Dispatches) }
			</span>
		</div>
		<div class="sm:border sm:border-border sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden font-sans">
			<div class="border border-border sm:border-0 sm:border-b sm:border-border bg-surface p-4 sm:p-6 flex items-center justify-between gap-3 text-xs sm:text-sm font-mono text-muted select-none">
				<div class="flex items-center gap-3 text-text font-bold min-w-0">
					<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
					<code class="text-sm sm:text-base font-mono truncate">curl -sL https://{ host }/daily</code>
				</div>
				<button
					type="button"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigator.clipboard.writeText('curl -sL https://%s/daily'); this.textContent = 'COPIED!'; this.style.color='#3fb950'; setTimeout(() => { this.textContent = 'COPY'; this.style.color=''; }, 1200)", host)} }
					class="text-[11px] px-2 py-0.5 border border-border bg-chip text-muted hover:text-text hover:border-link transition-colors cursor-pointer shrink-0 font-mono"
				>
					COPY
				</button>
			</div>
			<ul class="divide-y divide-border/60 mt-4 sm:mt-0">
				for i, p := range articles {
					<li class="hover:bg-hover transition-colors group">
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="px-0 sm:px-7 py-4 sm:py-6 flex items-baseline justify-between gap-4">
							<div class="flex items-baseline gap-2.5 min-w-0">
								<span class="text-link font-mono font-bold text-xs shrink-0">{ fmt.Sprintf("%02d.", i+1) }</span>
								<h2 class="text-sm sm:text-base font-bold text-text group-hover:text-link leading-snug transition-colors truncate">
									{ p.Title }
								</h2>
							</div>
							<time datetime={ p.Date.Format("2006-01-02") } class="text-xs font-mono text-muted shrink-0">
								{ fmtDate(p, lang) }
							</time>
						</a>
					</li>
				}
			</ul>
		</div>
		<script src={ assetURL("/static/js/daily.js") } defer></script>
	</section>
}
