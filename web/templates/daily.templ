package templates

import (
	"fmt"
	"time"

	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ DailyPage(ui i18n.UI, lang string, articles []post.Post, host string) {
	<div class="container-page py-8 sm:py-12">
		<div class="max-w-3xl">
			<!-- ASCII Art Header -->
			<div class="mb-6">
				<pre class="font-mono text-xs sm:text-sm text-link select-none overflow-x-auto leading-tight">
{ `     _                                _        _ _    
  __| | __ _  ___ _ __ ___   ___  _ __ | |_ __ _| | | __
 / _` + "`" + ` |/ _` + "`" + ` |/ _ \ '_ ` + "`" + ` _ \ / _ \| '_ \| __/ _` + "`" + ` | | |/ /
| (_| | (_| |  __/ | | | | | (_) | | | | || (_| | |   < 
 \__,_|\__,_|\___|_| |_| |_|\___/|_| |_|\__\__,_|_|_|\_\` }
				</pre>
			</div>

			<!-- Page Header -->
			<div class="pb-6 mb-8 border-b border-border">
				<h1 class="display text-2xl sm:text-3xl font-semibold text-text mb-2">Daily Technical Briefing</h1>
				<p class="text-xs text-muted font-mono mb-4">
					{ time.Now().Format("Monday, 02 January 2006") } · Host: { host }
				</p>
				<p class="text-sm text-muted leading-relaxed mb-5">
					A concise daily summary of engineering dispatches, system internals, and CLI endpoints for terminal workflows.
				</p>

				<!-- CLI Quick Command Bar -->
				<div class="flex items-center justify-between gap-3 p-3 bg-chip border border-border">
					<div class="flex items-center gap-2 min-w-0 font-mono text-xs">
						<span class="text-muted select-none">$</span>
						<code class="text-text select-all truncate">curl -sL https://{ host }/daily</code>
					</div>
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigator.clipboard.writeText('curl -sL https://%s/daily'); this.textContent = 'Copied'; setTimeout(() => this.textContent = 'Copy', 2000)", host)} }
						class="text-xs px-2.5 py-1 bg-surface border border-border text-muted hover:text-text transition-colors font-mono cursor-pointer shrink-0"
					>
						Copy
					</button>
				</div>
			</div>

			<!-- Section: Top Dispatches -->
			<section class="mb-12">
				<div class="flex items-center justify-between pb-2 mb-6 border-b border-border">
					<h2 class="text-xs font-semibold text-muted uppercase tracking-wider font-mono">Top Dispatches</h2>
					<span class="text-xs text-muted font-mono">{ fmt.Sprintf("%d articles", len(articles)) }</span>
				</div>

				<div class="divide-y divide-border">
					for i, p := range articles {
						<article class="py-5 first:pt-0 last:pb-0">
							<div class="flex items-baseline justify-between gap-4 mb-1.5 font-mono text-xs">
								<div class="flex items-center gap-2">
									<span class="text-link font-semibold">{ fmt.Sprintf("[%02d]", i+1) }</span>
									if len(p.Tags) > 0 {
										<span class="text-muted">
											for _, tag := range p.Tags {
												<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + tag) } class="hover:text-text mr-1.5 uppercase">
													#{ tag }
												</a>
											}
										</span>
									}
								</div>
								<span class="text-muted shrink-0">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
							</div>

							<h3 class="text-base sm:text-lg font-semibold text-text mb-2 leading-snug">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="hover:text-link hover:underline">
									{ p.Title }
								</a>
							</h3>

							if p.Description != "" {
								<p class="text-sm text-muted leading-relaxed mb-3">
									{ p.Description }
								</p>
							}

							<div class="flex items-center justify-between gap-3 text-xs font-mono text-muted">
								<div class="flex items-center gap-1.5 min-w-0">
									<span class="select-none text-muted">CLI:</span>
									<code class="text-text select-all truncate">curl -sL { host }/p/{ p.Slug }</code>
								</div>
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="text-link hover:underline shrink-0">
									Read online
								</a>
							</div>
						</article>
					}
				</div>
			</section>



			<!-- Section: Terminal Endpoints Guide -->
			<section class="pt-6 border-t border-border">
				<h2 class="text-xs font-semibold text-muted uppercase tracking-wider font-mono mb-4">Terminal Endpoints Guide</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
					@cliEndpointRow(host, "/daily", "Full daily tech briefing")
					@cliEndpointRow(host, "/recipes", "Linux sysadmin & eBPF recipes")
					@cliEndpointRow(host, "/t/go", "Stream Go backend articles")
					@cliEndpointRow(host, "/t/linux", "Stream Linux kernel articles")
					@cliEndpointRow(host, "/t/python", "Stream Python articles")
					@cliEndpointRow(host, "/feed.json", "JSON feed for terminal scripts")
				</div>
			</section>
		</div>
	</div>
}

templ cliEndpointRow(host string, path string, desc string) {
	<div class="p-2.5 bg-chip border border-border flex items-center justify-between gap-2">
		<div class="min-w-0">
			<code class="text-text font-bold block truncate">curl -sL { host }{ path }</code>
			<span class="text-muted text-[11px] block truncate font-sans">{ desc }</span>
		</div>
		<button
			type="button"
			onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigator.clipboard.writeText('curl -sL https://%s%s'); this.textContent = 'Copied'; setTimeout(() => this.textContent = 'Copy', 1500)", host, path)} }
			class="text-[10px] px-2 py-0.5 bg-surface border border-border text-muted hover:text-text transition-colors cursor-pointer shrink-0 font-mono"
		>
			Copy
		</button>
	</div>
}
