package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ portalBox6EssayBanner(ui i18n.UI, essaySec CategorySection, sidePosts []post.Post, lang string) {
	// BOX 6: ASYMMETRIC ESSAY BANNER (7 : 5) - FULL BLEED INVERTED ACCENT BANNER ON MOBILE (PATTERN 7)
	<div class="border-0 sm:border-x-2 sm:border-b-2 sm:border-[var(--c-border)] w-full mt-0 sm:mt-0 mb-0 bg-[var(--c-text)] text-[var(--c-bg)] sm:bg-[var(--c-bg)] sm:text-[var(--c-text)]">
		<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-bg)]/30 sm:divide-[var(--c-border)]">
			
			// LEFT COLUMN (7 cols / ~58%): Horizontal Lead Essay Card
			<div class="lg:col-span-7 px-4 sm:px-5 py-6 sm:py-8 lg:py-12 lg:px-6 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between pb-2 mb-4 border-b-2 border-[var(--c-bg)]/40 sm:border-[var(--c-border)]">
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + essaySec.Tag) } class="text-xs font-mono font-black uppercase tracking-widest text-[var(--c-bg)] sm:text-[var(--c-text)] hover:opacity-80 sm:hover:text-[var(--c-link)]">
							{ categoryTitle(essaySec, lang) }
						</a>
						<span class="text-[10px] font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-muted)] uppercase">FEATURED ESSAY</span>
					</div>

					<article class="group mb-4">
						<div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + essaySec.LeadPost.Slug) } class="w-full sm:w-1/2 aspect-[16/9] bg-[var(--c-bg)]/10 sm:bg-[var(--c-surface)] overflow-hidden border border-[var(--c-bg)]/30 sm:border-[var(--c-border)] shrink-0 block">
								@postThumbnailImg(essaySec.LeadPost)
							</a>
							<div class="w-full sm:w-1/2 flex flex-col">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + essaySec.LeadPost.Slug) } class="block mb-2">
									<h3 class="display text-base sm:text-lg font-bold text-[var(--c-bg)] sm:text-[var(--c-text)] opacity-100 group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-snug">
										{ essaySec.LeadPost.Title }
									</h3>
								</a>
								if essaySec.LeadPost.Description != "" {
									<p class="text-xs text-[var(--c-bg)]/80 sm:text-[var(--c-muted)] line-clamp-3 leading-relaxed mb-3">
										{ essaySec.LeadPost.Description }
									</p>
								}
								<div class="text-[10px] font-mono text-[var(--c-bg)]/60 sm:text-[var(--c-muted)] mt-auto">
									<span>{ fmt.Sprintf("%d %s", essaySec.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</div>
						</div>
					</article>
				</div>

				// Sub posts below essay
				if len(essaySec.SubPosts) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 border-t border-[var(--c-bg)]/30 sm:border-[var(--c-border)]/40 pt-3 mt-auto">
						for j, sub := range essaySec.SubPosts {
							if j < 2 {
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class="group block">
									<h4 class="display text-xs sm:text-sm font-semibold text-[var(--c-bg)] sm:text-[var(--c-text)] group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-snug line-clamp-2 mb-1">
										{ sub.Title }
									</h4>
									<div class="text-[9px] font-mono text-[var(--c-bg)]/60 sm:text-[var(--c-muted)]">
										<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</a>
							}
						}
					</div>
				}
			</div>

			// RIGHT COLUMN (5 cols / ~42%): Stacked Spotlight with 16:9 Mini Thumbnails
			<div class="lg:col-span-5 px-4 sm:px-5 py-6 sm:py-8 lg:py-12 lg:px-6 flex flex-col justify-between bg-[var(--c-bg)]/5 sm:bg-[var(--c-surface)]/20">
				<div>
					<div class="flex items-center justify-between pb-2 mb-4 border-b-2 border-[var(--c-bg)]/40 sm:border-[var(--c-border)]">
						<span class="text-xs font-mono font-black uppercase tracking-widest text-[var(--c-bg)] sm:text-[var(--c-text)]">
							ARCHITECTURE SPOTLIGHT
						</span>
						<span class="text-[10px] font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-accent)]">DISPATCHES</span>
					</div>

					<div class="flex flex-col divide-y divide-[var(--c-bg)]/20 sm:divide-[var(--c-border)]/40">
						for _, p := range sidePosts {
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group py-2.5 first:pt-0 last:pb-0 flex items-start justify-between gap-3">
								<div class="flex-1 min-w-0">
									if len(p.Tags) > 0 {
										<span class="text-[var(--c-bg)]/80 sm:text-[var(--c-accent)] text-[9px] font-bold uppercase tracking-wider block mb-0.5">{ p.Tags[0] }</span>
									}
									<h4 class="display text-xs sm:text-sm font-semibold text-[var(--c-bg)] sm:text-[var(--c-text)] group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-snug line-clamp-2">
										{ p.Title }
									</h4>
									<div class="text-[9px] font-mono text-[var(--c-bg)]/60 sm:text-[var(--c-muted)] mt-1">
										{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }
									</div>
								</div>
								<div class="w-20 aspect-[16/9] sm:w-24 shrink-0 overflow-hidden border border-[var(--c-bg)]/30 sm:border-[var(--c-border)] bg-[var(--c-bg)]/10 sm:bg-[var(--c-surface)]">
									@postThumbnailImg(p)
								</div>
							</a>
						}
					</div>
				</div>
			</div>

		</div>
	</div>
}
