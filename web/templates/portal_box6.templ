package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ portalBox6EssayBanner(ui i18n.UI, essaySec CategorySection, sidePosts []post.Post, lang string) {
	<div class="border-0 sm:border-x sm:border-b sm:border-[var(--c-border)] w-full mt-0 sm:mt-0 mb-0 bg-[var(--c-text)] text-[var(--c-bg)] sm:bg-[var(--c-bg)] sm:text-[var(--c-text)]">
		<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-bg)]/30 sm:divide-[var(--c-border)]">
			<div class="lg:col-span-7 px-5 sm:px-6 py-8 sm:py-8 lg:py-10 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between mb-5">
						<div class="text-xs sm:text-[13px] font-mono font-black uppercase tracking-widest text-[var(--c-bg)] sm:text-[var(--c-text)] flex items-center gap-1.5">
							@categoryMultiLinks(essaySec.Tag, lang, "hover:opacity-80 sm:hover:text-[var(--c-link)] transition-colors", "text-muted/60 select-none")
						</div>
						<span class="text-[11px] sm:text-xs font-mono font-bold text-[var(--c-bg)]/80 sm:text-[var(--c-muted)] uppercase tracking-wider">FEATURED ESSAY</span>
					</div>
					<article class="group mb-6 sm:mb-8">
						<div class="flex flex-col gap-3.5 sm:gap-4">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + essaySec.LeadPost.Slug) } class="w-full aspect-[16/9] bg-[var(--c-bg)]/10 sm:bg-[var(--c-surface)] overflow-hidden border border-[var(--c-bg)]/30 sm:border-[var(--c-border)] block">
								@postThumbnailImg(essaySec.LeadPost)
							</a>
							<div class="flex flex-col">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + essaySec.LeadPost.Slug) } class="block mb-2">
									<h3 class="display text-xl sm:text-2xl lg:text-[28px] font-extrabold text-[var(--c-bg)] sm:text-[var(--c-text)] opacity-100 group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-tight">
										{ essaySec.LeadPost.Title }
									</h3>
								</a>
								if essaySec.LeadPost.Description != "" {
									<p class="text-sm sm:text-base text-[var(--c-bg)]/85 sm:text-[var(--c-muted)] line-clamp-3 leading-relaxed mb-3">
										{ essaySec.LeadPost.Description }
									</p>
								}
								<div class="text-[11px] sm:text-xs font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-muted)] mt-1">
									<span>{ fmt.Sprintf("%d %s", essaySec.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</div>
						</div>
					</article>
				</div>
				if len(essaySec.SubPosts) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 mt-auto">
						for j, sub := range essaySec.SubPosts {
							if j < 2 {
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class="group block">
									<h4 class="display text-base sm:text-lg font-semibold text-[var(--c-bg)] sm:text-[var(--c-text)] group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-snug line-clamp-2 mb-1.5">
										{ sub.Title }
									</h4>
									<div class="text-xs font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-muted)]">
										<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</a>
							}
						}
					</div>
				}
			</div>
			<div class="lg:col-span-5 px-5 sm:px-6 py-8 sm:py-8 lg:py-10 flex flex-col justify-between bg-[var(--c-bg)]/5 sm:bg-[var(--c-surface)]/20">
				<div>
					<div class="flex items-center justify-between mb-5">
						<span class="text-sm font-mono font-black uppercase tracking-widest text-[var(--c-bg)] sm:text-[var(--c-text)]">
							POLICY & SYSTEMS SPOTLIGHT
						</span>
						<span class="text-xs font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-accent)]">DISPATCHES</span>
					</div>
					<div class="flex flex-col divide-y divide-[var(--c-bg)]/20 sm:divide-[var(--c-border)]/40">
						for _, p := range sidePosts {
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group py-4 first:pt-0 last:pb-0 flex items-start justify-between gap-4">
								<div class="flex-1 min-w-0">
									if len(p.Tags) > 0 {
										<span class="text-[var(--c-bg)]/80 sm:text-[var(--c-accent)] text-xs font-bold uppercase tracking-wider block mb-1">{ p.Tags[0] }</span>
									}
									<h4 class="display text-[16px] sm:text-[18px] font-semibold text-[var(--c-bg)] sm:text-[var(--c-text)] group-hover:opacity-80 sm:group-hover:opacity-100 sm:group-hover:text-[var(--c-link)] transition-colors leading-snug line-clamp-2">
										{ p.Title }
									</h4>
									<div class="text-xs font-mono text-[var(--c-bg)]/70 sm:text-[var(--c-muted)] mt-1.5">
										{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }
									</div>
								</div>
								<div class="w-32 aspect-[16/9] sm:w-40 lg:w-48 shrink-0 overflow-hidden border border-[var(--c-bg)]/30 sm:border-[var(--c-border)] bg-[var(--c-bg)]/10 sm:bg-[var(--c-surface)]">
									@postThumbnailImg(p)
								</div>
							</a>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
