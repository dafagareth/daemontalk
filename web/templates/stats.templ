package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

type StatsData struct {
	TotalPosts    int
	TotalWords    int
	TotalTags     int
	TotalViews    int
	TotalComments int
	LangEN        int
	LangID        int
	TopPages      []StatTopPage
}

type StatTopPage struct {
	Path  string
	Count int
}

func fmtNumber(n int) string {
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

templ StatsPage(ui i18n.UI, data StatsData) {
	<section class="container-page py-8 sm:py-12">
		<h1 class="display text-2xl sm:text-3xl font-semibold text-text mb-8">{ ui.Stats_Title }</h1>
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
			@statCard("Posts", fmtNumber(data.TotalPosts), "blog posts published")
			@statCard("Words", fmtNumber(data.TotalWords), "words written (est.)")
			@statCard("Tags", fmtNumber(data.TotalTags), "unique tags used")
			@statCard("Views", fmtNumber(data.TotalViews), "total page views")
			@statCard("Comments", fmtNumber(data.TotalComments), "comments received")
			@statCard("EN", fmtNumber(data.LangEN), "posts in English")
			@statCard("ID", fmtNumber(data.LangID), "posts in Indonesian")
		</div>
	</section>
}

templ statCard(label string, value string, description string) {
	<div class="border border-border rounded-none p-4 bg-surface">
		<p class="text-2xl font-mono font-semibold text-text tabular-nums">{ value }</p>
		<p class="text-xs font-semibold text-muted mt-0.5 uppercase tracking-wide">{ label }</p>
		<p class="text-xs text-muted mt-1 leading-snug">{ description }</p>
	</div>
}
