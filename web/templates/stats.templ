package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

type StatsData struct {
	TotalPosts    int
	TotalWords    int
	TotalTags     int
	TotalViews    int
	TotalComments int
	LangEN        int
	LangID        int
	TopPages      []StatTopPage
}

type StatTopPage struct {
	Path  string
	Count int
}

func fmtNumber(n int) string {
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

templ StatsPage(ui i18n.UI, data StatsData) {
	<section class="container-page py-12 sm:py-20 flex flex-col items-center justify-center min-h-[60vh]">
		<div class="w-full max-w-3xl flex flex-col font-mono">
			<!-- CLI Output Area -->
			<div class="text-text text-sm leading-loose w-full">
				<div class="flex flex-col gap-4 w-full uppercase">
					@statCliLine("Total Articles Published", fmtNumber(data.TotalPosts))
					@statCliLine("Total Words Written (Est.)", fmtNumber(data.TotalWords))
					@statCliLine("Unique System Tags Used", fmtNumber(data.TotalTags))
					
					<div class="my-4 border-b border-border/50 border-dashed"></div>
					
					@statCliLine("Total Raw Page Views", fmtNumber(data.TotalViews))
					@statCliLine("User Comments Received", fmtNumber(data.TotalComments))
					
					<div class="my-4 border-b border-border/50 border-dashed"></div>
					
					@statCliLine("EN Locale Documents", fmtNumber(data.LangEN))
					@statCliLine("ID Locale Documents", fmtNumber(data.LangID))
				</div>
				
				<div class="mt-16 text-center text-[10px] text-muted font-bold tracking-widest animate-pulse">
					[ EOF ]
				</div>
			</div>
		</div>
	</section>
}

templ statCliLine(label string, value string) {
	<div class="flex items-end w-full">
		<span class="shrink-0 font-bold text-muted">{ label }</span>
		<div class="flex-1 mx-3 mb-1 border-b-[3px] border-dotted border-border/70"></div>
		<span class="shrink-0 font-bold tracking-widest text-text">[ <span class="text-link">{ value }</span> ]</span>
	</div>
}
