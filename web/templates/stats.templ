package templates

import (
	"fmt"

	"daemontalk/internal/i18n"
)

type StatsData struct {
	TotalPosts    int
	TotalWords    int
	TotalTags     int
	TotalViews    int
	TotalComments int
	TotalTopics   int
	TotalReplies  int
	SolvedTopics  int
	TotalUsers    int
	TotalVotes    int
	LangEN        int
	LangID        int
	TopPages      []StatTopPage
}

type StatTopPage struct {
	Path  string
	Count int
}

func fmtNumber(n int) string {
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

templ StatsPage(ui i18n.UI, lang string, data StatsData) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-8 sm:mb-12">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors mb-3 group select-none font-sans font-medium"
			>
				@IconArrowLeft("w-3.5 h-3.5")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-4xl font-black text-text tracking-tight uppercase">
				{ ui.Stats_Title }
			</h1>
		</div>
		<div class="border-0 sm:border border-border bg-transparent sm:bg-surface/10 mb-10 sm:mb-14 sm:overflow-hidden font-sans">
			<div class="hidden sm:block">
				<div class="grid grid-cols-3 divide-x divide-border border-b border-border">
					@statKpiCard("PUBLICATION", fmtNumber(data.TotalPosts), ui.Stats_TotalArticles)
					@statKpiCard("VOLUME", fmtNumber(data.TotalWords), ui.Stats_TotalWords)
					@statKpiCard("AUDIENCE", fmtNumber(data.TotalViews), ui.Stats_PageViews)
				</div>
				<div class="grid grid-cols-3 divide-x divide-border border-b border-border">
					@statKpiCard("SOCKET", fmtNumber(data.TotalTopics), ui.Stats_Topics)
					@statKpiCard("RESOLUTION", fmtNumber(data.SolvedTopics), ui.Stats_Solved)
					@statKpiCard("MEMBERS", fmtNumber(data.TotalUsers), ui.Stats_Members)
				</div>
			</div>
			<div class="sm:hidden grid grid-cols-2 gap-x-6 gap-y-7 py-2 border-b border-border/40 pb-6">
				@statKpiCardMobile("PUBLICATION", fmtNumber(data.TotalPosts), ui.Stats_TotalArticles)
				@statKpiCardMobile("VOLUME", fmtNumber(data.TotalWords), ui.Stats_TotalWords)
				@statKpiCardMobile("AUDIENCE", fmtNumber(data.TotalViews), ui.Stats_PageViews)
				@statKpiCardMobile("SOCKET", fmtNumber(data.TotalTopics), ui.Stats_Topics)
				@statKpiCardMobile("RESOLUTION", fmtNumber(data.SolvedTopics), ui.Stats_Solved)
				@statKpiCardMobile("MEMBERS", fmtNumber(data.TotalUsers), ui.Stats_Members)
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 md:divide-x divide-border">
				<div class="py-6 px-0 sm:p-7 lg:p-8 flex flex-col justify-between">
					<div>
						<div class="pb-3 border-b border-border/60 flex items-center justify-between font-sans mb-4">
							<span class="font-bold text-text uppercase tracking-wider text-xs font-sans">
								if lang == "id" {
									METRIK KONTEN & KOMUNITAS
								} else {
									CONTENT & COMMUNITY BREAKDOWN
								}
							</span>
							<span class="text-[10px] text-muted uppercase font-bold tracking-wider font-sans">REAL-TIME</span>
						</div>
						<div class="space-y-3 font-sans">
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_Comments }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.TotalComments) }</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_Replies }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.TotalReplies) }</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_Votes }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.TotalVotes) }</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_SystemTags }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.TotalTags) }</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_LangID }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.LangID) }</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_LangEN }</span>
								<span class="font-semibold text-text tabular-nums">{ fmtNumber(data.LangEN) }</span>
							</div>
						</div>
					</div>
				</div>
				<div class="py-6 px-0 sm:p-7 lg:p-8 flex flex-col justify-between">
					<div>
						<div class="pb-3 border-b border-border/60 flex items-center justify-between font-sans mb-4">
							<span class="font-bold text-text uppercase tracking-wider text-xs font-sans">
								if lang == "id" {
									SPESIFIKASI INFRASTRUKTUR & MESIN
								} else {
									INFRASTRUCTURE & ENGINE SPECS
								}
							</span>
							<span class="text-[10px] text-link uppercase font-bold tracking-wider font-sans">SYSTEMS</span>
						</div>
						<div class="space-y-3 font-sans">
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_ServerArch }</span>
								<span class="font-semibold text-text text-right">Go Monolith (Static Binary)</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_DBStorage }</span>
								<span class="font-semibold text-text text-right">SQLite3 (WAL + FTS5)</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">{ ui.Stats_TemplateEngine }</span>
								<span class="font-semibold text-text text-right">A-H Templ + HTMX</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">
									if lang == "id" {
										Terminal TUI Server
									} else {
										Terminal TUI Server
									}
								</span>
								<span class="font-semibold text-text text-right">Charm Wish SSH (:2222)</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">
									if lang == "id" {
										Protokol Pengiriman
									} else {
										Delivery Protocol
									}
								</span>
								<span class="font-semibold text-text text-right">HTTP/2 + TLS 1.3 Strict</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-muted">
									if lang == "id" {
										Dependensi Runtime
									} else {
										External Daemons
									}
								</span>
								<span class="font-semibold text-emerald-500 text-right">0 (Zero External Deps)</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ statKpiCard(kicker string, value string, label string) {
	<div class="p-5 sm:p-6 lg:p-8 flex flex-col justify-between hover:bg-hover/30 transition-colors">
		<span class="text-[11px] uppercase tracking-wider text-muted font-bold font-sans">{ kicker }</span>
		<div class="mt-3">
			<div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-text tabular-nums font-sans">
				{ value }
			</div>
			<div class="text-xs sm:text-sm text-muted mt-1 font-sans">
				{ label }
			</div>
		</div>
	</div>
}

templ statKpiCardMobile(kicker string, value string, label string) {
	<div class="flex flex-col justify-between">
		<span class="text-[10px] uppercase tracking-wider text-muted font-bold font-sans">{ kicker }</span>
		<div class="mt-1.5">
			<div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text tabular-nums font-sans">
				{ value }
			</div>
			<div class="text-xs text-muted mt-0.5 font-sans leading-tight">
				{ label }
			</div>
		</div>
	</div>
}
