package templates

import (
	"daemontalk/internal/i18n"
	"fmt"
)

templ portalDeepDive(ui i18n.UI, categories []CategorySection, lang string) {
	<div class="border-0 sm:border-x sm:border-b border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="flex items-center justify-between px-5 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-2 bg-bg text-xs font-mono font-bold uppercase tracking-wider">
			<span class="text-text font-black tracking-widest text-sm sm:text-[15px]">
				DEEP DIVE SPOTLIGHT
			</span>
		</div>
		<div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none sm:grid sm:grid-cols-2 sm:divide-x divide-[var(--c-border)]">
			for idx, cat := range categories {
				<div
					class={
						"shrink-0 w-[85vw] max-w-[340px] sm:max-w-none sm:w-auto snap-center flex flex-col justify-between px-5 sm:px-6 pt-6 pb-8 sm:pt-6 sm:pb-9 lg:pt-8 lg:pb-12 lg:px-8 border-r border-border sm:border-r-0 last:border-r-0",
						templ.KV("sm:hidden", idx >= 2),
					}
				>
					<div>
						<div class="flex items-center justify-between mb-4 sm:mb-5">
							<div class="text-xs sm:text-[13px] font-mono font-black uppercase tracking-widest text-accent flex items-center gap-1.5">
								@categoryMultiLinks(cat.Tag, lang, "hover:underline", "text-muted/60 select-none")
							</div>
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-xs font-mono font-bold uppercase tracking-wider text-muted hover:text-link flex items-center gap-1 group/btn shrink-0">
								if lang == "id" {
									<span>Lihat Semua</span>
								} else {
									<span>See More</span>
								}
								@IconArrowRight("w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5")
							</a>
						</div>
						<article class="group/lead mb-6 sm:mb-8">
							<div class="flex flex-row-reverse sm:flex-row gap-4 sm:gap-6 items-start justify-between">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="w-28 xs:w-32 sm:w-48 lg:w-56 xl:w-60 aspect-[16/9] shrink-0 bg-surface overflow-hidden border border-border block">
									@postThumbnailImg(cat.LeadPost)
								</a>
								<div class="flex-1 min-w-0">
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block mb-1.5 sm:mb-2">
										<h3 class="display text-lg sm:text-xl lg:text-[22px] font-bold text-text group-hover/lead:text-link transition-colors leading-snug line-clamp-3 sm:line-clamp-none">
											{ cat.LeadPost.Title }
										</h3>
									</a>
									if cat.LeadPost.Description != "" {
										<p class="hidden sm:block text-sm text-muted line-clamp-2 leading-relaxed mb-3">
											{ cat.LeadPost.Description }
										</p>
									}
									<div class="flex items-center gap-2 text-[10px] sm:text-xs font-mono text-muted mt-auto pt-1 sm:pt-0">
										<time datetime={ cat.LeadPost.Date.Format("2006-01-02") }>{ fmtDate(cat.LeadPost, lang) }</time>
										<span>·</span>
										<span>{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</div>
							</div>
						</article>
					</div>
					if len(cat.SubPosts) > 0 {
						<div class="flex flex-col divide-y divide-border/40 mt-auto pt-1">
							for j, sub := range cat.SubPosts {
								if j < 2 {
									<article class="group/sub">
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class="flex items-start justify-between gap-4 sm:gap-6 py-4 sm:py-5">
											<div class="flex-1 min-w-0">
												<h4 class="display text-base sm:text-[17px] lg:text-lg font-bold text-text group-hover/sub:text-link transition-colors leading-snug line-clamp-2 sm:line-clamp-none">
													{ sub.Title }
												</h4>
												<div class="flex items-center gap-2 text-[10px] sm:text-xs font-mono text-muted mt-1.5 sm:mt-2.5">
													<time datetime={ sub.Date.Format("2006-01-02") }>{ fmtDate(sub, lang) }</time>
													<span>·</span>
													<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
												</div>
											</div>
											if sub.Cover != "" {
												<div class="w-24 xs:w-28 aspect-[16/9] sm:w-44 lg:w-48 xl:w-52 shrink-0 bg-surface overflow-hidden border border-border">
													@postThumbnailImg(sub)
												</div>
											}
										</a>
									</article>
								}
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}
