package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

templ portalDeepDive(ui i18n.UI, categories []CategorySection, lang string) {
	// BOX 3: DEEP DIVE SPOTLIGHT (6:6) - SEAMLESS WIREFRAME
	<div class="border-0 sm:border-x-2 sm:border-b-2 border-border w-full mb-0 sm:mb-0 bg-bg">
		// Mobile: Horizontal Swipe Carousel | Desktop: 2-Column Grid
		<div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none sm:grid sm:grid-cols-2 sm:divide-x divide-[var(--c-border)]">
			for _, cat := range categories {
				<article class="shrink-0 w-[85vw] sm:w-auto snap-center flex flex-col justify-between group border-r border-border sm:border-r-0 last:border-r-0">
					<div>
						// Image 16:9 flush edge-to-edge
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block relative aspect-[16/9] w-full bg-surface overflow-hidden border-b border-border">
							@postThumbnailImg(cat.LeadPost)
						</a>

						// Story Details
						<div class="px-5 sm:px-6 py-8 sm:py-10 lg:px-7 lg:py-12">
							<div class="flex items-center justify-between gap-2 mb-3">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-[10px] font-mono font-bold uppercase tracking-widest text-accent hover:underline">
									DEEP DIVE · { categoryTitle(cat, lang) }
								</a>
								<span class="text-[10px] font-mono text-muted">
									{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }
								</span>
							</div>

							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block mb-3">
								<h3 class="display text-xl sm:text-2xl font-extrabold text-text group-hover:text-link transition-colors leading-tight">
									{ cat.LeadPost.Title }
								</h3>
							</a>

							if cat.LeadPost.Description != "" {
								<p class="text-sm text-muted line-clamp-3 leading-relaxed mb-4">
									{ cat.LeadPost.Description }
								</p>
							}
						</div>
					</div>

					// Meta footer
					<div class="px-5 sm:px-6 lg:px-7 pb-5 sm:pb-6 flex items-center justify-between text-xs font-mono text-muted border-t border-border/30 pt-3">
						<span class="font-bold text-text">
							if cat.LeadPost.Author != "" {
								{ cat.LeadPost.Author }
							} else {
								daemontalk
							}
						</span>
						<time datetime={ cat.LeadPost.Date.Format("2006-01-02") }>{ fmtDate(cat.LeadPost) }</time>
					</div>
				</article>
			}
		</div>
	</div>
}
