package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ blogContent(ui i18n.UI, p post.Post) {
	if len(p.TOC) > 0 {
		<div id="mobile-toc" class="xl:hidden mb-8 border border-border bg-surface p-4 sm:p-5 scroll-mt-28 select-none font-sans">
			<details class="group">
				<summary class="text-xs font-mono font-bold uppercase tracking-wider text-text cursor-pointer list-none flex items-center justify-between">
					<span class="flex items-center gap-2">
						<span class="text-link font-black">❯</span>
						<span class="font-mono">{ ui.Post_TOC }</span>
						<span class="text-[10px] font-normal text-muted font-mono">({ fmt.Sprintf("%d sections", len(p.TOC)) })</span>
					</span>
					@IconChevronDown("toc-chevron w-4 h-4 text-muted transition-transform group-open:rotate-180")
				</summary>
				<nav class="mt-4 pt-3 border-t border-border/60">
					@tocList(p.TOC)
				</nav>
			</details>
		</div>
	}
	<div id="prose-body" class="prose md:prose-lg max-w-none leading-relaxed prose-serif">
		@templ.Raw(string(p.Body))
	</div>
}
