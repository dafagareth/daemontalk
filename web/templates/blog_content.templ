package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ blogContent(ui i18n.UI, p post.Post) {
	<!-- Mobile & Tablet Table of Contents (Hidden on xl screens where right rail is visible) -->
	if len(p.TOC) > 0 {
		<div class="xl:hidden mb-8 pb-4 border-b border-border/60">
			<details class="group">
				<summary class="text-xs font-mono font-bold uppercase tracking-wider text-text cursor-pointer select-none list-none flex items-center justify-between py-2">
					<span class="flex items-center gap-2">
						<span>{ ui.Post_TOC }</span>
						<span class="text-[10px] font-normal text-muted">({ fmt.Sprintf("%d sections", len(p.TOC)) })</span>
					</span>
					@IconChevronDown("toc-chevron w-4 h-4 text-muted transition-transform group-open:rotate-180")
				</summary>
				<nav class="mt-3 pt-2 pl-2">
					@tocList(p.TOC)
				</nav>
			</details>
		</div>
	}

	<!-- Main Prose Reading Body (Dynamic Serif / Sans, Default to Serif) -->
	<div id="prose-body" class="prose md:prose-lg max-w-none leading-relaxed prose-serif">
		@templ.Raw(string(p.Body))
	</div>
}
