package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ portalStrictLeadStory(ui i18n.UI, p post.Post, lang string, hideTag bool) {
	<article class="group">
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block relative aspect-[16/9] w-full bg-surface mb-5 overflow-hidden">
			@postThumbnailImg(p)
		</a>
		if !hideTag && len(p.Tags) > 0 {
			<span class="text-accent text-xs font-bold uppercase tracking-wider mb-2 block">{ p.Tags[0] }</span>
		}
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } data-slug={ p.Slug } class="block mb-3">
			<h2 class="display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text group-hover:text-link transition-colors leading-[1.1] tracking-tight">
				{ p.Title }
			</h2>
		</a>
		if p.Description != "" {
			<p class="text-sm sm:text-base text-muted line-clamp-2 leading-relaxed mb-4">
				{ p.Description }
			</p>
		}
		<div class="flex items-center gap-2 text-xs font-sans text-muted mt-4">
			<span class="font-bold text-text">
				if p.Author != "" {
					{ p.Author }
				} else {
					daemontalk team
				}
			</span>
			<span>·</span>
			<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
		</div>
	</article>
}

templ portalResponsiveTagSubStory(ui i18n.UI, p post.Post, lang string) {
	<article class="group flex flex-row lg:flex-col gap-4 lg:gap-0 items-start lg:items-stretch h-full">
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block relative w-24 sm:w-32 lg:w-full lg:h-auto aspect-[16/9] bg-surface shrink-0 lg:mb-4 overflow-hidden">
			@postThumbnailImg(p)
		</a>
		<div class="flex-1 min-w-0 flex flex-col justify-center lg:justify-start">
			<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } data-slug={ p.Slug } class="block mb-1 lg:mb-2">
				<h3 class="display text-sm sm:text-base lg:text-xl sm:lg:text-2xl font-extrabold text-text group-hover:text-link transition-colors leading-tight tracking-tight line-clamp-3">
					{ p.Title }
				</h3>
			</a>
			<div class="flex flex-wrap items-center gap-1 sm:gap-2 mb-1 sm:mb-2 text-[10px] sm:text-xs font-sans text-muted uppercase tracking-wider">
				<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p, lang) }</time>
				<span class="hidden sm:inline">·</span>
				<span class="hidden sm:inline">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>
			if p.Description != "" {
				<p class="hidden lg:line-clamp-2 text-sm text-muted leading-relaxed mb-4">
					{ p.Description }
				</p>
			}
		</div>
	</article>
}
