package templates

templ graphShortcutsModal(lang string) {
	<div
		id="graph-shortcuts-modal"
		class="shortcuts-overlay"
		onclick="if(event.target===this)this.classList.remove('open')"
	>
		<div class="shortcuts-modal !max-w-[480px] font-sans">
			<div class="flex items-center justify-between mb-4 border-b border-border pb-3">
				<div class="flex items-center gap-2">
					<h3 class="text-sm font-bold font-sans uppercase tracking-wider text-text">
						if lang == "id" {
							{ "Pintasan Keyboard Graph" }
						} else {
							{ "Graph Keyboard Shortcuts" }
						}
					</h3>
				</div>
				<button
					type="button"
					onclick="document.getElementById('graph-shortcuts-modal').classList.remove('open')"
					class="w-7 h-7 flex items-center justify-center text-muted hover:text-text hover:bg-hover text-sm font-sans border border-border cursor-pointer transition-colors"
				>×</button>
			</div>
			<div class="space-y-4 max-h-[70vh] overflow-y-auto pr-1 text-xs font-sans">
				<div>
					<p class="text-[10px] uppercase font-sans font-bold text-muted/70 mb-2 tracking-wider">
						if lang == "id" {
							{ "Navigasi & Seleksi" }
						} else {
							{ "Navigation & Selection" }
						}
					</p>
					<div class="space-y-2">
						if lang == "id" {
							@shortcutRow("j / ↓", "Pilih simpul berikutnya di daftar")
							@shortcutRow("k / ↑", "Pilih simpul sebelumnya di daftar")
							@shortcutRow("Enter / o", "Buka artikel / jelajahi domain")
							@shortcutRow("Home / End", "Lompat ke awal / akhir daftar")
							@shortcutRow("Esc", "Batal pilih simpul / tutup pencarian")
						} else {
							@shortcutRow("j / ↓", "Select next node in list")
							@shortcutRow("k / ↑", "Select previous node in list")
							@shortcutRow("Enter / o", "Open dispatch / explore domain")
							@shortcutRow("Home / End", "Jump to first / last node in list")
							@shortcutRow("Esc", "Deselect node / close search")
						}
					</div>
				</div>
				<div>
					<p class="text-[10px] uppercase font-sans font-bold text-muted/70 mb-2 tracking-wider">
						if lang == "id" {
							{ "Filter & Pencarian" }
						} else {
							{ "Filter & Search" }
						}
					</p>
					<div class="space-y-2">
						if lang == "id" {
							@shortcutRow("/", "Fokus ke input pencarian simpul")
							@shortcutRow("1 / a", "Tampilkan semua simpul (semua)")
							@shortcutRow("2 / p", "Filter hanya artikel (artikel)")
							@shortcutRow("3 / d", "Filter hanya domain (#tags)")
						} else {
							@shortcutRow("/", "Focus node search input")
							@shortcutRow("1 / a", "Show all nodes")
							@shortcutRow("2 / p", "Filter dispatches only")
							@shortcutRow("3 / d", "Filter domains only (#tags)")
						}
					</div>
				</div>
				<div>
					<p class="text-[10px] uppercase font-sans font-bold text-muted/70 mb-2 tracking-wider">
						if lang == "id" {
							{ "Kanvas & Kamera" }
						} else {
							{ "Canvas & Camera" }
						}
					</p>
					<div class="space-y-2">
						if lang == "id" {
							@shortcutRow("+ / =", "Perbesar kanvas (Zoom In)")
							@shortcutRow("- / _", "Perkecil kanvas (Zoom Out)")
							@shortcutRow("0 / r", "Reset kamera ke tengah kanvas")
							@shortcutRow("f", "Fokuskan kamera ke simpul aktif")
							@shortcutRow("← / →", "Geser kanvas horizontal")
							@shortcutRow("Drag", "Pan kanvas / seret posisi simpul")
							@shortcutRow("Wheel", "Zoom kanvas ke posisi kursor")
							@shortcutRow("Dbl Click", "Reset kamera / fokus simpul")
						} else {
							@shortcutRow("+ / =", "Zoom In canvas")
							@shortcutRow("- / _", "Zoom Out canvas")
							@shortcutRow("0 / r", "Reset camera view")
							@shortcutRow("f", "Focus camera on active node")
							@shortcutRow("← / →", "Pan canvas horizontally")
							@shortcutRow("Drag", "Pan canvas / fling node")
							@shortcutRow("Wheel", "Zoom canvas toward cursor")
							@shortcutRow("Dbl Click", "Reset camera / focus node")
						}
					</div>
				</div>
				<div>
					<p class="text-[10px] uppercase font-sans font-bold text-muted/70 mb-2 tracking-wider">
						if lang == "id" {
							{ "Navigasi Global" }
						} else {
							{ "Global Navigation" }
						}
					</p>
					<div class="space-y-2">
						if lang == "id" {
							@shortcutRow("g h", "Buka Beranda")
							@shortcutRow("g s", "Buka Socket")
							@shortcutRow("g b", "Buka Blog")
							@shortcutRow("g g", "Buka Knowledge Graph")
							@shortcutRow("?", "Buka / tutup bantuan ini")
						} else {
							@shortcutRow("g h", "Go to Home")
							@shortcutRow("g s", "Go to Socket")
							@shortcutRow("g b", "Go to Blog")
							@shortcutRow("g g", "Go to Knowledge Graph")
							@shortcutRow("?", "Toggle this shortcuts help")
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
