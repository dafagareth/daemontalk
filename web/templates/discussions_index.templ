package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsIndexPage(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	topics []*forum.Topic,
	selectedTag string,
	sortOrder string,
	searchQuery string,
	author string,
	totalCount int,
	page int,
	totalPages int,
) {
	<section class="container-page py-6 sm:py-10 min-h-[75vh]">
		<div class="border-0 sm:border sm:border-muted/30 bg-transparent sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden font-sans">
			<!-- Terminal Command & Action: The ONLY boxed element on mobile -->
			<div class="border border-muted/30 bg-surface sm:border-0 sm:border-b sm:border-muted/30 px-4 py-3 sm:px-6 sm:py-3.5 flex items-center justify-between gap-3 text-xs sm:text-sm font-mono select-none mb-5 sm:mb-0">
				<div class="flex items-center gap-2 sm:gap-3 text-text font-bold min-w-0">
					<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
					<code class="text-xs sm:text-sm font-mono truncate">nc -l /dev/socket</code>
					<span class="text-[10px] sm:text-[11px] font-mono text-muted font-normal bg-chip px-1.5 py-0.5 border border-muted/30 shrink-0">
						if author != "" {
							{ fmt.Sprintf("@%s (%d)", author, totalCount) }
						} else if searchQuery != "" {
							{ fmt.Sprintf("\"%s\" (%d)", searchQuery, totalCount) }
						} else if selectedTag != "" {
							{ fmt.Sprintf("#%s (%d)", selectedTag, totalCount) }
						} else {
							{ fmt.Sprintf("%d", totalCount) }
						}
					</span>
				</div>
				<!-- + New Discussion button -->
				<a
					href={ templ.SafeURL(prefix(lang) + "/socket/new") }
					class="inline-flex items-center gap-1 px-3 py-1.5 bg-[var(--c-text)] text-[var(--c-bg)] hover:opacity-90 font-mono font-bold text-xs uppercase tracking-wider transition-all shrink-0"
				>
					<span>+</span>
					<span>{ ui.Discussions_New }</span>
				</a>
			</div>

			if selectedTag != "" {
				<div class="border-b border-muted/30 bg-surface/30 px-4 sm:px-6 py-2.5 flex items-center justify-between text-xs font-mono select-none mb-4 sm:mb-0">
					<div class="flex items-center gap-2">
						<span class="text-muted uppercase">Tag:</span>
						<span class="text-accent font-bold font-mono">#{ selectedTag }</span>
						<span class="text-muted/40">·</span>
						<span class="text-muted">{ fmt.Sprintf("%d topics", totalCount) }</span>
					</div>
					<a
						href={ templ.SafeURL(prefix(lang) + "/socket") }
						class="text-muted hover:text-text hover:underline flex items-center gap-1 text-[11px]"
					>
						<span>✕</span>
						<span>
							if lang == "id" {
								Hapus filter
							} else {
								Clear filter
							}
						</span>
					</a>
				</div>
			}

			if len(topics) == 0 {
				<div class="p-12 text-center font-mono">
					<p class="text-sm font-bold text-text mb-1">No Topics Found</p>
					<p class="text-xs text-muted mb-4">Start the first topic or ask an architectural question.</p>
					<a
						href={ templ.SafeURL(prefix(lang) + "/socket/new") }
						class="inline-flex items-center gap-1 text-xs font-mono text-link hover:underline font-bold"
					>
						<span>+ Start New Topic</span>
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
			} else {
				<div class="divide-y divide-muted/25 sm:divide-muted/30">
					for _, t := range topics {
						<div class={
							"py-5 px-1.5 sm:px-6 sm:py-4 flex items-start sm:items-center justify-between gap-4 sm:gap-5 transition-all group",
							templ.KV("border-l-4 border-l-emerald-500 bg-emerald-500/[0.03] hover:bg-emerald-500/[0.07]", t.IsSolved),
							templ.KV("border-l-4 border-l-transparent hover:bg-hover", !t.IsSolved),
						}>
							<div class="flex items-start gap-3.5 sm:gap-4 min-w-0 flex-1">
								<div class="shrink-0 pt-0.5 sm:pt-0">
									@DiscussionsVoteButton("topic", t.ID, t.VotesCount, t.UserVoted)
								</div>
								<div class="min-w-0 flex-1 space-y-1.5">
									<a
										href={ templ.SafeURL(prefix(lang) + "/socket/" + t.Slug) }
										class="font-bold text-base leading-snug transition-colors break-words block text-text group-hover:text-link"
									>
										{ t.Title }
									</a>
									<div class="flex items-center gap-2 text-xs font-mono text-muted flex-wrap pt-0.5">
										if len(t.Tags) > 0 {
											for _, tag := range t.Tags {
												<a
													href={ templ.SafeURL(fmt.Sprintf("%s/socket?tag=%s", prefix(lang), tag)) }
													class="text-accent hover:underline font-mono text-xs font-bold mr-1"
												>
													{ "#" + tag }
												</a>
											}
											<span class="text-muted/40">·</span>
										}
										if t.AuthorUsername != "" && t.AuthorUsername != "ghost" {
											<span class="text-text font-medium">{ "@" + t.AuthorUsername }</span>
											<span class="text-muted/40">·</span>
										} else if t.AuthorName != "" {
											<span class="text-text font-medium">{ t.AuthorName }</span>
											<span class="text-muted/40">·</span>
										}
										<time datetime={ t.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">
											{ timeAgoOrDate(t.CreatedAt, lang) }
										</time>
										<span class="sm:hidden text-muted/40">·</span>
										<span class="sm:hidden font-medium text-text">
											if lang == "id" {
												{ fmt.Sprintf("%d balasan", t.RepliesCount) }
											} else {
												{ fmt.Sprintf("%d replies", t.RepliesCount) }
											}
										</span>
									</div>
								</div>
							</div>
							<div class="shrink-0 hidden sm:flex items-center gap-3 text-xs font-mono text-muted text-right">
								<span class="text-text font-medium">
									if lang == "id" {
										{ fmt.Sprintf("%d balasan", t.RepliesCount) }
									} else {
										{ fmt.Sprintf("%d replies", t.RepliesCount) }
									}
								</span>
								<span class="text-muted/40">·</span>
								<span>{ fmt.Sprintf("%d views", t.ViewsCount) }</span>
							</div>
						</div>
					}
				</div>
			}
			if totalPages > 1 {
				<div class="border-t border-muted/30 bg-surface px-5 sm:px-7 py-3 flex items-center justify-between text-xs font-mono text-muted select-none">
					if page > 1 {
						<a
							href={ templ.SafeURL(getPageURL(prefix(lang), selectedTag, page-1)) }
							class="inline-flex items-center gap-1 text-link hover:underline font-bold"
						>
							@IconArrowLeft("w-3.5 h-3.5")
							<span>PREV</span>
						</a>
					} else {
						<div></div>
					}
					<span>{ fmt.Sprintf("PAGE %d / %d", page, totalPages) }</span>
					if page < totalPages {
						<a
							href={ templ.SafeURL(getPageURL(prefix(lang), selectedTag, page+1)) }
							class="inline-flex items-center gap-1 text-link hover:underline font-bold"
						>
							<span>NEXT</span>
							@IconArrowRight("w-3.5 h-3.5")
						</a>
					}
				</div>
			}
		</div>
	</section>
}

func getPageURL(prefixStr, tag string, p int) string {
	if tag != "" {
		return fmt.Sprintf("%s/socket?tag=%s&p=%d", prefixStr, tag, p)
	}
	return fmt.Sprintf("%s/socket?p=%d", prefixStr, p)
}
