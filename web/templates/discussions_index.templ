package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsIndexPage(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	topics []*forum.Topic,
	categories []forum.Category,
	selectedCategory string,
	sortOrder string,
	searchQuery string,
	author string,
	totalCount int,
	page int,
	totalPages int,
) {
	<section class="container-page py-6 sm:py-10 min-h-[75vh]">
		<div class="border border-border bg-surface/20 shadow-xl overflow-hidden font-sans">
			<!-- Terminal Command & Filter Header -->
			<div class="border-b border-border bg-surface px-4 py-3 sm:px-6 sm:py-3.5 flex items-center justify-between gap-3 text-xs sm:text-sm font-mono select-none">
				<div class="flex items-center gap-2 sm:gap-3 text-text font-bold min-w-0">
					<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
					<code class="text-xs sm:text-sm font-mono truncate">nc -l /dev/socket</code>
					<span class="text-[10px] sm:text-[11px] font-mono text-muted font-normal bg-chip px-1.5 py-0.5 border border-border/60 shrink-0">
						if author != "" {
							{ fmt.Sprintf("@%s (%d)", author, totalCount) }
						} else if searchQuery != "" {
							{ fmt.Sprintf("\"%s\" (%d)", searchQuery, totalCount) }
						} else {
							{ fmt.Sprintf("%d", totalCount) }
						}
					</span>
				</div>
				<div class="flex items-center gap-3 sm:gap-4 shrink-0 text-xs font-mono">
					<div class="flex items-center gap-2 sm:gap-3 text-xs font-mono">
						<a
							href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s&sort=latest", prefix(lang), selectedCategory)) }
							class={ "transition-colors uppercase font-bold", templ.KV("text-link", sortOrder == "latest" || sortOrder == ""), templ.KV("text-muted hover:text-text", sortOrder != "latest" && sortOrder != "") }
						>
							latest
						</a>
						<span class="text-muted/40">·</span>
						<a
							href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s&sort=votes", prefix(lang), selectedCategory)) }
							class={ "transition-colors uppercase font-bold", templ.KV("text-link", sortOrder == "votes"), templ.KV("text-muted hover:text-text", sortOrder != "votes") }
						>
							votes
						</a>
						<span class="text-muted/40">·</span>
						<a
							href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s&sort=views", prefix(lang), selectedCategory)) }
							class={ "transition-colors uppercase font-bold", templ.KV("text-link", sortOrder == "views"), templ.KV("text-muted hover:text-text", sortOrder != "views") }
						>
							views
						</a>
					</div>
					<a
						href={ templ.SafeURL(prefix(lang) + "/socket/new" + getCategoryQuery(selectedCategory)) }
						class="inline-flex items-center gap-1 px-2.5 py-1 sm:px-3 sm:py-1.5 bg-[var(--c-text)] text-[var(--c-bg)] hover:opacity-90 font-mono font-bold text-xs uppercase tracking-wider transition-all shrink-0"
					>
						<span>+</span>
						<span>{ ui.Discussions_New }</span>
					</a>
				</div>
			</div>
			<!-- Category Bar -->
			<div class="border-b border-border/70 bg-surface/30 px-4 sm:px-6 py-2.5 flex items-center gap-3 sm:gap-4 overflow-x-auto scrollbar-none text-xs font-mono select-none">
				<a
					href={ templ.SafeURL(prefix(lang) + "/socket" + getSortQuery(sortOrder)) }
					class={ "transition-colors uppercase font-bold whitespace-nowrap shrink-0", templ.KV("text-link underline underline-offset-4 decoration-2", selectedCategory == "" || selectedCategory == "all"), templ.KV("text-muted hover:text-text", selectedCategory != "" && selectedCategory != "all") }
				>
					#all
				</a>
				for _, c := range categories {
					if c.Slug != "all" {
						<a
							href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s%s", prefix(lang), c.Slug, getSortQueryParam(sortOrder))) }
							class={ "transition-colors uppercase font-bold whitespace-nowrap shrink-0", templ.KV("text-link underline underline-offset-4 decoration-2", selectedCategory == c.Slug), templ.KV("text-muted hover:text-text", selectedCategory != c.Slug) }
						>
							#{ c.Slug }
						</a>
					}
				}
			</div>
			if len(topics) == 0 {
				<div class="p-12 text-center font-mono">
					<p class="text-sm font-bold text-text mb-1">No Topics Found</p>
					<p class="text-xs text-muted mb-4">Start the first topic or ask an architectural question.</p>
					<a
						href={ templ.SafeURL(prefix(lang) + "/socket/new?category=" + selectedCategory) }
						class="inline-flex items-center gap-1 text-xs font-mono text-link hover:underline font-bold"
					>
						<span>+ Start New Topic</span>
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
			} else {
				<div class="divide-y divide-border">
					for _, t := range topics {
						<div class={
							"px-4 py-3.5 sm:px-6 sm:py-4 flex items-center justify-between gap-3 sm:gap-5 transition-all group",
							templ.KV("border-l-4 border-l-emerald-500 bg-emerald-500/[0.03] hover:bg-emerald-500/[0.07]", t.IsSolved),
							templ.KV("border-l-4 border-l-transparent hover:bg-hover", !t.IsSolved),
						}>
							<div class="flex items-start gap-3 sm:gap-4 min-w-0 flex-1">
								<div class="shrink-0 pt-0.5">
									@DiscussionsVoteButton("topic", t.ID, t.VotesCount, t.UserVoted)
								</div>
								<div class="min-w-0 flex-1 space-y-1">
									<a
										href={ templ.SafeURL(prefix(lang) + "/socket/" + t.Slug) }
										class={
											"font-bold text-sm sm:text-base leading-snug transition-colors break-words block",
											templ.KV("text-text group-hover:text-emerald-400", t.IsSolved),
											templ.KV("text-text group-hover:text-link", !t.IsSolved),
										}
									>
										{ t.Title }
									</a>
									<div class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-mono text-muted flex-wrap">
										@DiscussionsCategoryBadge(t.Category)
										<span>·</span>
										if t.AuthorUsername != "" && t.AuthorUsername != "ghost" {
											<span class="text-text font-medium">{ "@" + t.AuthorUsername }</span>
											<span>·</span>
										} else if t.AuthorName != "" {
											<span class="text-text font-medium">{ t.AuthorName }</span>
											<span>·</span>
										}
										<time datetime={ t.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">
											{ timeAgoOrDate(t.CreatedAt, lang) }
										</time>
										<span class="sm:hidden">·</span>
										<span class="sm:hidden font-semibold text-text">
											if lang == "id" {
												{ fmt.Sprintf("%d balasan", t.RepliesCount) }
											} else {
												{ fmt.Sprintf("%d replies", t.RepliesCount) }
											}
										</span>
									</div>
								</div>
							</div>
							<div class="shrink-0 hidden sm:flex items-center gap-3 text-xs font-mono text-muted text-right">
								<span class={ templ.KV("text-emerald-400 font-bold", t.IsSolved && t.RepliesCount > 0), templ.KV("text-text font-medium", !t.IsSolved && t.RepliesCount > 0) }>
									if lang == "id" {
										{ fmt.Sprintf("%d balasan", t.RepliesCount) }
									} else {
										{ fmt.Sprintf("%d replies", t.RepliesCount) }
									}
								</span>
								<span class="text-muted/40">·</span>
								<span>{ fmt.Sprintf("%d views", t.ViewsCount) }</span>
							</div>
						</div>
					}
				</div>
			}
			if totalPages > 1 {
					<div class="border-t border-border bg-surface px-5 sm:px-7 py-3 flex items-center justify-between text-xs font-mono text-muted select-none">
						if page > 1 {
							<a
								href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s&sort=%s&p=%d", prefix(lang), selectedCategory, sortOrder, page-1)) }
								class="inline-flex items-center gap-1 text-link hover:underline font-bold"
							>
								@IconArrowLeft("w-3.5 h-3.5")
								<span>PREV</span>
							</a>
						} else {
							<div></div>
						}
						<span>{ fmt.Sprintf("PAGE %d / %d", page, totalPages) }</span>
						if page < totalPages {
							<a
								href={ templ.SafeURL(fmt.Sprintf("%s/socket?category=%s&sort=%s&p=%d", prefix(lang), selectedCategory, sortOrder, page+1)) }
								class="inline-flex items-center gap-1 text-link hover:underline font-bold"
							>
								<span>NEXT</span>
								@IconArrowRight("w-3.5 h-3.5")
							</a>
						}
					</div>
				}
		</div>
	</section>
}

func getCategoryQuery(cat string) string {
	if cat != "" {
		return "?category=" + cat
	}
	return ""
}

func getSortQuery(sort string) string {
	if sort != "" {
		return "?sort=" + sort
	}
	return ""
}

func getSortQueryParam(sort string) string {
	if sort != "" {
		return "&sort=" + sort
	}
	return ""
}
