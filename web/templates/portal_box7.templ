package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

templ portalBox7KnowledgeIndex(ui i18n.UI, categories []CategorySection, lang string) {
	// Box 8
	<div class="border-0 sm:border-x sm:border-b border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
			for i, cat := range categories {
				<div class={
					"flex flex-col px-5 sm:px-6 py-8 sm:py-9 lg:py-12 lg:px-7 border-[var(--c-border)]",
					templ.KV("border-b", i < len(categories)-1),
					templ.KV("md:border-b-0", i >= 2),
					templ.KV("lg:border-b-0", true),
					templ.KV("md:border-r", i%2 == 0),
					templ.KV("lg:border-r", i < 3),
				}>
					<div>
						// Header
						<div class="flex items-center justify-between mb-4 sm:mb-5">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-xs font-mono font-black uppercase tracking-widest text-text hover:text-link">
								{ categoryTitle(cat, lang) }
							</a>
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted hover:text-link flex items-center gap-1 group shrink-0" aria-label="Explore topic">
								@IconArrowRight("w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5")
							</a>
						</div>

						// Posts List (Teks Only)
						<div class="flex flex-col divide-y divide-border/40">
							<article class="group">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block pb-4 sm:pb-5 text-text visited:text-visited">
									<h4 class="display text-[17px] font-bold group-hover:text-link transition-colors leading-snug line-clamp-2 mb-1.5">
										{ cat.LeadPost.Title }
									</h4>
									<div class="text-[11px] font-mono text-muted">
										<span>{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
									</div>
								</a>
							</article>
							for j, sub := range cat.SubPosts {
								if j < 3 {
									<article class="group">
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class="block py-4 sm:py-5 text-muted visited:text-visited">
											<h4 class="display text-[15px] font-medium group-hover:text-text transition-colors leading-snug line-clamp-2 mb-1.5">
												{ sub.Title }
											</h4>
											<div class="text-[11px] font-mono text-muted/80">
												<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
											</div>
										</a>
									</article>
								}
							}
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}
