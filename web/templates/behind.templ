package templates

import (
	"fmt"
	"daemontalk/internal/github"
	"daemontalk/internal/i18n"
	"daemontalk/internal/project"
)

templ Behind(ui i18n.UI, lang string, projects []project.Project, ghStats github.Stats) {
	<div class="container-page py-8 sm:py-12">
		<div class="max-w-5xl">
		<!-- Hero -->
		<div class="mb-14">
			<p class="text-[13px] font-mono text-link mb-3 tracking-widest uppercase">{ ui.Behind_Title }</p>
			<h1 class="display text-3xl sm:text-4xl font-semibold text-text mb-4 leading-tight">daemontalk</h1>
			<div class="inline-flex items-center gap-2 mb-4 px-3 py-1.5 rounded-none bg-[var(--c-ok-bg)] border border-[var(--c-ok)]/30">
				<span class="text-xs font-medium text-[var(--c-ok)]">Open to internship</span>
			</div>
			<p class="text-base text-muted leading-relaxed max-w-2xl mb-6">
				{ ui.About_Intro }
			</p>
			<!-- Social row -->
			<div class="flex flex-wrap items-center gap-3">
				<a href="mailto:realdaemontalk@gmail.com" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-text transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
					realdaemontalk@gmail.com
				</a>
				<span class="text-[var(--c-border)]">·</span>
				<a href="https://github.com/dafagareth/daemontalk" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-text transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
					github.com/dafagareth
				</a>
				<span class="text-[var(--c-border)]">·</span>
				<a href={ templ.SafeURL(prefix(lang) + "/resume") } class="inline-flex items-center gap-1.5 text-sm text-link hover:underline transition-colors">
					<span>View Resume</span>
					@iconArrowRight()
				</a>
			</div>
		</div>

		<!-- What I'm building -->
		<section id="projects" class="mb-14">
			<h2 class="text-lg font-semibold text-text mb-5">{ ui.About_Building }</h2>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				for _, p := range projects {
					@ProjectCard(p, lang)
				}
			</div>
		</section>

		<!-- GitHub stats (pindahan dari home) -->
		if ghStats.Login != "" {
			@githubStats(ghStats)
		}

		<!-- Languages & OS -->
		<section class="mb-14">
			<h2 class="text-lg font-semibold text-text mb-4">Languages &amp; OS</h2>
			<div class="flex flex-wrap gap-2 items-center">
				<span class="text-xs px-2.5 py-1 bg-chip text-text font-mono border border-border">Go</span>
				<span class="text-xs px-2.5 py-1 bg-chip text-text font-mono border border-border">SQL</span>
				<span class="text-xs px-2.5 py-1 bg-chip text-text font-mono border border-border">Bash</span>
				<span class="text-xs px-2.5 py-1 bg-chip text-muted font-mono border border-border/60">C &amp; Rust (Roadmap)</span>
				<span class="text-xs px-2.5 py-1 bg-surface text-link font-mono border border-border font-medium">Arch Linux (i use arch btw)</span>
			</div>
		</section>

		<!-- Contact -->
		<section class="max-w-lg">
			<h2 class="text-lg font-semibold text-text mb-5">{ ui.About_Contact }</h2>
			<p class="text-sm text-muted mb-5 leading-relaxed">
				Open to interesting projects, collaborations, or just a good technical conversation. Response time is usually within 24 hours.
			</p>
			<form
				class="flex flex-col gap-3 max-w-lg"
				hx-post="/contact"
				hx-target="#contact-result"
				hx-swap="innerHTML"
				hx-disabled-elt="find button[type='submit']"
				hx-on::after-request="if(event.detail.successful && event.detail.xhr.status===200 && document.getElementById('contact-result').textContent.trim()[0] !== '!') this.reset()"
			>
				<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true"/>
				<input
					type="text"
					name="name"
					required
					maxlength="100"
					placeholder={ ui.Contact_NameLabel }
					class="w-full px-3 py-2 text-sm rounded-none border border-border bg-surface text-text placeholder:text-muted focus:outline-none focus:border-[var(--c-link)] transition-colors"
				/>
				<input
					type="email"
					name="email"
					required
					maxlength="200"
					placeholder={ ui.Contact_EmailLabel }
					class="w-full px-3 py-2 text-sm rounded-none border border-border bg-surface text-text placeholder:text-muted focus:outline-none focus:border-[var(--c-link)] transition-colors"
				/>
				<textarea
					name="message"
					required
					maxlength="3000"
					rows="4"
					placeholder={ ui.Contact_MessageLabel }
					class="w-full px-3 py-2 text-sm rounded-none border border-border bg-surface text-text placeholder:text-muted focus:outline-none focus:border-[var(--c-link)] transition-colors resize-y"
				></textarea>
				<div>
					<button
						type="submit"
						class="inline-flex items-center gap-2 text-sm px-4 py-2 rounded-none bg-[var(--c-link)] text-white font-medium hover:brightness-110 transition-all disabled:opacity-60 disabled:cursor-not-allowed"
					>
						<span class="htmx-indicator spinner"></span>
						{ ui.Contact_Submit }
					</button>
				</div>
			</form>
			<div id="contact-result" class="mt-3 text-sm"></div>
			<p class="text-sm text-muted mt-6">
				<a href={ templ.SafeURL(prefix(lang) + "/guestbook") } class="inline-flex items-center gap-1 text-link hover:underline">
					<span>Guestbook</span>
					@iconArrowRight()
				</a>
			</p>
		</section>
		</div>
	</div>
}

templ githubStats(stats github.Stats) {
	<section class="py-8">
		<div class="flex items-center gap-3 mb-4">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
			<h2 class="text-lg font-semibold text-text">Open Source</h2>
			<a href={ templ.SafeURL("https://github.com/" + stats.Login) } target="_blank" rel="noopener" class="text-sm text-link hover:underline font-mono">{ "@" + stats.Login }</a>
		</div>
		<div class="flex gap-4 mb-5 text-sm text-muted">
			<span><span class="font-medium text-text">{ fmt.Sprintf("%d", stats.Followers) }</span> followers</span>
			<span><span class="font-medium text-text">{ fmt.Sprintf("%d", stats.PublicRepos) }</span> repos</span>
			if stats.TotalContribs > 0 {
				<span><span class="font-medium text-text">{ fmt.Sprintf("%d", stats.TotalContribs) }</span> contributions this year</span>
			}
		</div>
		if len(stats.Contributions) > 0 {
			<div class="mb-6 overflow-x-auto">
				<div class="inline-flex gap-[3px] min-w-0">
					for _, week := range stats.Contributions {
						<div class="flex flex-col gap-[3px]">
							for _, day := range week.Days {
								<div
									class={ contribCell(day.Count) }
									aria-label={ day.Date + ": " + fmt.Sprintf("%d", day.Count) + " contributions" }
									style="width:10px;height:10px;border-radius:2px"
								></div>
							}
						</div>
					}
				</div>
			</div>
		}
		if len(stats.TopRepos) > 0 {
			<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
				for _, r := range stats.TopRepos {
					if r.Description != "" {
						<a href={ templ.SafeURL(r.URL) } target="_blank" rel="noopener" class="group block border border-border rounded-none p-3 hover:bg-surface transition-colors">
							<p class="text-sm font-mono font-medium text-link group-hover:underline truncate">{ r.Name }</p>
							<p class="text-xs text-muted mt-1 line-clamp-2">{ r.Description }</p>
							<div class="flex items-center gap-2 mt-2">
								if r.Language != "" {
									<span class="text-xs px-1.5 py-0.5 bg-chip text-muted rounded-none font-mono">{ r.Language }</span>
								}
								if r.Stars > 0 {
									<span class="text-xs text-muted">⭐ { fmt.Sprintf("%d", r.Stars) }</span>
								}
							</div>
						</a>
					}
				}
			</div>
		}
	</section>
}

func contribCell(count int) string {
	switch {
	case count == 0:
		return "contrib-0"
	case count <= 3:
		return "contrib-1"
	case count <= 6:
		return "contrib-2"
	case count <= 9:
		return "contrib-3"
	default:
		return "contrib-4"
	}
}
