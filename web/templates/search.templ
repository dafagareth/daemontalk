package templates

import (
	"fmt"
	"strings"

	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

// SearchResult wraps a post for the search results page.
type SearchResult struct {
	Post post.Post
}

templ SearchPage(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	<section class="container-page py-8 sm:py-12">
		<h1 class="display text-2xl sm:text-3xl font-semibold text-text mb-6">{ ui.Search_Title }</h1>
		<form action={ templ.SafeURL(prefix(lang) + "/search") } method="get" class="mb-6" hx-boost="true">
			<input
				type="search"
				name="q"
				value={ query }
				placeholder={ ui.Blog_SearchPlaceholder }
				autofocus
				hx-get={ string(templ.SafeURL(prefix(lang) + "/search")) }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#search-results"
				hx-push-url="true"
				class="w-full px-3 py-2 text-sm rounded-none border border-border bg-surface text-text placeholder:text-muted focus:outline-none focus:border-[var(--c-link)] transition-colors"
			/>
		</form>
		<div id="search-results">
			@SearchResultsList(ui, query, results, lang, viewCounts)
		</div>
	</section>
}

templ SearchResultsList(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	if query != "" {
		<p class="text-sm text-muted mb-6">
			{ ui.Search_ResultsFor } <span class="font-medium text-text">"{ query }"</span>
			· { fmt.Sprintf("%d post(s)", len(results)) }
		</p>
		if len(results) == 0 {
			<p class="text-sm text-muted">{ ui.Blog_NoResults }</p>
		} else {
			<ul>
				for _, sr := range results {
					@searchResultItem(ui, sr.Post, query, lang, viewCounts)
				}
			</ul>
		}
	}
}

templ searchResultItem(ui i18n.UI, p post.Post, query string, lang string, viewCounts map[string]int) {
	<li class="blog-item py-5 relative" data-search={ p.Title + " " + strings.Join(p.Tags, " ") + " " + p.Description }>
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="block group">
			<div class="flex items-start justify-between gap-4 mb-1">
				<h2 class="text-sm font-medium text-link group-hover:underline leading-snug">
					@templ.Raw(string(highlightHTML(p.Title, query)))
				</h2>
				<span class="text-xs text-muted shrink-0 font-mono">{ fmtDate(p) }</span>
			</div>
			if p.Description != "" {
				<p class="text-sm text-muted leading-relaxed line-clamp-2">
					@templ.Raw(string(highlightHTML(p.Description, query)))
				</p>
			}
			if len(p.Tags) > 0 {
				<div class="flex flex-wrap gap-1 mt-2">
					for _, t := range p.Tags {
						<span class="text-xs px-1.5 py-0.5 bg-chip text-muted rounded-none font-mono">{ t }</span>
					}
				</div>
			}
		</a>
	</li>
}

// SearchDropdownResults renders the instant flyout popper results directly under the header search bar.
templ SearchDropdownResults(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	if query != "" {
		if len(results) == 0 {
			<div class="p-6 text-center">
				<p class="text-xs font-mono text-muted mb-1">{ ui.Blog_NoResults }</p>
				<p class="text-[11px] font-mono text-muted/80">Tidak ada artikel untuk "<span class="text-text font-semibold">{ query }</span>"</p>
			</div>
		} else {
			<div class="divide-y divide-border/50 max-h-[360px] overflow-y-auto scrollbar-thin" id="search-dropdown-list">
				for i, sr := range results {
					if i < 6 {
						<a
							href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sr.Post.Slug) }
							class="search-popper-item block p-3.5 hover:bg-hover transition-colors group focus:bg-hover focus:outline-none"
							tabindex="0"
							data-index={ fmt.Sprintf("%d", i) }
						>
							<div class="flex items-start justify-between gap-3 mb-1">
								<h4 class="text-sm font-bold text-text group-hover:text-link group-focus:text-link leading-snug line-clamp-1 transition-colors">
									@templ.Raw(string(highlightHTML(sr.Post.Title, query)))
								</h4>
								<span class="text-[10px] font-mono text-muted shrink-0 mt-0.5">{ fmtDate(sr.Post) }</span>
							</div>
							if sr.Post.Description != "" {
								<p class="text-[11px] text-muted line-clamp-1 leading-relaxed mb-1.5">
									@templ.Raw(string(highlightHTML(sr.Post.Description, query)))
								</p>
							}
							<div class="flex items-center gap-2 text-[10px] font-mono text-muted">
								if len(sr.Post.Tags) > 0 {
									<span class="uppercase font-bold text-accent">[{ sr.Post.Tags[0] }]</span>
								}
								if sr.Post.ReadTime > 0 {
									<span>·</span>
									<span>{ fmt.Sprintf("%d min read", sr.Post.ReadTime) }</span>
								}
							</div>
						</a>
					}
				}
			</div>
			<div class="px-3.5 py-2.5 bg-surface border-t border-border flex items-center justify-between text-[11px] font-mono text-muted">
				<span>{ fmt.Sprintf("%d artikel ditemukan", len(results)) }</span>
				<a
					href={ templ.SafeURL(prefix(lang) + "/search?q=" + query) }
					class="font-bold text-link hover:underline inline-flex items-center gap-1 group"
				>
					<span>{ ui.Search_SeeAll }</span>
					@IconArrowRight("w-3 h-3 transition-transform group-hover:translate-x-0.5")
				</a>
			</div>
		}
	}
}
