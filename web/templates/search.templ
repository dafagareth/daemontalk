package templates

import (
	"fmt"

	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

// SearchResult wraps a post for the search results page.
type SearchResult struct {
	Post post.Post
}

templ SearchPage(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-6">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@IconArrowLeft("w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight">
				{ ui.Search_Title }
			</h1>
		</div>
		<div class="sm:border sm:border-border sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden">
			<div class={ "border border-border sm:border-0 bg-surface p-4 sm:p-6", templ.KV("sm:border-b sm:border-border", query != "") }>
				<form action={ templ.SafeURL(prefix(lang) + "/search") } method="get" onsubmit="event.preventDefault()">
					<div class="flex items-center gap-3">
						<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
						<input
							id="search-input"
							type="search"
							name="q"
							value={ query }
							placeholder={ ui.Blog_SearchPlaceholder }
							autofocus
							hx-get={ string(templ.SafeURL(prefix(lang) + "/search")) }
							hx-trigger="input changed delay:120ms, search"
							hx-target="#search-results"
							hx-push-url="true"
							class="w-full bg-transparent text-text font-sans text-sm sm:text-base focus:outline-none placeholder:text-muted"
							autocomplete="off"
							aria-label="Search"
						/>
						if query != "" {
							<button
								type="button"
								onclick="clearSearchInput()"
								aria-label="Clear search"
								class="text-xs font-mono text-muted hover:text-text px-2 py-0.5 border border-border bg-chip hover:bg-hover transition-colors shrink-0 cursor-pointer"
							>
								ESC
							</button>
						}
					</div>
				</form>
			</div>
			<div id="search-results">
				@SearchResultsList(ui, query, results, lang, viewCounts)
			</div>
		</div>
	</section>
}

templ SearchResultsList(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	if query != "" {
		if len(results) == 0 {
			<div class="p-12 text-center font-mono">
				<p class="text-sm font-bold text-text mb-1">{ ui.Blog_NoResults }</p>
				<p class="text-xs text-muted">
					if lang == "id" {
						Tidak ada artikel yang cocok dengan pencarian "{ query }".
					} else {
						No dispatches found matching "{ query }".
					}
				</p>
			</div>
		} else {
			<ul class="divide-y divide-border/60">
				for _, sr := range results {
					@searchResultItem(ui, sr.Post, query, lang, viewCounts)
				}
			</ul>
		}
	}
}

templ searchResultItem(ui i18n.UI, p post.Post, query string, lang string, viewCounts map[string]int) {
	<li class="hover:bg-hover transition-colors group">
		<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="px-0 sm:px-7 py-4 sm:py-6 flex items-baseline justify-between gap-4">
			<h2 class="text-sm sm:text-base font-bold text-text group-hover:text-link leading-snug transition-colors">
				@templ.Raw(string(highlightHTML(p.Title, query)))
			</h2>
			<time datetime={ p.Date.Format("2006-01-02") } class="text-xs font-mono text-muted shrink-0">
				{ fmtDate(p, lang) }
			</time>
		</a>
	</li>
}

// SearchDropdownResults renders the instant flyout popper results directly under the header search bar.
templ SearchDropdownResults(ui i18n.UI, query string, results []SearchResult, lang string, viewCounts map[string]int) {
	if query != "" {
		if len(results) == 0 {
			<div class="p-6 text-center font-mono">
				<p class="text-xs text-muted">{ ui.Blog_NoResults }</p>
			</div>
		} else {
			<div class="divide-y divide-border/50 max-h-[360px] overflow-y-auto scrollbar-thin" id="search-dropdown-list">
				for i, sr := range results {
					if i < 6 {
						<a
							href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sr.Post.Slug) }
							class="search-popper-item block p-3.5 hover:bg-hover transition-colors group focus:bg-hover focus:outline-none"
							tabindex="0"
							data-index={ fmt.Sprintf("%d", i) }
						>
							<div class="flex items-start justify-between gap-3 mb-1">
								<h4 class="text-sm font-bold text-text group-hover:text-link group-focus:text-link leading-snug line-clamp-1 transition-colors font-sans">
									@templ.Raw(string(highlightHTML(sr.Post.Title, query)))
								</h4>
								<span class="text-[10px] font-mono text-muted shrink-0 mt-0.5">{ fmtDate(sr.Post, lang) }</span>
							</div>
						</a>
					}
				}
			</div>
			<div class="px-3.5 py-2.5 bg-surface border-t border-border flex items-center justify-between text-[11px] font-mono text-muted">
				<span>{ fmt.Sprintf("%d artikel ditemukan", len(results)) }</span>
				<a
					href={ templ.SafeURL(prefix(lang) + "/search?q=" + query) }
					class="font-bold text-link hover:underline inline-flex items-center gap-1 group"
				>
					<span>{ ui.Search_SeeAll }</span>
					@IconArrowRight("w-3 h-3 transition-transform group-hover:translate-x-0.5")
				</a>
			</div>
		}
	}
}
