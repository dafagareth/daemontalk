package templates

import "html/template"

templ ContributePage(body template.HTML, lang string) {
	<section class="container-page py-8 sm:py-12">
		<div class="max-w-5xl">
		<div class="flex items-center gap-2 mb-3 font-mono text-xs text-muted">
			<span class="px-2 py-0.5 rounded-none bg-chip border border-border text-text font-semibold">OPEN NOTEBOOK</span>
			<span>·</span>
			<span>CATATAN TEKNIS</span>
		</div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-border">
			<div>
				<h1 class="display text-2xl sm:text-3xl font-semibold text-text mb-2">
					if lang == "id" {
						Panduan Menulis & Berbagi Catatan
					} else {
						Writing Guide & Sharing Notes
					}
				</h1>
				<p class="text-sm text-muted">
					if lang == "id" {
						Panduan struktur penulisan artikel, dokumentasi lab, dan kontribusi catatan untuk Daemontalk.
					} else {
						Guide for formatting technical articles, lab documentation, and notes on Daemontalk.
					}
				</p>
			</div>
			<div>
				<a
					href="/download/template.md"
					download="template.md"
					class="inline-flex items-center gap-2 text-xs font-mono px-3.5 py-2 border border-border bg-surface text-text hover:bg-hover hover:border-[var(--c-link)] transition-colors shrink-0"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					<span>Download template.md</span>
				</a>
			</div>
		</div>
		<div class="prose max-w-none">
			@templ.Raw(string(body))
		</div>
		</div>
	</section>
}
