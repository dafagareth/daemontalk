package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

// reactionIcon returns an SVG icon for a given emoji reaction.
templ reactionIcon(emoji string, active bool) {
	if emoji == "like" {
		@IconReactionThumbsUp(active)
	} else if emoji == "heart" {
		@IconReactionHeart(active)
	} else if emoji == "fire" {
		@IconReactionFire(active)
	} else if emoji == "mindblown" {
		@IconReactionMindBlown(active)
	} else if emoji == "insightful" {
		@IconReactionInsightful(active)
	} else {
		{ emoji }
	}
}

// ReactionsBar renders the emoji reaction row for a post. Exported for the reaction handler.
templ ReactionsBar(ui i18n.UI, reactions map[string]int, slug string, lang string, userReaction string) {
	<div id="reactions-bar" class="flex flex-wrap items-center gap-2">
		<p class="text-xs text-muted w-full mb-1 font-medium uppercase tracking-wide">Reactions</p>
		for _, emoji := range []string{"like", "heart", "fire", "mindblown", "insightful"} {
			<button
				class={ "reaction-btn flex items-center justify-center gap-2", templ.KV("reaction-active", emoji == userReaction) }
				hx-post={ blogPrefix(lang) + "/blog/" + slug + "/reactions/" + emoji }
				hx-target="#reactions-bar"
				hx-swap="outerHTML"
				title={ reactionName(emoji) }
			>
				@reactionIcon(emoji, emoji == userReaction)
				if reactions[emoji] > 0 {
					<span class="reaction-count text-xs font-mono">{ fmt.Sprintf("%d", reactions[emoji]) }</span>
				}
			</button>
		}
	</div>
}
