package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

// reactionIcon returns an SVG icon for a given emoji reaction.
templ reactionIcon(emoji string) {
	if emoji == "👍" {
		<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
	} else if emoji == "❤️" {
		<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
	} else if emoji == "🔥" {
		<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
	} else if emoji == "🤯" {
		<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
	} else if emoji == "💡" {
		<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
	} else {
		{ emoji }
	}
}

// ReactionsBar renders the emoji reaction row for a post. Exported for the reaction handler.
templ ReactionsBar(ui i18n.UI, reactions map[string]int, slug string, lang string, userReaction string) {
	<div id="reactions-bar" class="flex flex-wrap items-center gap-2">
		<p class="text-xs text-muted w-full mb-1 font-medium uppercase tracking-wide">Reactions</p>
		for _, emoji := range []string{"👍", "❤️", "🔥", "🤯", "💡"} {
			<button
				class={ "reaction-btn flex items-center justify-center gap-2", templ.KV("reaction-active", emoji == userReaction) }
				hx-post={ blogPrefix(lang) + "/blog/" + slug + "/reactions/" + emoji }
				hx-target="#reactions-bar"
				hx-swap="outerHTML"
				title={ emoji }
			>
				@reactionIcon(emoji)
				if reactions[emoji] > 0 {
					<span class="reaction-count text-xs font-mono">{ fmt.Sprintf("%d", reactions[emoji]) }</span>
				}
			</button>
		}
	</div>
}
