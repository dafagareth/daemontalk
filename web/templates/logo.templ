package templates

templ BrandIcon(class string) {
	<img src="/static/logo/icon-light.webp" alt="Moth Icon" class={ "logo-light object-contain " + class } width="32" height="32"/>
	<img src="/static/logo/icon-dark.webp" alt="Moth Icon" class={ "logo-dark object-contain " + class } width="32" height="32"/>
}

templ BrandLogo(class string) {
	<img src="/static/logo/logo-light.webp" alt="daemontalk" class={ "logo-light object-contain " + class }/>
	<img src="/static/logo/logo-dark.webp" alt="daemontalk" class={ "logo-dark object-contain " + class }/>
}
