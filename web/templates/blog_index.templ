package templates

import (
	"fmt"

	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ BlogIndex(ui i18n.UI, allPosts []post.Post, posts []post.Post, lang string, page int, totalPages int, viewCounts map[string]int, tagCounts map[string]int, currentTag string) {
	<section class="container-page !px-0 sm:!px-6 lg:!px-8 pb-0 mb-0 transition-all">
		<h1 class="sr-only">{ ui.Blog_Title }</h1>

		if len(allPosts) == 0 {
			<p class="text-sm text-muted py-12 text-center">{ ui.Blog_NoPosts }</p>
		} else {
			<p id="blog-noresults" class="hidden text-sm text-muted mb-8 text-center py-8">{ ui.Blog_NoResults }</p>

			<!-- 2. Portal News Layout (Homepage only) -->
			if currentTag == "" {
				@portalNewsLayout(ui, allPosts, tagCounts, lang, viewCounts)
			} else {
				@TagPortal(ui, currentTag, allPosts, lang, viewCounts)
			}

			<script src="/static/js/blog_index.js"></script>
		}
	</section>
}

templ TagPage(ui i18n.UI, tag string, allPosts []post.Post, lang string, viewCounts map[string]int) {
	<section class="container-page !px-0 sm:!px-6 lg:!px-8 pb-0 mb-0 transition-all">
		@TagPortal(ui, tag, allPosts, lang, viewCounts)
	</section>
}

templ blogHeroItem(ui i18n.UI, p post.Post, lang string, viewCounts map[string]int) {
	@blogCardItem(ui, p, lang, viewCounts, false)
}

templ blogCardItemDynamic(ui i18n.UI, p post.Post, lang string, viewCounts map[string]int, idx int) {
	@blogCardItem(ui, p, lang, viewCounts, false)
}

// BORDERLESS FLAT EDITORIAL CARD (Consistent 16:9 Thumbnail, Meta, Headline, Snippet)
templ blogCardItem(ui i18n.UI, p post.Post, lang string, viewCounts map[string]int, hideTag bool) {
	<article class="blog-item group flex flex-row sm:flex-col gap-4 sm:gap-0 min-w-0 items-start sm:items-stretch h-full" data-search={ searchIndex(p) }>
		<!-- Media Container -->
		<div class="relative aspect-[16/9] w-24 sm:w-full overflow-hidden rounded-none shrink-0 sm:mb-3 bg-surface">
			@postThumbnail(p, blogPrefix(lang) + "/blog/" + p.Slug)
		</div>

		<!-- Content Container -->
		<div class="flex-1 min-w-0 flex flex-col justify-center sm:justify-start h-full">
			<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } data-slug={ p.Slug } class="block group mb-1 sm:mb-2 sm:mt-1">
				<h3 class="text-sm sm:text-xl font-black text-text group-hover:text-link transition-colors line-clamp-3 leading-snug break-words">
					{ p.Title }
				</h3>
			</a>

			<div class="flex flex-wrap items-center gap-1 sm:gap-2 mb-1 sm:mb-2 text-[9px] sm:text-[11px] font-mono text-muted uppercase tracking-wider">
				<time datetime={ p.Date.Format("2006-01-02") }>{ fmtDate(p) }</time>
				<span class="hidden sm:inline">·</span>
				<span class="hidden sm:inline">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
			</div>

			if p.Description != "" {
				<p class="hidden sm:line-clamp-2 text-sm text-muted  leading-relaxed mb-3.5 break-words">
					{ p.Description }
				</p>
			}

			if !hideTag && len(p.Tags) > 0 {
				<div class="hidden sm:flex flex-wrap gap-2 mt-auto pt-1">
					<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + p.Tags[0]) } class="text-[10px] font-bold text-accent uppercase tracking-wider hover:underline">{ p.Tags[0] }</a>
				</div>
			}
		</div>
	</article>
}

templ blogListItem(ui i18n.UI, p post.Post, lang string, viewCounts map[string]int) {
	@blogCardItem(ui, p, lang, viewCounts, false)
}

// BlogPostItems is a partial template for HTMX Infinite Scroll (returns grid cards + OOB load-more update).
templ BlogPostItems(ui i18n.UI, posts []post.Post, lang string, viewCounts map[string]int, nextPage int, hasMore bool, currentTag string) {
	for _, p := range posts {
		@blogCardItem(ui, p, lang, viewCounts, currentTag != "")
	}
	<div id="load-more-wrap" class="mt-12 mb-8 text-center" hx-swap-oob="true">
		if hasMore {
			<button
				hx-get={ fmt.Sprintf("/blog/posts?page=%d&lang=%s&tag=%s", nextPage, lang, currentTag) }
				hx-trigger="click"
				hx-target="#blog-grid"
				hx-swap="beforeend"
				class="px-6 py-2.5 border-2 border-border text-xs font-mono font-bold uppercase tracking-widest text-text hover:bg-hover transition-colors cursor-pointer inline-flex items-center justify-center min-w-[200px]"
			>
				if lang == "id" {
					TAMPILKAN LEBIH BANYAK
				} else {
					LOAD MORE
				}
			</button>
		}
	</div>
}
