package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/i18n"
)

templ SettingsPage(ui i18n.UI, user *auth.User, lang string, currentPath string) {
	@Layout(ui, lang, "settings", currentPath, PageMeta{
		Description: "User Settings and Preferences",
		Type:        "website",
	}, settingsContent(ui, user, lang, currentPath))
}

templ settingsContent(ui i18n.UI, user *auth.User, lang string, currentPath string) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh]">
		<div class="mb-6">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-text transition-colors mb-3 group select-none"
			>
				@IconArrowLeft("w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight">
				if lang == "id" {
					Pengaturan
				} else {
					Settings
				}
			</h1>
		</div>
		if user == nil {
			<div class="border border-border bg-surface p-8 text-center font-mono text-xs text-muted shadow-xl">
				if lang == "id" {
					Silakan masuk dengan GitHub untuk melihat pengaturan Anda.
				} else {
					Please log in with GitHub to view your settings.
				}
			</div>
		} else {
			<div class="sm:border sm:border-border sm:bg-surface/20 sm:shadow-xl sm:overflow-hidden font-sans">
				<div class="border border-border sm:border-0 sm:border-b sm:border-border bg-surface p-4 sm:p-6 flex items-center justify-between text-xs sm:text-sm font-mono select-none flex-wrap gap-3">
					<div class="flex items-center gap-3 text-text font-bold min-w-0">
						<span class="text-link font-black font-mono text-base sm:text-lg shrink-0 select-none">❯</span>
						<code class="text-sm sm:text-base font-mono truncate">cat /etc/daemontalk/settings.conf</code>
					</div>
					<span class="text-xs font-mono text-muted font-bold uppercase shrink-0">USER: { "@" + user.Username }</span>
				</div>
				<div class="divide-y divide-border text-xs sm:text-sm font-mono mt-4 sm:mt-0">
					<div class="p-4 sm:p-6 flex items-center justify-between gap-4 hover:bg-hover transition-colors">
						<span class="font-bold text-text">
							if lang == "id" {
								Tema Tampilan
							} else {
								Visual Theme
							}
						</span>
						<button
							type="button"
							onclick="toggleTheme()"
							class="inline-flex items-center gap-2 px-3 py-1.5 border border-border bg-chip hover:bg-hover text-text text-xs font-bold transition-colors cursor-pointer"
						>
							@sunIcon()
							@moonIcon()
							<span>Ganti Tema</span>
						</button>
					</div>
					<div class="p-4 sm:p-6 flex items-center justify-between gap-4 hover:bg-hover transition-colors">
						<span class="font-bold text-text">
							if lang == "id" {
								Bahasa Antarmuka
							} else {
								Interface Language
							}
						</span>
						<div class="flex items-center gap-1">
							<a
								href={ templ.SafeURL(toLangURL("id", currentPath)) }
								class={ "px-2.5 py-1 border text-xs font-bold transition-colors", templ.KV("border-text text-text bg-chip", lang == "id"), templ.KV("border-border text-muted hover:text-text", lang != "id") }
							>
								ID
							</a>
							<a
								href={ templ.SafeURL(toLangURL("en", currentPath)) }
								class={ "px-2.5 py-1 border text-xs font-bold transition-colors", templ.KV("border-text text-text bg-chip", lang == "en" || lang == ""), templ.KV("border-border text-muted hover:text-text", lang != "en" && lang != "") }
							>
								EN
							</a>
						</div>
					</div>
					<div class="p-4 sm:p-6 flex items-center justify-between gap-4 hover:bg-hover transition-colors">
						<span class="font-bold text-text">{ ui.Auth_ExportData }</span>
						<a
							href="/auth/export"
							class="px-3 py-1.5 border border-border bg-chip hover:bg-hover text-text text-xs font-bold transition-colors inline-flex items-center gap-1.5"
							download
						>
							<span>EXPORT JSON</span>
						</a>
					</div>
					<div class="p-4 sm:p-6 flex items-center justify-between gap-4 hover:bg-hover transition-colors">
						<div>
							<span class="font-bold text-rose-500 block">{ ui.Auth_DeleteAccount }</span>
							<span class="text-xs text-muted block mt-0.5">
								if lang == "id" {
									Menghapus seluruh akun dan data terkait secara permanen.
								} else {
									Permanently delete your account and all associated data.
								}
							</span>
						</div>
						<form action="/auth/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus akun ini secara permanen? Tindakan ini tidak dapat dibatalkan.');">
							<button
								type="submit"
								class="px-3 py-1.5 border border-rose-500/50 bg-rose-500/10 text-rose-400 hover:bg-rose-500 hover:text-white text-xs font-bold transition-colors cursor-pointer"
							>
								<span>DELETE</span>
							</button>
						</form>
					</div>
				</div>
			</div>
		}
	</section>
}
