package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ blogHeader(ui i18n.UI, p post.Post, lang string, seriesParts []post.Post) {
	<header class="mb-8">
		
		<!-- Stream & Date Line -->
		<div class="flex flex-wrap items-center gap-2 text-xs font-mono mb-3">
			if len(p.Tags) > 0 {
				<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + p.Tags[0]) } class="font-bold text-accent uppercase tracking-wider hover:underline">
					{ p.Tags[0] }
				</a>
				<span class="text-muted">·</span>
			}
			<time datetime={ p.Date.Format("2006-01-02") } class="text-muted">{ fmtDate(p) }</time>
			<span class="text-muted">·</span>
			<span class="text-muted">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
		</div>

		<!-- Series navigation (if part of a series) -->
		if len(seriesParts) > 1 {
			@seriesNav(ui, seriesParts, p, lang)
		}

		<!-- Headline & Lede Subtitle -->
		<div class="mb-6">
			<h1 class="display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight text-text leading-[1.12] mb-4">
				{ p.Title }
			</h1>
			if p.Description != "" {
				<p class="text-lg sm:text-xl text-muted font-sans leading-relaxed">
					{ p.Description }
				</p>
			}
		</div>

		<!-- Author & Tags Row -->
		<div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-border/60 text-xs font-mono">
			<div class="flex items-center gap-2">
				<span class="text-muted">By</span>
				<strong class="text-text font-bold">
					if p.Author != "" {
						{ p.Author }
					} else {
						daemontalk
					}
				</strong>
			</div>
			if len(p.Tags) > 0 {
				<div class="flex flex-wrap gap-1.5">
					for _, t := range p.Tags {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + t) } class="text-[11px] px-2 py-0.5 bg-chip text-muted hover:text-text transition-colors">
							#{ t }
						</a>
					}
				</div>
			}
		</div>
	</header>

	<!-- Cover Image -->
	if p.Cover != "" {
		<figure class="mb-10 w-full overflow-hidden">
			<img
				src={ p.Cover }
				alt={ p.Title }
				loading="lazy"
				class="w-full h-auto max-h-[520px] object-cover block"
			/>
			if p.CoverCaption != "" {
				<figcaption class="text-xs font-mono text-muted mt-2.5 flex items-center justify-between">
					<span>{ p.CoverCaption }</span>
					if p.CoverSource != "" {
						<a href={ templ.SafeURL(p.CoverSource) } target="_blank" rel="noopener noreferrer" class="text-link hover:underline">
							Source ↗
						</a>
					}
				</figcaption>
			}
		</figure>
	}
}
