package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
	"strings"
)

templ blogHeader(ui i18n.UI, p post.Post, lang string, seriesParts []post.Post) {
	<header class="mb-8">
		if len(p.Tags) > 0 || len(seriesParts) > 1 || (p.Type != "" && p.Type != "article") {
			<div class="flex items-center gap-2 flex-wrap mb-4 text-xs font-mono select-none">
				if len(seriesParts) > 1 {
					@seriesNav(ui, seriesParts, p, lang)
				} else if p.Type != "" && p.Type != "article" {
					<span class="px-1.5 py-0.2 text-[10px] uppercase font-bold bg-chip border border-border text-link mr-1">
						{ p.Type }
					</span>
				}
				for _, t := range p.Tags {
					<a
						href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + t) }
						class="text-link hover:underline font-mono text-xs font-bold mr-1.5"
					>
						#{ t }
					</a>
				}
			</div>
		}
		<div class="mb-6">
			<h1 class="display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight text-text leading-[1.12] mb-4">
				{ p.Title }
			</h1>
			if p.Description != "" {
				<p class="text-lg sm:text-xl text-muted font-sans leading-relaxed">
					{ p.Description }
				</p>
			}
		</div>
		<div class="pt-4 border-t border-muted/30 flex items-start gap-3 sm:gap-3.5 text-xs font-mono select-none">
			if p.AuthorAvatar != "" {
				<img
					src={ p.AuthorAvatar }
					alt={ p.Author }
					class="w-9 h-9 sm:w-10 sm:h-10 rounded-none border border-muted/30 object-cover shrink-0 mt-0.5"
					loading="lazy"
				/>
			}
			<div class="min-w-0 flex-1 space-y-1">
				<div class="flex items-center gap-2 flex-wrap">
					if p.AuthorGitHub != "" {
						<a
							href={ templ.SafeURL("https://github.com/" + p.AuthorGitHub) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-text hover:text-link transition-colors font-bold text-sm sm:text-base"
						>
							if p.Author != "" {
								{ p.Author }
							} else {
								{ "@" + p.AuthorGitHub }
							}
						</a>
					} else if p.Author != "" {
						<span class="text-text font-bold text-sm sm:text-base">{ p.Author }</span>
					} else {
						<span class="text-text font-bold text-sm sm:text-base">daemontalk</span>
					}
				</div>
				if len(p.Contributors) > 0 {
					<div class="flex items-center gap-1.5 text-muted text-xs flex-wrap">
						<span class="text-muted/70 text-[11px] uppercase font-semibold">contrib:</span>
						for i, c := range p.Contributors {
							{{ cleanHandle := strings.TrimPrefix(c, "@") }}
							<a
								href={ templ.SafeURL("https://github.com/" + cleanHandle) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-text hover:text-link font-medium transition-colors"
							>
								{ "@" + cleanHandle }
							</a>
							if i < len(p.Contributors)-1 {
								<span class="text-muted/40">,</span>
							}
						}
					</div>
				}
				<div class="flex items-center gap-2 text-xs text-muted flex-wrap">
					<time datetime={ p.Date.Format("2006-01-02") } class="text-muted">{ fmtDate(p, lang) }</time>
					<span class="text-muted/40">·</span>
					<span class="text-muted">{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
				</div>
			</div>
		</div>
	</header>
	if p.Cover != "" {
		<figure class="mb-10 w-full overflow-hidden">
			<div class="relative w-full aspect-[16/9] overflow-hidden bg-surface border border-border">
				<img
					src={ p.Cover }
					alt={ p.Title }
					loading="lazy"
					class="w-full h-full object-cover block"
				/>
			</div>
			if p.CoverCaption != "" {
				<figcaption class="text-xs font-mono text-muted mt-2.5 flex items-center justify-between">
					<span>{ p.CoverCaption }</span>
					if p.CoverSource != "" {
						<a href={ templ.SafeURL(p.CoverSource) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-link hover:underline">
							<span>Source</span>
							@IconArrowUpRight("w-3 h-3")
						</a>
					}
				</figcaption>
			}
		</figure>
	}
}
