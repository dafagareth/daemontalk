package templates

import (
	"daemontalk/internal/i18n"
	"html/template"
)

templ AccessibilityPage(ui i18n.UI, body template.HTML, lang string) {
	<section class="container-page py-8 sm:py-12">
		<div class="prose max-w-none font-sans">
			@templ.Raw(string(body))
		</div>
		<a href={ templ.SafeURL(blogPrefix(lang) + "/") } class="inline-flex items-center gap-1.5 text-sm text-link hover:underline mt-12 font-sans font-medium">
			@IconArrowLeft("w-3.5 h-3.5")
			<span>{ ui.Post_Back }</span>
		</a>
	</section>
}
