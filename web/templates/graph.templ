package templates

import (
	"daemontalk/internal/graph"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
	"sort"
	"strings"
)

templ GraphPage(ui i18n.UI, lang string, posts []post.Post, graphJSON string, stats graph.GraphStats) {
	{{ tags := extractTagsFromPosts(posts) }}
	<section class="container-page !px-0 sm:!px-6 lg:!px-8 py-0 sm:py-3 lg:py-4 h-full flex-1 min-h-0 flex flex-col">
		<div class="border-0 sm:border border-border bg-surface w-full h-full flex-1 min-h-0 flex flex-col overflow-hidden font-sans">
			<div class="border-b border-border bg-surface px-4 py-2 sm:px-6 sm:py-2.5 flex items-center justify-between gap-4 text-xs font-sans select-none flex-wrap shrink-0">
				<div class="flex items-center gap-3 overflow-x-auto text-xs font-sans">
					<button
						id="tab-filter-all"
						type="button"
						class="graph-filter-tab transition-colors tracking-wider text-text font-bold underline underline-offset-4 decoration-text cursor-pointer"
						data-filter="all"
					>
						if lang == "id" {
							{ "semua" }
						} else {
							{ "all" }
						}
					</button>
					<span class="text-border select-none">/</span>
					<button
						id="tab-filter-posts"
						type="button"
						class="graph-filter-tab transition-colors tracking-wider text-muted hover:text-text cursor-pointer"
						data-filter="posts"
					>
						if lang == "id" {
							{ "artikel" }
						} else {
							{ "dispatches" }
						}
					</button>
					<span class="text-border select-none">/</span>
					<button
						id="tab-filter-domains"
						type="button"
						class="graph-filter-tab transition-colors tracking-wider text-muted hover:text-text cursor-pointer"
						data-filter="domains"
					>
						if lang == "id" {
							{ "domain (#tags)" }
						} else {
							{ "domains (#tags)" }
						}
					</button>
				</div>
				<div class="flex items-center gap-3 font-sans">
					<div class="hidden sm:flex items-center gap-1.5 text-xs font-sans text-muted">
						<span>{ fmt.Sprintf("%d dispatches · %d domains · %d links", stats.TotalPosts, stats.TotalTags, stats.TotalLinks) }</span>
					</div>
					<div class="flex items-center border border-border divide-x divide-border bg-bg font-sans">
						<button
							id="btn-zoom-in"
							type="button"
							class="px-2.5 py-1 text-xs font-sans text-text hover:bg-hover transition-colors select-none cursor-pointer"
							title="Zoom In (+)"
						>
							+
						</button>
						<button
							id="btn-zoom-out"
							type="button"
							class="px-2.5 py-1 text-xs font-sans text-text hover:bg-hover transition-colors select-none cursor-pointer"
							title="Zoom Out (−)"
						>
							−
						</button>
						<button
							id="btn-reset-view"
							type="button"
							class="px-3 py-1 text-xs font-sans text-text hover:bg-hover transition-colors select-none cursor-pointer"
							title="Reset Camera (0 / r)"
						>
							Reset
						</button>
						<button
							id="btn-graph-shortcuts"
							type="button"
							class="hidden sm:inline-block px-2.5 py-1 text-xs font-sans text-muted hover:text-text hover:bg-hover transition-colors select-none cursor-pointer font-bold"
							title={ func() string { if lang == "id" { return "Bantuan Pintasan Keyboard (?)" }; return "Keyboard Shortcuts (?)" }() }
						>
							?
						</button>
					</div>
				</div>
			</div>
			<div class="grid grid-rows-1 grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border flex-1 min-h-0 h-full overflow-hidden">
				<div class="hidden lg:flex lg:col-span-5 xl:col-span-4 flex-col bg-surface min-h-0 h-full overflow-hidden">
					<div class="border-b border-border bg-surface px-3 py-2 flex items-center gap-2 text-xs font-sans shrink-0">
						@IconSearch("w-3.5 h-3.5 text-muted shrink-0 select-none")
						<input
							id="graph-search"
							type="text"
							placeholder={ func() string { if lang == "id" { return "Cari simpul atau #tag... (Tekan /)" }; return "Search nodes or #tags... (Press /)" }() }
							class="w-full bg-bg border border-border px-2.5 py-1 text-xs font-sans text-text placeholder:text-muted/60 focus:outline-none focus:border-text transition-colors"
						/>
					</div>
					<div id="graph-topics-list" class="flex-1 min-h-0 overflow-y-auto divide-y divide-border/40 [scrollbar-width:thin]">
						for _, p := range posts {
							if !p.Draft {
								<div
									id={ "graph-row-post-" + p.Slug }
									data-node-id={ "post:" + p.Slug }
									data-node-type="post"
									data-node-title={ p.Title }
									data-node-slug={ p.Slug }
									data-node-tag={ func() string { if len(p.Tags) > 0 { return p.Tags[0] }; return "post" }() }
									class="graph-node-row p-3 sm:p-3.5 flex flex-col gap-1 transition-colors select-none group cursor-pointer hover:bg-bg/60 font-sans"
								>
									<h3 class="font-bold text-xs sm:text-sm leading-snug text-text group-hover:underline transition-colors line-clamp-2 font-sans">
										{ p.Title }
									</h3>
									<div class="flex items-center gap-1.5 text-xs font-sans text-muted flex-wrap">
										if len(p.Tags) > 0 {
											<span class="text-muted font-medium uppercase">#{ p.Tags[0] }</span>
											<span class="text-muted/40">·</span>
										}
										<time>{ fmtShortDate(p.Date, lang) }</time>
									</div>
								</div>
							}
						}
						for _, t := range tags {
							{{ count := tagPostCount(posts, t) }}
							<div
								id={ "graph-row-tag-" + t }
								data-node-id={ "tag:" + t }
								data-node-type="tag"
								data-node-title={ "#" + t }
								data-node-tag={ t }
								class="graph-node-row p-3 sm:p-3.5 flex flex-col gap-1 transition-colors select-none group cursor-pointer hover:bg-bg/60 font-sans"
							>
								<h3 class="font-bold text-xs sm:text-sm leading-snug text-text group-hover:underline transition-colors line-clamp-1 font-sans">
									#{ t }
								</h3>
								<div class="flex items-center gap-1.5 text-xs font-sans text-muted flex-wrap">
									<span class="text-muted">
										if lang == "id" {
											{ fmt.Sprintf("%d artikel terhubung", count) }
										} else {
											{ fmt.Sprintf("%d dispatches connected", count) }
										}
									</span>
								</div>
							</div>
						}
					</div>
					<div class="border-t border-border bg-surface px-3 py-2 sm:px-4 sm:py-2 flex items-center justify-between text-xs font-sans text-muted select-none shrink-0 mt-auto gap-2">
						<div class="flex items-center gap-2 text-muted/80 truncate">
							<span class="hidden xl:inline"><kbd class="px-1 border border-border bg-bg text-text font-sans">j</kbd>/<kbd class="px-1 border border-border bg-bg text-text font-sans">k</kbd> navigasi</span>
							<span class="hidden sm:inline"><kbd class="px-1 border border-border bg-bg text-text font-sans">↵</kbd> buka</span>
							<span class="hidden md:inline"><kbd class="px-1 border border-border bg-bg text-text font-sans">/</kbd> cari</span>
							<button type="button" onclick="document.getElementById('graph-shortcuts-modal').classList.add('open')" class="hover:text-text cursor-pointer underline decoration-dotted font-sans">
								<kbd class="px-1 border border-border bg-bg text-text font-sans">?</kbd> bantuan
							</button>
						</div>
						<span id="graph-list-count" class="shrink-0 font-medium font-sans">{ fmt.Sprintf("%d simpul", len(posts)+len(tags)) }</span>
					</div>
				</div>
				<div class="col-span-1 lg:col-span-7 xl:col-span-8 flex flex-col min-h-0 h-full overflow-hidden bg-surface relative w-full">
					<div class="relative flex-1 w-full min-h-0 bg-bg overflow-hidden select-none">
						<canvas
							id="knowledge-canvas"
							data-graph={ graphJSON }
							class="w-full h-full block cursor-grab active:cursor-grabbing"
						></canvas>
						<div
							id="graph-context-bar"
							class="hidden absolute bottom-12 sm:bottom-6 left-4 right-4 sm:left-auto sm:right-6 sm:w-96 mb-[env(safe-area-inset-bottom,0px)] bg-surface/95 backdrop-blur-md border border-border shadow-2xl p-4 sm:p-5 z-30 font-sans select-none"
						>
							<div class="flex items-center justify-between gap-3 mb-2.5">
								<div class="flex items-center gap-2 text-xs font-sans min-w-0 flex-wrap">
									<span id="inspector-badge" class="px-1.5 py-0.5 border border-border bg-bg text-text text-[10px] tracking-wider uppercase font-bold shrink-0">
										DISPATCH
									</span>
									<span id="inspector-meta-tag" class="text-xs font-bold text-text truncate"></span>
									<span class="text-muted/40">·</span>
									<span id="inspector-meta-info" class="text-xs text-muted truncate"></span>
								</div>
								<button
									id="btn-clear-selection"
									type="button"
									class="w-6 h-6 flex items-center justify-center text-muted hover:text-text hover:bg-hover border border-border/50 text-xs transition-colors cursor-pointer shrink-0"
									title="Tutup (Esc)"
								>
									✕
								</button>
							</div>
							<h2 id="inspector-title" class="text-sm sm:text-base font-bold text-text leading-snug mb-3.5 line-clamp-2"></h2>
							<a
								id="inspector-cta"
								href="#"
								class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer"
							>
								<span id="inspector-cta-label">BACA ARTIKEL</span>
								<span>→</span>
							</a>
						</div>
						<div id="graph-empty-bar" class="hidden"></div>
						<div class="hidden sm:flex absolute bottom-3 left-3 pointer-events-none z-10 items-center gap-2 text-xs font-sans text-muted bg-surface/90 border border-border/80 px-3 py-1.5 backdrop-blur select-none">
							<span class="font-medium text-text">Post</span>
							<span class="text-border">·</span>
							<span class="font-medium text-text">Domain (#tag)</span>
							<span class="hidden md:inline text-border">·</span>
							<span class="hidden md:inline text-xs text-muted">
								if lang == "id" {
									{ "[+/-] zoom · [0] reset · [f] fokus · [↵] baca · [?] shortcut" }
								} else {
									{ "[+/-] zoom · [0] reset · [f] focus · [↵] read · [?] shortcuts" }
								}
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	@graphShortcutsModal(lang)
	<script src={ assetURL("/static/js/graph.js") } defer></script>
}

func extractTagsFromPosts(posts []post.Post) []string {
	tagSet := make(map[string]bool)
	for _, p := range posts {
		if !p.Draft {
			for _, t := range p.Tags {
				clean := strings.ToLower(strings.TrimSpace(t))
				if clean != "" {
					tagSet[clean] = true
				}
			}
		}
	}
	tags := make([]string, 0, len(tagSet))
	for t := range tagSet {
		tags = append(tags, t)
	}
	sort.Strings(tags)
	return tags
}

func tagPostCount(posts []post.Post, tag string) int {
	cnt := 0
	for _, p := range posts {
		if !p.Draft {
			for _, t := range p.Tags {
				if strings.EqualFold(t, tag) {
					cnt++
					break
				}
			}
		}
	}
	return cnt
}
