package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"fmt"
)

templ portalNewsLayout(ui i18n.UI, posts []post.Post, tagCounts map[string]int, lang string, viewCounts map[string]int) {
	{{
		// Deduplicate post slugs across homepage sections
		var usedSlugs []string
		for i := 0; i <= 6 && i < len(posts); i++ {
			usedSlugs = append(usedSlugs, posts[i].Slug)
		}

		box2Cats := []CategorySection{
			getCategoryCluster(posts, "software", []string{"software", "development", "programming", "coding"}, 4, &usedSlugs),
			getCategoryCluster(posts, "linux", []string{"linux", "os", "archlinux", "ubuntu"}, 4, &usedSlugs),
			getCategoryCluster(posts, "security", []string{"security", "zero-trust", "firewall", "authentication"}, 4, &usedSlugs),
		}

		box3Cats := []CategorySection{
			getCategoryCluster(posts, "ai", []string{"ai", "machine-learning", "llm", "models", "agents"}, 2, &usedSlugs),
			getCategoryCluster(posts, "backend-architecture", []string{"backend", "go", "architecture", "distributed", "api"}, 2, &usedSlugs),
		}

		box4LeftCats := []CategorySection{
			getCategoryCluster(posts, "networking", []string{"networking", "protocols", "wireguard", "ssh", "dns", "tcp"}, 2, &usedSlugs),
			getCategoryCluster(posts, "gaming", []string{"gaming", "graphics", "gpu", "simulation"}, 2, &usedSlugs),
		}
		box4WirePosts := getWirePosts(posts, &usedSlugs, 4)

		box5Cats := []CategorySection{
			getCategoryCluster(posts, "tools", []string{"tools", "workflow", "git", "automation"}, 2, &usedSlugs),
			getCategoryCluster(posts, "science", []string{"science", "research", "physics", "computing"}, 2, &usedSlugs),
			getCategoryCluster(posts, "systems", []string{"systems", "low-level", "compiler", "assembly", "memory"}, 2, &usedSlugs),
			getCategoryCluster(posts, "container-internals", []string{"containers", "docker", "podman", "namespaces", "cgroups"}, 2, &usedSlugs),
		}

		box6Essay := getCategoryCluster(posts, "policy", []string{"policy", "law", "censorship", "government"}, 2, &usedSlugs)
		box6SidePosts := getWirePosts(posts, &usedSlugs, 3)

		box7Cats := []CategorySection{
			getCategoryCluster(posts, "terminal", []string{"terminal", "shell", "bash", "cli", "tmux", "zsh"}, 3, &usedSlugs),
			getCategoryCluster(posts, "database", []string{"database", "storage", "sqlite", "duckdb", "sql"}, 3, &usedSlugs),
			getCategoryCluster(posts, "ebpf", []string{"ebpf", "observability", "tracing", "debugging", "dmesg", "strace"}, 3, &usedSlugs),
			getCategoryCluster(posts, "crypto", []string{"privacy", "cryptography", "encryption"}, 3, &usedSlugs),
		}
	}}
	@portalHeroTop(ui, posts, lang, viewCounts, true)
	@portalBox8Cockpit(ui, tagCounts, lang, len(posts))
	@portalCategoryStackedRows(ui, box2Cats, lang)
	@portalDeepDive(ui, box3Cats, lang)
	@portalBox4SplitRiver(ui, box4LeftCats, box4WirePosts, lang)
	@portalBox5QuadMatrix(ui, box5Cats, lang)
	@portalBox6EssayBanner(ui, box6Essay, box6SidePosts, lang)
	@portalBox7KnowledgeIndex(ui, box7Cats, lang)
}

templ portalHeroTop(ui i18n.UI, posts []post.Post, lang string, viewCounts map[string]int, showSidebarTabs bool) {
	{{
		var excludeSlugs []string
		for i := 0; i <= 6 && i < len(posts); i++ {
			excludeSlugs = append(excludeSlugs, posts[i].Slug)
		}
		popularPosts := getPopularPostsExcluding(posts, viewCounts, excludeSlugs, 5)
	}}
	<div class="border-0 sm:border border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="w-full">
			<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
				<div class="lg:col-span-6 flex flex-col divide-y divide-[var(--c-border)] bg-bg order-1 lg:order-2">
					if len(posts) > 0 {
						<div class="flex flex-col">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[0].Slug) } class="group block px-5 sm:px-6 py-6 sm:py-8 lg:px-8 lg:py-10">
								<div class="relative w-full aspect-[16/9] bg-surface overflow-hidden border border-border mb-6 lg:mb-8">
									@postThumbnailImg(posts[0])
								</div>
								if len(posts[0].Tags) > 0 {
									<div class="flex items-center gap-2 mb-3">
										<span class="px-2 py-0.5 text-[10px] font-mono font-bold bg-accent/15 text-accent uppercase tracking-wider">
											{ posts[0].Tags[0] }
										</span>
									</div>
								}
								<h1 class="display text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-text group-hover:text-link transition-colors leading-[1.1] tracking-tight mb-4">
									{ posts[0].Title }
								</h1>
								if posts[0].Description != "" {
									<p class="text-base text-muted line-clamp-3 leading-relaxed mb-5">
										{ posts[0].Description }
									</p>
								}
								<div class="flex items-center gap-2 text-xs font-mono text-muted mt-4 pt-1">
									<span class="font-bold text-text">
										if posts[0].Author != "" {
											{ posts[0].Author }
										} else {
											daemontalk editorial
										}
									</span>
									<span>·</span>
									<time datetime={ posts[0].Date.Format("2006-01-02") }>{ fmtDate(posts[0], lang) }</time>
								</div>
							</a>
						</div>
					}
					if len(posts) > 5 {
						for _, idx := range []int{5, 6} {
							if idx < len(posts) {
								<div class="flex flex-col flex-1">
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[idx].Slug) } class="group block px-5 sm:px-6 py-6 sm:py-8 lg:px-8 lg:py-10 flex flex-row-reverse sm:flex-row gap-4 sm:gap-6 lg:gap-8 items-start sm:items-stretch justify-between">
										<div class="w-28 xs:w-32 sm:w-2/5 shrink-0 aspect-[16/9] bg-surface overflow-hidden border border-border">
											@postThumbnailImg(posts[idx])
										</div>
										<div class="flex-1 min-w-0 flex flex-col">
											if len(posts[idx].Tags) > 0 {
												<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-1 sm:mb-2 block">
													{ posts[idx].Tags[0] }
												</span>
											}
											<h2 class="display text-lg sm:text-2xl font-bold text-text group-hover:text-link transition-colors leading-snug mb-1.5 sm:mb-2 line-clamp-3 sm:line-clamp-none">
												{ posts[idx].Title }
											</h2>
											<div class="text-[10px] font-mono text-muted mt-auto pt-1 sm:pt-2">
												<time datetime={ posts[idx].Date.Format("2006-01-02") }>{ fmtDate(posts[idx], lang) }</time>
											</div>
										</div>
									</a>
								</div>
							}
						}
					}
				</div>
				<div class="lg:col-span-3 flex flex-col divide-y divide-[var(--c-border)] bg-bg order-2 lg:order-1">
					for _, i := range []int{1, 4} {
						if i < len(posts) {
							<div class="flex flex-col flex-1">
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[i].Slug) } class="group block px-5 sm:px-6 py-6 sm:py-8 lg:py-10">
									<div class="flex flex-row-reverse sm:flex-col items-start gap-4 sm:gap-0 justify-between">
										<div class="w-28 xs:w-32 sm:w-full aspect-[16/9] bg-surface overflow-hidden border border-border shrink-0 sm:mb-4">
											@postThumbnailImg(posts[i])
										</div>
										<div class="flex-1 min-w-0">
											if len(posts[i].Tags) > 0 {
												<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-1 sm:mb-2 block">
													{ posts[i].Tags[0] }
												</span>
											}
											<h2 class="display text-lg sm:text-2xl font-bold text-text group-hover:text-link transition-colors leading-snug mb-1.5 sm:mb-2 line-clamp-3 sm:line-clamp-none">
												{ posts[i].Title }
											</h2>
											if posts[i].Description != "" {
												<p class="hidden sm:block text-[13px] text-muted line-clamp-3 leading-relaxed mb-3">
													{ posts[i].Description }
												</p>
											}
											<div class="text-[10px] font-mono text-muted mt-auto pt-1 sm:pt-2">
												<time datetime={ posts[i].Date.Format("2006-01-02") }>{ fmtDate(posts[i], lang) }</time>
											</div>
										</div>
									</div>
								</a>
							</div>
						}
					}
				</div>
				<div class="lg:col-span-3 flex flex-col divide-y divide-[var(--c-border)] bg-bg order-3 lg:order-3">
					if len(posts) > 2 {
						<div class="px-5 sm:px-5 py-6 sm:py-6 flex flex-col">
							<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-accent mb-4 flex items-center gap-1.5">
								<span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
								if lang == "id" {
									TERKAIT
								} else {
									RELATED
								}
							</div>
							<div class="flex flex-col gap-5 sm:gap-6">
								for i := 2; i <= 3 && i < len(posts); i++ {
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[i].Slug) } class="group block">
										<div class="flex flex-row-reverse sm:flex-col items-start gap-4 sm:gap-0 justify-between">
											<div class="w-28 xs:w-32 sm:w-full aspect-[16/9] bg-surface overflow-hidden border border-border shrink-0 sm:mb-3">
												@postThumbnailImg(posts[i])
											</div>
											<div class="flex-1 min-w-0">
												<h3 class="display text-base sm:text-2xl font-bold text-text group-hover:text-link transition-colors leading-snug mb-1.5 line-clamp-3 sm:line-clamp-none">
													{ posts[i].Title }
												</h3>
												<div class="text-[11px] font-mono text-muted">
													<span>{ fmt.Sprintf("%d %s", posts[i].ReadTime, ui.Blog_MinRead) }</span>
												</div>
											</div>
										</div>
									</a>
								}
							</div>
						</div>
					}
					<div class="flex flex-col flex-1 bg-surface/30">
						<div class="flex items-center justify-between px-5 py-3.5 border-b border-border text-xs font-bold uppercase font-mono tracking-wider">
							<span class="text-text flex items-center gap-1.5">
								<span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
								if lang == "id" {
									POPULER
								} else {
									POPULAR
								}
							</span>
							<span class="text-[10px] text-muted font-normal lowercase">{ ui.Portal_TopViews }</span>
						</div>
						<div class="flex flex-col divide-y divide-border/40 px-5 sm:px-5 py-2">
							if len(popularPosts) == 0 {
								<div class="text-xs text-muted py-6 text-center">{ ui.Portal_NoPopPosts }</div>
							}
							for _, p := range popularPosts {
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group block py-4 sm:py-4">
									<div class="flex items-center justify-between mb-1.5">
										if len(p.Tags) > 0 {
											<span class="text-accent text-[10px] font-bold uppercase tracking-wider">
												{ p.Tags[0] }
											</span>
										}
										<time class="text-[10px] font-mono text-muted">{ fmtDayMonth(p.Date, lang) }</time>
									</div>
									<h4 class="display text-base sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug">
										{ p.Title }
									</h4>
								</a>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ portalTagHeroTop(ui i18n.UI, posts []post.Post, lang string, viewCounts map[string]int) {
	<div class="border-0 sm:border sm:border-border w-full mb-4 sm:mb-8 sm:mt-4 bg-bg flex flex-col">
		if len(posts) > 0 {
			<div class="w-full border-b border-border">
				<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
					<div class="lg:col-span-8 py-4 sm:p-4 lg:p-5 flex flex-col">
						@portalStrictLeadStory(ui, posts[0], lang, true)
					</div>
					<div class="lg:col-span-4 flex flex-col divide-y divide-[var(--c-border)]">
						for i := 1; i <= 2 && i < len(posts); i++ {
							<div class="py-4 sm:p-4 lg:p-5 flex-1 flex flex-col justify-center">
								@portalResponsiveTagSubStory(ui, posts[i], lang)
							</div>
						}
					</div>
				</div>
			</div>
		}
		if len(posts) > 3 {
			<div class="w-full">
				<div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--c-border)]">
					for i := 3; i <= 5 && i < len(posts); i++ {
						<div class="py-4 sm:p-4 lg:p-5">
							@portalResponsiveTagSubStory(ui, posts[i], lang)
						</div>
					}
				</div>
			</div>
		}
	</div>
}
