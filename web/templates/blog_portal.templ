package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ portalNewsLayout(ui i18n.UI, posts []post.Post, tagCounts map[string]int, lang string, viewCounts map[string]int) {
	{{
		// -------------------------------------------------------------
		// DYNAMIC CATEGORY AGGREGATION FOR 8 MONOLITHIC BOXES
		// -------------------------------------------------------------

		// Box 2 (4:4:4): Linux, Go/Backend, DevOps
		box2Cats := []CategorySection{
			getCategoryCluster(posts, "linux", []string{"linux", "kernel", "archlinux"}, 3),
			getCategoryCluster(posts, "go", []string{"go", "backend", "concurrency", "networking", "caddy"}, 3),
			getCategoryCluster(posts, "devops", []string{"devops", "cloud", "ci-cd", "automation"}, 3),
		}

		// Box 3 (Deep Dive 10-Card Mobile Carousel / 2-Col Desktop): 10 Curated Technical Clusters
		box3Cats := []CategorySection{
			getCategoryCluster(posts, "security", []string{"security", "zero-trust", "privacy", "ztna", "firewall", "openssl", "landlock"}, 2),
			getCategoryCluster(posts, "systems", []string{"systems", "rust", "compiler", "io-uring", "zig", "assembly"}, 2),
			getCategoryCluster(posts, "performance", []string{"performance", "cache", "memory", "cgroups", "pacing", "zstd"}, 2),
			getCategoryCluster(posts, "linux", []string{"linux", "kernel", "archlinux"}, 2),
			getCategoryCluster(posts, "go", []string{"go", "backend", "concurrency", "networking", "caddy"}, 2),
			getCategoryCluster(posts, "docker", []string{"docker", "podman", "containers", "containerd", "runc", "microvm", "firecracker"}, 2),
			getCategoryCluster(posts, "ai", []string{"ai", "llm", "quantization", "dpo", "agents"}, 2),
			getCategoryCluster(posts, "ebpf", []string{"ebpf", "tracing", "observability", "lsm"}, 2),
			getCategoryCluster(posts, "database", []string{"database", "sqlite", "duckdb", "clickhouse", "litestream", "valkey", "storage"}, 2),
			getCategoryCluster(posts, "tools", []string{"tools", "cli", "ripgrep", "fzf", "jq", "curl", "awk", "terminal"}, 2),
		}

		// Box 4 (8:4): Left (Performance, Docker) + Right (Live Wire Feed)
		box4LeftCats := []CategorySection{
			getCategoryCluster(posts, "performance", []string{"performance", "cache", "memory", "cgroups", "pacing", "zstd"}, 2),
			getCategoryCluster(posts, "docker", []string{"docker", "podman", "containers", "containerd", "runc", "microvm", "firecracker"}, 2),
		}
		var excludeSlugs []string
		for i := 0; i <= 8 && i < len(posts); i++ {
			excludeSlugs = append(excludeSlugs, posts[i].Slug)
		}
		box4WirePosts := getWirePosts(posts, excludeSlugs, 4)

		// Box 5 (3:3:3:3): Tools, Terminal, Database, Networking
		box5Cats := []CategorySection{
			getCategoryCluster(posts, "tools", []string{"tools", "cli", "ripgrep", "fzf", "jq", "curl", "awk", "ffmpeg"}, 2),
			getCategoryCluster(posts, "terminal", []string{"terminal", "tmux", "ghostty", "neovim", "helix", "zsh", "fish"}, 2),
			getCategoryCluster(posts, "database", []string{"database", "sqlite", "duckdb", "clickhouse", "litestream", "valkey", "storage"}, 2),
			getCategoryCluster(posts, "networking", []string{"networking", "wireguard", "tailscale", "ssh", "dns", "protocols"}, 2),
		}

		// Box 6 (7:5): Left (Architecture Essay) + Right (Spotlight Side Thumbs)
		box6Essay := getCategoryCluster(posts, "architecture", []string{"architecture", "philosophy", "reading", "design"}, 2)
		box6SidePosts := getWirePosts(posts, append(excludeSlugs, box6Essay.LeadPost.Slug), 3)

		// Box 7 (3:3:3:3 Dense Text): AI, eBPF, Debugging, Shell
		box7Cats := []CategorySection{
			getCategoryCluster(posts, "ai", []string{"ai", "llm", "quantization", "dpo", "agents"}, 3),
			getCategoryCluster(posts, "ebpf", []string{"ebpf", "tracing", "observability", "lsm"}, 3),
			getCategoryCluster(posts, "debugging", []string{"debugging", "dmesg", "strace", "lsof", "pprof"}, 3),
			getCategoryCluster(posts, "shell", []string{"shell", "bash", "scripting", "tips", "makefile", "cron", "systemd"}, 3),
		}
	}}

	// -----------------------------------------------------------------
	// THE 8-BOX CONTINUOUS MONOLITH (FUSED WIREFRAME GRID)
	// -----------------------------------------------------------------

	// 1. Tech Hero (3 : 6 : 3)
	@portalHeroTop(ui, posts, lang, viewCounts, true)

	// 2. Engineering Lab & Cockpit (3 : 3 : 3 : 3) - Interactive (Terminal, Top 5 Tags, RSS, Guestbook)
	@portalBox8Cockpit(ui, tagCounts, lang, len(posts))

	// 3. Tri-Column Core Topics (4 : 4 : 4)
	@portalCategoryTrio(ui, box2Cats, lang)

	// 4. Dual Deep Dive Spotlight (6 : 6)
	@portalDeepDive(ui, box3Cats, lang)

	// 5. Asymmetric Split River (8 : 4)
	@portalBox4SplitRiver(ui, box4LeftCats, box4WirePosts, lang)

	// 6. Quad Tooling Matrix (3 : 3 : 3 : 3)
	@portalBox5QuadMatrix(ui, box5Cats, lang)

	// 7. Asymmetric Essay Banner (7 : 5)
	@portalBox6EssayBanner(ui, box6Essay, box6SidePosts, lang)

	// 8. Dense Knowledge Index (3 : 3 : 3 : 3) - Pure Typography
	@portalBox7KnowledgeIndex(ui, box7Cats, lang)
}

templ portalHeroTop(ui i18n.UI, posts []post.Post, lang string, viewCounts map[string]int, showSidebarTabs bool) {
	{{
		var excludeSlugs []string
		for i := 0; i <= 4 && i < len(posts); i++ {
			excludeSlugs = append(excludeSlugs, posts[i].Slug)
		}
		popularPosts := getPopularPostsExcluding(posts, viewCounts, excludeSlugs, 3)
	}}
	// TECH EDITORIAL HERO (3:6:3 ASYMMETRIC GRID)
	<div class="border-0 sm:border-2 border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="w-full">
			<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
			
				// -------------------------------------------------------------
				// 1. LEFT COLUMN (3 cols / ~25%): TEXT-HEAVY LEAD DISPATCHES
				// -------------------------------------------------------------
				<div class="order-2 lg:order-1 lg:col-span-3 flex flex-col divide-y divide-[var(--c-border)] bg-bg">
					// Dispatch 1 (Lead Headline on Left)
					if len(posts) > 1 {
						<div class="px-5 sm:px-6 py-8 sm:py-8 lg:py-12 flex flex-col justify-between">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[1].Slug) } class="group block">
								if len(posts[1].Tags) > 0 {
									<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-2 inline-block">
										{ posts[1].Tags[0] }
									</span>
								}
								<h2 class="display text-lg sm:text-xl font-bold text-text group-hover:text-link transition-colors leading-snug mb-2">
									{ posts[1].Title }
								</h2>
								if posts[1].Description != "" {
									<p class="text-xs text-muted line-clamp-3 leading-relaxed mb-3">
										{ posts[1].Description }
									</p>
								}
								<div class="flex items-center gap-2 text-[10px] font-mono text-muted mt-auto pt-2 border-t border-border/30">
									<time datetime={ posts[1].Date.Format("2006-01-02") }>{ fmtDate(posts[1]) }</time>
									<span>·</span>
									<span>{ fmt.Sprintf("%d %s", posts[1].ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</a>
						</div>
					}

					// Dispatch 2 (Secondary Headline)
					if len(posts) > 2 {
						<div class="px-5 sm:px-6 py-8 sm:py-8 lg:py-12 flex flex-col justify-between">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[2].Slug) } class="group block">
								if len(posts[2].Tags) > 0 {
									<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-1.5 inline-block">
										{ posts[2].Tags[0] }
									</span>
								}
								<h3 class="display text-sm sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug mb-2">
									{ posts[2].Title }
								</h3>
								if posts[2].Description != "" {
									<p class="text-xs text-muted line-clamp-2 leading-relaxed mb-2">
										{ posts[2].Description }
									</p>
								}
								<div class="text-[10px] font-mono text-muted">
									<span>{ fmt.Sprintf("%d %s", posts[2].ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</a>
						</div>
					}

					// Dispatch 3 (Compact Headline)
					if len(posts) > 3 {
						<div class="px-5 sm:px-6 py-8 sm:py-8 lg:py-12 flex flex-col justify-between">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[3].Slug) } class="group block">
								if len(posts[3].Tags) > 0 {
									<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-1 inline-block">
										{ posts[3].Tags[0] }
									</span>
								}
								<h3 class="display text-sm sm:text-base font-bold text-text group-hover:text-link transition-colors leading-snug">
									{ posts[3].Title }
								</h3>
								<div class="text-[10px] font-mono text-muted mt-2">
									<span>{ fmt.Sprintf("%d %s", posts[3].ReadTime, ui.Blog_MinRead) }</span>
								</div>
							</a>
						</div>
					}
				</div>

				// -------------------------------------------------------------
				// 2. CENTER COLUMN (6 cols / ~50%): THE MAIN CENTERPIECE HERO STORY
				// -------------------------------------------------------------
				<div class="order-1 lg:order-2 lg:col-span-6 flex flex-col bg-bg">
					if len(posts) > 0 {
						// Visual Hero Image (Strict 16:9)
						<div class="relative w-full aspect-[16/9] bg-surface overflow-hidden border-b border-border">
							@postThumbnailImg(posts[0])
						</div>

						// Story Details below image
						<div class="px-5 sm:px-6 py-10 sm:py-12 lg:px-8 lg:py-14 flex flex-col flex-1">
							if len(posts[0].Tags) > 0 {
								<div class="flex items-center gap-2 mb-2.5">
									<span class="px-2 py-0.5 text-[10px] font-mono font-bold bg-accent/15 text-accent uppercase tracking-wider">
										{ posts[0].Tags[0] }
									</span>
								</div>
							}
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[0].Slug) } class="group block mb-3">
								<h1 class="display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text group-hover:text-link transition-colors leading-[1.15] tracking-tight">
									{ posts[0].Title }
								</h1>
							</a>
							if posts[0].Description != "" {
								<p class="text-sm sm:text-base text-muted line-clamp-3 leading-relaxed mb-5">
									{ posts[0].Description }
								</p>
							}
							<div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-muted mt-auto pt-4 border-t border-border/40">
								<div class="flex items-center gap-2">
									<span class="font-bold text-text">
										if posts[0].Author != "" {
											{ posts[0].Author }
										} else {
											daemontalk
										}
									</span>
									<span>·</span>
									<time datetime={ posts[0].Date.Format("2006-01-02") }>{ fmtDate(posts[0]) }</time>
								</div>
								<div class="text-text font-semibold">
									{ fmt.Sprintf("%d %s", posts[0].ReadTime, ui.Blog_MinRead) }
								</div>
							</div>
						</div>
					}
				</div>

				// -------------------------------------------------------------
				// 3. RIGHT COLUMN (3 cols / ~25%): FEATURE CARD + DEDUPLICATED POPULAR
				// -------------------------------------------------------------
				<div class="order-3 lg:order-3 lg:col-span-3 flex flex-col divide-y divide-[var(--c-border)] bg-bg">
					// Featured Card (Post 4) with flush image (Strict 16:9)
					if len(posts) > 4 {
						<div class="flex flex-col">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + posts[4].Slug) } class="group block">
								<div class="relative aspect-[16/9] w-full bg-surface overflow-hidden border-b border-border">
									@postThumbnailImg(posts[4])
								</div>
								<div class="px-5 sm:px-6 py-8 sm:py-8 lg:py-12">
									if len(posts[4].Tags) > 0 {
										<span class="text-accent text-[10px] font-bold uppercase tracking-wider mb-1.5 block">
											{ posts[4].Tags[0] }
										</span>
									}
									<h3 class="display text-[17px] font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2 mb-2">
										{ posts[4].Title }
									</h3>
									<div class="text-[11px] font-mono text-muted">
										{ fmt.Sprintf("%d %s", posts[4].ReadTime, ui.Blog_MinRead) }
									</div>
								</div>
							</a>
						</div>
					}

					// Deduplicated Popular News List ( "In Case You Missed It" style)
					<div class="flex flex-col flex-1 bg-surface/30">
						// Header
						<div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-surface text-xs font-bold uppercase font-mono tracking-wider">
							<div class="flex items-center gap-1.5 text-accent">
								<span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
								if lang == "id" {
									POPULER
								} else {
									POPULAR DISPATCHES
								}
							</div>
							<span class="text-[10px] text-muted font-normal lowercase font-mono">top views</span>
						</div>

						// Deduplicated Content List with 16:9 Mini Thumbnails
						<div class="px-3 sm:px-4 py-5 sm:py-6 flex flex-col divide-y divide-border/40">
							if len(popularPosts) == 0 {
								<div class="text-xs text-muted py-3 text-center">No additional popular posts</div>
							}
							for _, p := range popularPosts {
								<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + p.Slug) } class="group py-5 sm:py-6 flex items-start justify-between gap-3 sm:gap-4 text-text visited:text-visited">
									<div class="flex-1 min-w-0">
										if len(p.Tags) > 0 {
											<span class="text-accent text-[10px] font-bold uppercase tracking-wider block mb-1">
												{ p.Tags[0] }
											</span>
										}
										<h4 class="display text-[15px] font-bold group-hover:text-link transition-colors leading-snug line-clamp-3">
											{ p.Title }
										</h4>
										<div class="text-[11px] font-mono text-muted mt-1.5">
											{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }
										</div>
									</div>
									<div class="w-20 sm:w-24 aspect-[16/9] shrink-0 overflow-hidden border border-border bg-surface">
										@postThumbnailImg(p)
									</div>
								</a>
							}
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
}

templ portalTagHeroTop(ui i18n.UI, posts []post.Post, lang string, viewCounts map[string]int) {
	<div class="border-0 sm:border-2 sm:border-border w-full mb-4 sm:mb-8 sm:mt-4 bg-bg flex flex-col">
		
		// ROW 1: 1 Big Left, 2 Stacked Right
		if len(posts) > 0 {
			<div class="w-full border-b border-border">
				<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--c-border)]">
					
					// LEFT COLUMN (65% -> 8 cols) - 1 Big Post
					<div class="lg:col-span-8 py-4 sm:p-4 lg:p-5 flex flex-col">
						@portalStrictLeadStory(ui, posts[0], lang, true)
					</div>

					// RIGHT COLUMN (35% -> 4 cols) - 2 Posts
					<div class="lg:col-span-4 flex flex-col divide-y divide-[var(--c-border)]">
						for i := 1; i <= 2 && i < len(posts); i++ {
							<div class="py-4 sm:p-4 lg:p-5 flex-1 flex flex-col justify-center">
								@portalResponsiveTagSubStory(ui, posts[i], lang)
							</div>
						}
					</div>

				</div>
			</div>
		}

		// ROW 2: 3 Posts (Boxes from left to right)
		if len(posts) > 3 {
			<div class="w-full">
				<div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--c-border)]">
					for i := 3; i <= 5 && i < len(posts); i++ {
						<div class="py-4 sm:p-4 lg:p-5">
							@portalResponsiveTagSubStory(ui, posts[i], lang)
						</div>
					}
				</div>
			</div>
		}
	</div>
}
