package templates

templ AdminForbidden() {
	<div id="admin-forbidden" class="max-w-md mx-auto px-6 py-24 text-center">
		<h1 class="text-lg font-semibold text-text mb-2">Unauthorized Access</h1>
		<p class="text-sm text-muted mb-4">Authenticate with your admin token:</p>
		<code class="block text-xs font-mono text-text bg-surface border border-border rounded-none px-3 py-2 mb-6">/admin?admin=YOUR_SECRET_TOKEN</code>
		<a href="/" class="inline-flex items-center gap-1.5 text-sm text-link hover:underline">
			@iconArrowLeft()
			<span>Back to site</span>
		</a>
	</div>
}
