package forum

import (
	"fmt"

	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"daemontalk/web/templates/components"
)

templ IndexPage(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	topics []*forum.Topic,
	selectedTag string,
	sortOrder string,
	searchQuery string,
	author string,
	totalCount int,
	page int,
	totalPages int,
	activeTopic *forum.Topic,
	activeReplies []*forum.Reply,
	isDetailView bool,
) {
	<section class="container-page !px-0 sm:!px-6 lg:!px-8 py-0 sm:py-3 lg:py-4 h-full flex-1 min-h-0 flex flex-col">
		<div class="border-0 sm:border border-border bg-surface w-full h-full flex-1 min-h-0 flex flex-col overflow-hidden font-sans">
			<div
				class={
					"border-b border-border bg-surface px-4 py-2 sm:px-6 sm:py-2.5 items-center justify-between gap-4 text-xs font-sans select-none flex-wrap shrink-0",
					templ.KV("hidden lg:flex", isDetailView),
					templ.KV("flex", !isDetailView),
				}
			>
				<div class="flex items-center gap-3 overflow-x-auto text-xs font-sans font-medium">
					<a
						href={ templ.SafeURL(getFilterURL(prefix(lang), selectedTag, "latest")) }
						class={
							"transition-colors tracking-wider",
							templ.KV("text-text font-bold underline underline-offset-4 decoration-text", sortOrder == "latest" || sortOrder == ""),
							templ.KV("text-muted hover:text-text", sortOrder != "latest" && sortOrder != ""),
						}
					>
						threads
					</a>
					<span class="text-border select-none">/</span>
					<a
						href={ templ.SafeURL(getFilterURL(prefix(lang), selectedTag, "unsolved")) }
						class={
							"transition-colors tracking-wider",
							templ.KV("text-text font-bold underline underline-offset-4 decoration-text", sortOrder == "unsolved"),
							templ.KV("text-muted hover:text-text", sortOrder != "unsolved"),
						}
					>
						unsolved
					</a>
					<span class="text-border select-none">/</span>
					<a
						href={ templ.SafeURL(getFilterURL(prefix(lang), selectedTag, "votes")) }
						class={
							"transition-colors tracking-wider",
							templ.KV("text-text font-bold underline underline-offset-4 decoration-text", sortOrder == "votes"),
							templ.KV("text-muted hover:text-text", sortOrder != "votes"),
						}
					>
						top votes
					</a>
				</div>
				<a
					href={ templ.SafeURL(prefix(lang) + "/socket/new") }
					class="btn btn-secondary btn-sm shrink-0"
				>
					<span>+</span>
					<span>{ ui.Discussions_New }</span>
				</a>
			</div>
			<div class="grid grid-rows-1 grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border flex-1 min-h-0 h-full overflow-hidden">
				<div
					class={
						"lg:col-span-5 xl:col-span-4 flex flex-col bg-surface min-h-0 h-full overflow-hidden",
						templ.KV("hidden lg:flex", isDetailView),
						templ.KV("flex", !isDetailView),
					}
				>
					<div id="socket-topics-list" class="flex-1 min-h-0 overflow-y-auto divide-y divide-border/40 [scrollbar-width:thin]">
						if len(topics) == 0 {
							<div class="p-8 text-center font-sans">
								<p class="text-xs font-bold text-text mb-1">No Topics Found</p>
								<p class="text-[11px] text-muted mb-3">Start the first technical discussion.</p>
								<a
									href={ templ.SafeURL(prefix(lang) + "/socket/new") }
									class="inline-flex items-center gap-1 text-xs font-sans text-link hover:underline font-bold"
								>
									<span>+ New Topic</span>
									@components.IconArrowRight("w-3 h-3")
								</a>
							</div>
						} else {
							for _, t := range topics {
								@TopicRow(ui, lang, t, activeTopic != nil && activeTopic.ID == t.ID)
							}
						}
					</div>
					if totalPages > 1 {
						<div class="border-t border-border bg-surface px-4 py-2 sm:py-2.5 flex items-center justify-between text-[11px] font-sans text-muted select-none shrink-0 mt-auto">
							if page > 1 {
								<a
									href={ templ.SafeURL(getPageURL(prefix(lang), selectedTag, sortOrder, page-1)) }
									class="inline-flex items-center gap-1 text-text hover:text-link font-bold"
								>
									@components.IconArrowLeft("w-3 h-3")
									<span>PREV</span>
								</a>
							} else {
								<div></div>
							}
							<span>{ fmt.Sprintf("%d / %d", page, totalPages) }</span>
							if page < totalPages {
								<a
									href={ templ.SafeURL(getPageURL(prefix(lang), selectedTag, sortOrder, page+1)) }
									class="inline-flex items-center gap-1 text-text hover:text-link font-bold"
								>
									<span>NEXT</span>
									@components.IconArrowRight("w-3 h-3")
								</a>
							}
						</div>
					}
				</div>
				<div
					id="socket-detail-pane"
					class={
						"lg:col-span-7 xl:col-span-8 flex flex-col min-h-0 h-full overflow-y-auto bg-surface [scrollbar-width:thin]",
						templ.KV("hidden lg:flex", !isDetailView),
						templ.KV("flex", isDetailView),
					}
				>
					if activeTopic != nil {
						@TopicPane(ui, lang, currentUser, activeTopic, activeReplies)
					} else {
						@EmptyPane(ui, lang)
					}
				</div>
			</div>
		</div>
	</section>
	@socketShortcutsScript()
}

templ DiscussionsIndexPage(
	ui i18n.UI,
	lang string,
	currentUser *auth.User,
	topics []*forum.Topic,
	selectedTag string,
	sortOrder string,
	searchQuery string,
	author string,
	totalCount int,
	page int,
	totalPages int,
	activeTopic *forum.Topic,
	activeReplies []*forum.Reply,
	isDetailView bool,
) {
	@IndexPage(ui, lang, currentUser, topics, selectedTag, sortOrder, searchQuery, author, totalCount, page, totalPages, activeTopic, activeReplies, isDetailView)
}

templ TopicRow(ui i18n.UI, lang string, t *forum.Topic, isActive bool) {
	<div
		id={ fmt.Sprintf("topic-row-%d", t.ID) }
		data-topic-id={ fmt.Sprintf("%d", t.ID) }
		data-topic-slug={ t.Slug }
		class={
			"topic-row transition-colors select-none group",
			templ.KV("bg-bg", isActive),
			templ.KV("hover:bg-bg/60", !isActive),
		}
	>
		<a
			href={ templ.SafeURL(prefix(lang) + "/socket/" + t.Slug) }
			hx-get={ templ.SafeURL(prefix(lang) + "/socket/" + t.Slug) }
			hx-target="#socket-detail-pane"
			hx-swap="innerHTML"
			hx-push-url="true"
			onclick="if (window.innerWidth < 1024) { window.location.href = this.getAttribute('href'); return false; } selectSocketTopicRow(this);"
			class="block p-4 sm:px-6 sm:py-4.5 w-full min-w-0 space-y-2 cursor-pointer"
		>
			<h3 class="font-bold text-sm sm:text-base leading-snug text-text group-hover:text-link transition-colors line-clamp-2">
				if t.IsSolved {
					<span class="text-emerald-500 font-sans font-bold text-xs sm:text-sm mr-1.5 select-none">✓</span>
				}
				{ t.Title }
			</h3>
			<div class="flex items-center gap-1.5 sm:gap-2 text-xs sm:text-[13px] font-sans text-muted flex-wrap">
				<time datetime={ t.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">
					{ timeAgoOrDate(t.CreatedAt, lang) }
				</time>
				<span class="text-muted/30">·</span>
				if t.AuthorUsername != "" && t.AuthorUsername != "ghost" {
					<span>{ "@" + t.AuthorUsername }</span>
				} else {
					<span>{ t.AuthorName }</span>
				}
				<span class="text-muted/30">·</span>
				<span>
					{ fmt.Sprintf("%d replies", t.RepliesCount) }
				</span>
				if t.VotesCount > 0 {
					<span class="text-muted/30">·</span>
					<span>
						{ fmt.Sprintf("%d upvotes", t.VotesCount) }
					</span>
				}
			</div>
		</a>
	</div>
}

templ DiscussionsTopicRow(ui i18n.UI, lang string, t *forum.Topic, isActive bool) {
	@TopicRow(ui, lang, t, isActive)
}

templ socketShortcutsScript() {
	<script>
		function selectSocketTopicRow(linkEl) {
			document.querySelectorAll('.topic-row').forEach(function(row) {
				row.classList.remove('bg-bg');
			});
			var parentRow = linkEl.closest('.topic-row');
			if (parentRow) {
				parentRow.classList.add('bg-bg');
			}
			var pane = document.getElementById('socket-detail-pane');
			if (pane) {
				pane.scrollTop = 0;
			}
		}

		document.addEventListener('DOMContentLoaded', function() {
			document.addEventListener('keydown', function(e) {
				if (e.target.matches('input, textarea, select')) return;
				if (e.metaKey || e.ctrlKey || e.altKey) return;

				if (e.key === 'r') {
					var replyForm = document.getElementById('reply-form');
					if (replyForm) {
						e.preventDefault();
						replyForm.scrollIntoView({ behavior: 'smooth' });
						var ta = replyForm.querySelector('textarea');
						if (ta) ta.focus();
					}
				} else if (e.key === 'j' || e.key === 'k') {
					var rows = Array.from(document.querySelectorAll('.topic-row a[hx-get]'));
					if (rows.length === 0) return;
					var activeIdx = rows.findIndex(function(a) {
						return a.closest('.topic-row').classList.contains('bg-bg');
					});
					if (activeIdx === -1) activeIdx = 0;
					var nextIdx = e.key === 'j' ? activeIdx + 1 : activeIdx - 1;
					if (nextIdx >= 0 && nextIdx < rows.length) {
						e.preventDefault();
						rows[nextIdx].click();
						rows[nextIdx].scrollIntoView({ block: 'nearest' });
					}
				}
			});
		});
	</script>
}
