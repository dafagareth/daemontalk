package templates

templ colophonKpis(lang string) {
	<div class="hidden sm:block border-b border-border bg-surface/20">
		<div class="grid grid-cols-3 divide-x divide-border border-b border-border">
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "WAKTU RESPONS" }
					} else {
						{ "LATENCY" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						&lt; 2ms
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						TTFB
					</div>
				</div>
			</div>
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "UKURAN BINER" }
					} else {
						{ "BINARY SIZE" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						~14MB
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						if lang == "id" {
							Biner Mandiri
						} else {
							Static Binary
						}
					</div>
				</div>
			</div>
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "PENGGUNAAN MEMORI" }
					} else {
						{ "MEMORY FOOTPRINT" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						~18MB
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						if lang == "id" {
							Beban Saat Idle
						} else {
							Idle RAM Load
						}
					</div>
				</div>
			</div>
		</div>
		<div class="grid grid-cols-3 divide-x divide-border">
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "MESIN UTAMA" }
					} else {
						{ "CORE ENGINE" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						Go 1.24
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						Chi, Templ, Tailwind
					</div>
				</div>
			</div>
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "PENYIMPANAN DATA" }
					} else {
						{ "DATA STORE" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						SQLite
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						Pure-Go WAL
					</div>
				</div>
			</div>
			<div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-hover/30 transition-colors">
				<span class="text-xs uppercase tracking-wider text-muted font-semibold font-sans">
					if lang == "id" {
						{ "PRIVASI" }
					} else {
						{ "PRIVACY" }
					}
				</span>
				<div class="my-2 sm:my-3">
					<div class="text-3xl lg:text-4xl font-bold tracking-tight text-text tabular-nums font-sans">
						0
					</div>
					<div class="text-xs text-muted mt-1 font-sans">
						if lang == "id" {
							Cookie & Pelacak
						} else {
							Cookies & Trackers
						}
					</div>
				</div>
			</div>
		</div>
