package templates

import "daemontalk/internal/project"

templ colophonSpecs() {
	<div class="mt-10 sm:mt-0 grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border font-sans text-xs sm:text-sm border-b border-border/40 sm:border-border pb-2 sm:pb-0">
		<div class="divide-y divide-border/40 sm:divide-border/60">
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">{ "Platform & Host" }</span>
				<span class="font-medium text-text text-right">Linux x86_64 VPS</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Reverse Proxy</span>
				<span class="font-medium text-text text-right">Caddy 2 (TLS 1.3)</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Storage Engine</span>
				<span class="font-medium text-text text-right">Pure-Go SQLite, NVMe Disk</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">External Daemons</span>
				<span class="font-medium text-text text-right">Zero External Dependencies</span>
			</div>
		</div>
		<div class="divide-y divide-border/40 sm:divide-border/60">
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Typography</span>
				<span class="font-medium text-text text-right">Lora (Serif), Sans-serif UI</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Lisensi Kode</span>
				<span class="font-medium text-text text-right">MIT License</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Lisensi Tulisan</span>
				<span class="font-medium text-text text-right">CC BY-NC-SA 4.0</span>
			</div>
			<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
				<span class="text-muted">Maintainer</span>
				<a href="https://github.com/dafagareth" target="_blank" rel="noopener noreferrer" class="font-medium text-text hover:underline text-right inline-flex items-center gap-1">
					<span>Dafa Gareth (@dafagareth)</span>
					@IconArrowUpRight("w-3 h-3")
				</a>
			</div>
		</div>
	</div>
}

templ colophonProjects(lang string, projects []project.Project) {
	<div id="projects" class="mt-10 sm:mt-0">
		<div class="px-0 sm:px-6 py-3 sm:py-3.5 bg-transparent sm:bg-surface/40 border-b border-border/40 sm:border-border flex items-center justify-between font-sans">
			<span class="font-bold text-text uppercase tracking-wider text-xs font-sans">
				if lang == "id" {
					{ "PROYEK" }
				} else {
					{ "PROJECTS" }
				}
			</span>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border font-sans border-b border-border/40 sm:border-border pb-2 sm:pb-0">
			for _, p := range projects {
				<div class="p-0 py-6 sm:p-6 lg:p-7 flex flex-col justify-between gap-4 bg-transparent sm:bg-surface/10 hover:sm:bg-surface/25 transition-colors group">
					<div class="space-y-2">
						<div class="flex items-center justify-between gap-2">
							if p.RepoURL != "" {
								<a
									href={ templ.SafeURL(p.RepoURL) }
									target="_blank"
									rel="noopener noreferrer"
									class="font-bold text-sm sm:text-base text-text hover:underline font-sans inline-flex items-center gap-1.5 group-hover:text-link transition-colors"
								>
									<span>{ p.Name }</span>
									@IconArrowUpRight("w-3.5 h-3.5 text-muted")
								</a>
							} else {
								<h3 class="font-bold text-sm sm:text-base text-text font-sans">
									{ p.Name }
								</h3>
							}
							<span class="px-2 py-0.5 border border-border bg-chip text-muted text-xs uppercase tracking-wider font-sans">
								{ string(p.Status) }
							</span>
						</div>
						<p class="text-xs sm:text-sm text-muted leading-relaxed font-sans line-clamp-2">
							if lang == "id" && p.DescriptionID != "" {
								{ p.DescriptionID }
							} else {
								{ p.Description }
							}
						</p>
					</div>
					<div class="space-y-3 pt-2 border-t border-border/40 font-sans">
						<div class="flex items-center gap-1.5 flex-wrap text-xs text-muted font-sans">
							for _, tech := range p.TechStack {
								<span class="px-2 py-0.5 bg-chip text-muted border border-border/40 text-xs font-sans">{ tech }</span>
							}
						</div>
						<div class="flex items-center gap-4 text-xs font-sans font-medium">
							if p.RepoURL != "" {
								<a href={ templ.SafeURL(p.RepoURL) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-text hover:underline font-medium font-sans">
									@IconGitHub()
									<span>GitHub</span>
									<span class="text-[10px]">↗</span>
								</a>
							}
							if p.DemoURL != "" {
								<a href={ templ.SafeURL(p.DemoURL) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-muted hover:text-text hover:underline font-sans">
									<span>{ demoLabel(p.DemoURL) }</span>
									@IconArrowUpRight("w-3 h-3")
								</a>
							}
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

templ colophonContacts(lang string) {
	<div class="mt-10 sm:mt-0">
		<div class="px-0 sm:px-6 py-3 sm:py-3.5 bg-transparent sm:bg-surface/40 border-b border-border/40 sm:border-border flex items-center justify-between font-sans">
			<span class="font-bold text-text uppercase tracking-wider text-xs font-sans">
				if lang == "id" {
					{ "SALURAN KONTAK" }
				} else {
					{ "CONTACT CHANNELS" }
				}
			</span>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border font-sans text-xs sm:text-sm">
			<div class="divide-y divide-border/40 sm:divide-border/60">
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Surel Langsung
						} else {
							Direct Email
						}
					</span>
					<a href="mailto:realdaemontalk@gmail.com" class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>realdaemontalk@gmail.com</span>
						@IconArrowUpRight("w-3 h-3")
					</a>
				</div>
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Forum Diskusi
						} else {
							Discussion Forum
						}
					</span>
					<a href={ templ.SafeURL(prefix(lang) + "/socket") } class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>/socket</span>
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Profil GitHub
						} else {
							GitHub Profile
						}
					</span>
					<a href="https://github.com/dafagareth" target="_blank" rel="noopener noreferrer" class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>github.com/dafagareth</span>
						@IconArrowUpRight("w-3 h-3")
					</a>
				</div>
			</div>
			<div class="divide-y divide-border/40 sm:divide-border/60">
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Kode Sumber
						} else {
							Source Repository
						}
					</span>
					<a href="https://github.com/dafagareth/daemontalk" target="_blank" rel="noopener noreferrer" class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>dafagareth/daemontalk</span>
						@IconArrowUpRight("w-3 h-3")
					</a>
				</div>
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Umpan Sindikasi
						} else {
							Syndication Feed
						}
					</span>
					<a href={ templ.SafeURL(prefix(lang) + "/rss.xml") } class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>/rss.xml</span>
						@IconArrowUpRight("w-3 h-3")
					</a>
				</div>
				<div class="flex items-center justify-between px-0 sm:px-6 py-3.5 hover:bg-surface/30 transition-colors">
					<span class="text-muted">
						if lang == "id" {
							Statistik Sistem
						} else {
							Live Statistics
						}
					</span>
					<a href={ templ.SafeURL(prefix(lang) + "/stats") } class="font-medium text-text hover:underline inline-flex items-center gap-1">
						<span>/stats</span>
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
			</div>
		</div>
	</div>
}
