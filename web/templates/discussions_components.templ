package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsVoteButton(targetType string, targetID int64, count int, hasVoted bool) {
	<form
		hx-post="/socket/vote"
		hx-swap="outerHTML"
		class="inline-flex items-center"
	>
		<input type="hidden" name="type" value={ targetType }/>
		<input type="hidden" name="id" value={ fmt.Sprintf("%d", targetID) }/>
		if targetType == "topic" {
			<button
				type="submit"
				class={
					"flex flex-col items-center justify-center min-w-[32px] sm:min-w-[38px] px-1 py-1 sm:px-1.5 sm:py-1.5 rounded-none border-0 sm:border text-xs font-mono font-bold transition-all cursor-pointer select-none group",
					templ.KV("sm:border-link/70 sm:bg-link/15 text-link", hasVoted),
					templ.KV("sm:border-border sm:bg-surface text-muted hover:text-text sm:hover:border-text/40 sm:hover:bg-hover", !hasVoted),
				}
				title="Upvote"
			>
				<svg class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-8 8h5v8h6v-8h5z"/></svg>
				<span class="leading-none mt-1 font-mono text-[11px]">{ fmt.Sprintf("%d", count) }</span>
			</button>
		} else {
			<button
				type="submit"
				class={
					"flex items-center gap-1.5 py-1 px-2 border-0 sm:border text-xs font-mono font-bold transition-colors cursor-pointer select-none group",
					templ.KV("sm:border-link/70 sm:bg-link/15 text-link", hasVoted),
					templ.KV("sm:border-border sm:bg-surface text-muted hover:text-text sm:hover:border-text/40 sm:hover:bg-hover", !hasVoted),
				}
				title="Upvote"
			>
				<svg class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-8 8h5v8h6v-8h5z"/></svg>
				<span class="leading-none font-mono text-[11px]">{ fmt.Sprintf("%d", count) }</span>
			</button>
		}
	</form>
}

templ DiscussionsCategoryBadge(category string) {
	switch category {
		case "qna":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#qna</span>
		case "architecture":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#arch</span>
		case "kernel":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#kernel</span>
		case "go":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#go</span>
		case "incident":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#rca</span>
		default:
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#{ category }</span>
	}
}

templ DiscussionsReplyItem(ui i18n.UI, lang string, currentUser *auth.User, r *forum.Reply, topicID int64, topicOwnerID int64) {
	{{
		isTopicOwnerOrAdmin := currentUser != nil && (currentUser.ID == topicOwnerID || currentUser.Role == "admin")
		isReplyOwnerOrAdmin := currentUser != nil && (currentUser.ID == r.UserID || currentUser.Role == "admin")
		hasMenu := isTopicOwnerOrAdmin || isReplyOwnerOrAdmin
	}}
	<div
		id={ fmt.Sprintf("reply-%d", r.ID) }
		class={
			"py-4 px-4 sm:p-5 space-y-3 transition-colors",
			templ.KV("bg-emerald-500/[0.04] border-l-2 border-emerald-500 pl-4 sm:pl-6", r.IsSolution),
		}
	>
		<div class="flex items-center justify-between gap-3 text-xs font-mono text-muted">
			<div class="flex items-center gap-2.5 min-w-0">
				if r.AuthorAvatar != "" {
					<img src={ r.AuthorAvatar } alt={ r.AuthorUsername } class="w-6 h-6 sm:w-7 sm:h-7 rounded-none border border-muted/30 object-cover shrink-0"/>
				} else {
					<img src="/static/images/deleted-user.png" alt="Deleted User" class="w-6 h-6 sm:w-7 sm:h-7 rounded-none border border-muted/30 object-cover shrink-0"/>
				}
				if r.AuthorGitHub != "" {
					<a href={ templ.SafeURL(r.AuthorGitHub) } target="_blank" rel="noopener" class="font-bold text-text hover:text-link hover:underline truncate text-sm sm:text-base">
						{ "@" + r.AuthorUsername }
					</a>
				} else {
					<span class="font-bold text-text truncate text-sm sm:text-base">{ r.AuthorName }</span>
				}
				<span class="text-muted/40">·</span>
				<time datetime={ r.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time shrink-0">
					{ timeAgoOrDate(r.CreatedAt, lang) }
				</time>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				if r.IsSolution {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-text text-bg font-mono font-bold text-[10px] sm:text-xs uppercase tracking-wider select-none shadow-sm">
						<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
						<span>
							if lang == "id" {
								SOLUSI
							} else {
								SOLUTION
							}
						</span>
					</span>
				}
				if hasMenu {
					<details class="relative comment-menu">
						<summary class="p-1.5 -m-1 text-muted hover:text-text focus:outline-none cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-center transition-colors" title="Options">
							<svg xmlns="http://www.w3.org/2005/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
						</summary>
						<div class="absolute right-0 mt-2 w-44 bg-surface border border-muted/30 shadow-2xl z-20 font-mono text-xs overflow-hidden py-1">
							if isTopicOwnerOrAdmin && !r.IsSolution {
								<button
									hx-post={ fmt.Sprintf("/socket/%d/solve?reply_id=%d", topicID, r.ID) }
									class="w-full text-left px-3.5 py-2 hover:bg-hover hover:text-emerald-400 transition-colors cursor-pointer text-text flex items-center gap-2"
									onclick="this.closest('details').removeAttribute('open')"
								>
									<svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
									<span>
										if lang == "id" {
											Jadikan Solusi
										} else {
											Mark Solution
										}
									</span>
								</button>
							}
							if isTopicOwnerOrAdmin && r.IsSolution {
								<button
									hx-post={ fmt.Sprintf("/socket/%d/solve?reply_id=0", topicID) }
									class="w-full text-left px-3.5 py-2 hover:bg-hover hover:text-rose-400 transition-colors cursor-pointer text-text flex items-center gap-2"
									onclick="this.closest('details').removeAttribute('open')"
								>
									<svg class="w-3.5 h-3.5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
									<span>
										if lang == "id" {
											Batalkan Solusi
										} else {
											Unmark Solution
										}
									</span>
								</button>
							}
							if isReplyOwnerOrAdmin {
								<form
									hx-post={ fmt.Sprintf("/socket/reply/%d/delete", r.ID) }
									if lang == "id" {
										hx-confirm="Yakin ingin menghapus komentar balasan ini?"
									} else {
										hx-confirm="Are you sure you want to delete this reply?"
									}
									class="block"
								>
									<button
										type="submit"
										class="w-full text-left px-3.5 py-2 hover:bg-hover hover:text-rose-500 transition-colors cursor-pointer text-text flex items-center gap-2 border-t border-muted/20"
										onclick="this.closest('details').removeAttribute('open')"
									>
										<svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
										<span>
											if lang == "id" {
												Hapus
											} else {
												Delete
											}
										</span>
									</button>
								</form>
							}
						</div>
					</details>
				}
			</div>
		</div>
		<div class="prose max-w-none text-text text-sm sm:text-base leading-relaxed font-sans">
			@templ.Raw(string(r.BodyHTML))
		</div>
		<div class="flex items-center justify-between pt-1 text-xs font-mono">
			<div>
				@DiscussionsVoteButton("reply", r.ID, r.VotesCount, r.UserVoted)
			</div>
			<div>
				<button
					type="button"
					data-target-id={ fmt.Sprintf("inline-reply-form-%d", r.ID) }
					onclick="var target = this.getAttribute('data-target-id'); var el = document.getElementById(target); if(el){ el.classList.remove('hidden'); var ta = el.querySelector('textarea'); if(ta){ ta.focus(); } }"
					class="text-muted hover:text-text hover:underline cursor-pointer font-semibold font-mono text-xs"
				>
					if lang == "id" {
						Balas
					} else {
						Reply
					}
				</button>
			</div>
		</div>
		<div id={ fmt.Sprintf("inline-reply-form-%d", r.ID) } class="hidden mt-4 pt-3 border-t border-dashed border-muted/30">
			if currentUser != nil {
				<form
					hx-post={ fmt.Sprintf("/socket/%d/reply", topicID) }
					hx-target={ fmt.Sprintf("#replies-children-%d", r.ID) }
					hx-swap="beforeend"
					class="space-y-3"
				>
					<input type="hidden" name="parent_id" value={ fmt.Sprintf("%d", r.ID) }/>
					<textarea
						name="body"
						rows="3"
						required
						if lang == "id" {
							placeholder={ fmt.Sprintf("Tulis balasan untuk @%s...", r.AuthorUsername) }
						} else {
							placeholder={ fmt.Sprintf("Write reply to @%s...", r.AuthorUsername) }
						}
						class="w-full p-2.5 text-xs font-mono bg-bg border border-border text-text placeholder-muted focus:border-[var(--c-link)] focus:outline-none"
					></textarea>
					<div class="flex justify-end gap-2">
						<button
							type="button"
							data-target-id={ fmt.Sprintf("inline-reply-form-%d", r.ID) }
							onclick="var target = this.getAttribute('data-target-id'); var el = document.getElementById(target); if(el) el.classList.add('hidden');"
							class="px-2.5 py-1 text-xs font-mono text-muted hover:text-text cursor-pointer"
						>
							if lang == "id" {
								Batal
							} else {
								Cancel
							}
						</button>
						<button
							type="submit"
							class="px-3 py-1 bg-text text-bg text-xs font-mono font-bold hover:opacity-90 cursor-pointer"
						>
							if lang == "id" {
								Kirim Balasan
							} else {
								Submit Reply
							}
						</button>
					</div>
				</form>
			} else {
				<div class="p-3 bg-surface border border-border text-xs font-mono text-muted flex items-center justify-between">
					if lang == "id" {
						<span>Masuk dengan GitHub untuk membalas komentar ini.</span>
					} else {
						<span>Sign in with GitHub to reply to this comment.</span>
					}
					<a href={ templ.SafeURL("/auth/github?return_to=" + fmt.Sprintf("/socket/%d", topicID)) } class="inline-flex items-center gap-1 text-link hover:underline font-bold">
						if lang == "id" {
							<span>Login GitHub</span>
						} else {
							<span>Sign in GitHub</span>
						}
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
			}
		</div>
		<div id={ fmt.Sprintf("replies-children-%d", r.ID) } class="mt-3 space-y-3 pl-3 sm:pl-5 border-l border-muted/25">
			for _, child := range r.Children {
				@DiscussionsReplyItem(ui, lang, currentUser, child, topicID, topicOwnerID)
			}
		</div>
	</div>
}
