package templates

import (
	"daemontalk/internal/auth"
	"daemontalk/internal/forum"
	"daemontalk/internal/i18n"
	"fmt"
)

templ DiscussionsVoteButton(targetType string, targetID int64, count int, hasVoted bool) {
	<form
		hx-post="/socket/vote"
		hx-swap="outerHTML"
		class="inline-flex items-center"
	>
		<input type="hidden" name="type" value={ targetType }/>
		<input type="hidden" name="id" value={ fmt.Sprintf("%d", targetID) }/>
		<button
			type="submit"
			class={
				"flex flex-col sm:flex-row items-center justify-center gap-0.5 sm:gap-1.5 py-1 px-1.5 text-xs font-mono font-bold transition-colors cursor-pointer select-none group",
				templ.KV("text-link font-black", hasVoted),
				templ.KV("text-muted hover:text-text", !hasVoted),
			}
			title="Upvote"
		>
			<span class="text-xs group-hover:-translate-y-0.5 transition-transform leading-none">▲</span>
			<span class="leading-none">{ fmt.Sprintf("%d", count) }</span>
		</button>
	</form>
}

templ DiscussionsCategoryBadge(category string) {
	switch category {
		case "qna":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#qna</span>
		case "architecture":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#arch</span>
		case "kernel":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#kernel</span>
		case "go":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#go</span>
		case "incident":
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#rca</span>
		default:
			<span class="text-accent font-mono text-xs font-bold uppercase tracking-wider">#{ category }</span>
	}
}

templ DiscussionsReplyItem(ui i18n.UI, lang string, currentUser *auth.User, r *forum.Reply, topicID int64, topicOwnerID int64) {
	<div
		id={ fmt.Sprintf("reply-%d", r.ID) }
		class="py-4 px-0 sm:p-5 space-y-2.5"
	>
		<div class="flex items-center justify-between gap-3 text-xs font-mono text-muted flex-wrap">
			<div class="flex items-center gap-2">
				if r.AuthorAvatar != "" {
					<img src={ r.AuthorAvatar } alt={ r.AuthorUsername } class="w-4 h-4 rounded-none border border-border object-cover"/>
				} else {
					<img src="/static/images/deleted-user.png" alt="Deleted User" class="w-4 h-4 rounded-none border border-border object-cover"/>
				}
				if r.AuthorGitHub != "" {
					<a href={ templ.SafeURL(r.AuthorGitHub) } target="_blank" rel="noopener" class="font-bold text-text hover:text-link hover:underline">
						{ "@" + r.AuthorUsername }
					</a>
				} else {
					<span class="font-bold text-text">{ r.AuthorName }</span>
				}
				<span>·</span>
				<time datetime={ r.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">
					{ timeAgoOrDate(r.CreatedAt, lang) }
				</time>
			</div>
			<div class="flex items-center gap-2">
				if r.IsSolution {
					<span class="text-link text-xs font-bold font-mono">
						if lang == "id" {
							[✓ SOLUSI]
						} else {
							[✓ SOLUTION]
						}
					</span>
					if currentUser != nil && (currentUser.ID == topicOwnerID || currentUser.Role == "admin") {
						<button
							hx-post={ fmt.Sprintf("/socket/%d/solve?reply_id=0", topicID) }
							class="text-[10px] text-muted hover:text-rose-500 hover:underline cursor-pointer"
						>
							if lang == "id" {
								(Batalkan)
							} else {
								(Unmark)
							}
						</button>
					}
				}
			</div>
		</div>
		<div class="prose max-w-none text-text text-sm sm:text-base leading-relaxed font-sans">
			@templ.Raw(string(r.BodyHTML))
		</div>
		<div class="flex items-center justify-between pt-1 text-xs font-mono">
			<div>
				@DiscussionsVoteButton("reply", r.ID, r.VotesCount, r.UserVoted)
			</div>
			<div class="flex items-center gap-3">
				if currentUser != nil && (currentUser.ID == topicOwnerID || currentUser.Role == "admin") && !r.IsSolution {
					<button
						hx-post={ fmt.Sprintf("/socket/%d/solve?reply_id=%d", topicID, r.ID) }
						class="text-muted hover:text-link text-[11px] font-mono cursor-pointer transition-colors"
					>
						if lang == "id" {
							[✓ Jadikan Solusi]
						} else {
							[✓ Mark Solution]
						}
					</button>
				}
				<button
					type="button"
					data-target-id={ fmt.Sprintf("inline-reply-form-%d", r.ID) }
					onclick="var target = this.getAttribute('data-target-id'); var el = document.getElementById(target); if(el) el.classList.toggle('hidden');"
					class="text-muted hover:text-text hover:underline inline-flex items-center gap-1 cursor-pointer"
				>
					<span>
						if lang == "id" {
							[↩ Balas]
						} else {
							[↩ Reply]
						}
					</span>
				</button>
				if currentUser != nil && (currentUser.ID == r.UserID || currentUser.Role == "admin") {
					<form
						hx-post={ fmt.Sprintf("/socket/reply/%d/delete", r.ID) }
						hx-confirm="Yakin ingin menghapus komentar balasan ini?"
						class="inline-block"
					>
						<button type="submit" class="text-muted hover:text-rose-500 text-[11px] cursor-pointer transition-colors">
							if lang == "id" {
								Hapus
							} else {
								Delete
							}
						</button>
					</form>
				}
			</div>
		</div>
		<div id={ fmt.Sprintf("inline-reply-form-%d", r.ID) } class="hidden mt-4 pt-3 border-t border-dashed border-border">
			if currentUser != nil {
				<form
					hx-post={ fmt.Sprintf("/socket/%d/reply", topicID) }
					hx-target={ fmt.Sprintf("#replies-children-%d", r.ID) }
					hx-swap="beforeend"
					class="space-y-3"
				>
					<input type="hidden" name="parent_id" value={ fmt.Sprintf("%d", r.ID) }/>
					<textarea
						name="body"
						rows="3"
						required
						if lang == "id" {
							placeholder={ fmt.Sprintf("Tulis balasan untuk @%s...", r.AuthorUsername) }
						} else {
							placeholder={ fmt.Sprintf("Write reply to @%s...", r.AuthorUsername) }
						}
						class="w-full p-2.5 text-xs font-mono bg-bg border border-border text-text placeholder-muted focus:border-[var(--c-link)] focus:outline-none"
					></textarea>
					<div class="flex justify-end gap-2">
						<button
							type="button"
							data-target-id={ fmt.Sprintf("inline-reply-form-%d", r.ID) }
							onclick="var target = this.getAttribute('data-target-id'); var el = document.getElementById(target); if(el) el.classList.add('hidden');"
							class="px-2.5 py-1 text-xs font-mono text-muted hover:text-text cursor-pointer"
						>
							if lang == "id" {
								Batal
							} else {
								Cancel
							}
						</button>
						<button
							type="submit"
							class="px-3 py-1 bg-text text-bg text-xs font-mono font-bold hover:opacity-90 cursor-pointer"
						>
							if lang == "id" {
								Kirim Balasan
							} else {
								Submit Reply
							}
						</button>
					</div>
				</form>
			} else {
				<div class="p-3 bg-surface border border-border text-xs font-mono text-muted flex items-center justify-between">
					if lang == "id" {
						<span>Masuk dengan GitHub untuk membalas komentar ini.</span>
					} else {
						<span>Sign in with GitHub to reply to this comment.</span>
					}
					<a href={ templ.SafeURL("/auth/github?return_to=" + fmt.Sprintf("/socket/%d", topicID)) } class="inline-flex items-center gap-1 text-link hover:underline font-bold">
						if lang == "id" {
							<span>Login GitHub</span>
						} else {
							<span>Sign in GitHub</span>
						}
						@IconArrowRight("w-3 h-3")
					</a>
				</div>
			}
		</div>
		<div id={ fmt.Sprintf("replies-children-%d", r.ID) } class="mt-2.5 space-y-2.5 pl-2.5 sm:pl-4 border-l border-border/60">
			for _, child := range r.Children {
				@DiscussionsReplyItem(ui, lang, currentUser, child, topicID, topicOwnerID)
			}
		</div>
	</div>
}
