package templates

import (
	"fmt"
	"daemontalk/internal/i18n"
)

templ portalBox5QuadMatrix(ui i18n.UI, categories []CategorySection, lang string) {
	// BOX 5: QUAD TOOLING MATRIX (3 : 3 : 3 : 3) - HORIZONTAL SWIPE CAROUSEL ON MOBILE (PATTERN 4)
	<div class="border-0 sm:border-x-2 sm:border-b-2 border-border w-full mb-0 sm:mb-0 bg-bg">
		<div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:divide-x sm:divide-y-0 divide-[var(--c-border)]">
			for _, cat := range categories {
				<div class="shrink-0 w-[85vw] sm:w-auto snap-center px-4 sm:px-5 py-6 sm:py-8 lg:py-12 flex flex-col justify-between border-r sm:border-r-0 border-[var(--c-border)] last:border-r-0">
					<div>
						// Category Header
						<div class="flex items-center justify-between mb-3">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-xs font-mono font-black uppercase tracking-widest text-text hover:text-link">
								{ categoryTitle(cat, lang) }
							</a>
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + cat.Tag) } class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted hover:text-link flex items-center gap-1 group shrink-0" aria-label="Explore topic">
								@IconArrowRight("w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5")
							</a>
						</div>

						// Lead Story with 16:9 Mini Thumbnail
						<article class="group mb-3">
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block relative aspect-[16/9] w-full bg-surface mb-2.5 overflow-hidden border border-border">
								@postThumbnailImg(cat.LeadPost)
							</a>
							<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + cat.LeadPost.Slug) } class="block mb-1">
								<h4 class="display text-sm font-bold text-text group-hover:text-link transition-colors leading-snug line-clamp-2">
									{ cat.LeadPost.Title }
								</h4>
							</a>
							<div class="text-[10px] font-mono text-muted">
								<span>{ fmt.Sprintf("%d %s", cat.LeadPost.ReadTime, ui.Blog_MinRead) }</span>
							</div>
						</article>
					</div>

					// Sub Posts List
					if len(cat.SubPosts) > 0 {
						<div class="flex flex-col divide-y divide-border/40 border-t border-border/40 pt-2 mt-auto">
							for j, sub := range cat.SubPosts {
								if j < 2 {
									<article class="py-2 first:pt-1 last:pb-0">
										<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + sub.Slug) } class="group block">
											<h5 class="display text-xs font-semibold text-text/90 group-hover:text-link transition-colors leading-snug line-clamp-2 mb-1">
												{ sub.Title }
											</h5>
											<div class="text-[9px] font-mono text-muted">
												<span>{ fmt.Sprintf("%d %s", sub.ReadTime, ui.Blog_MinRead) }</span>
											</div>
										</a>
									</article>
								}
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}
