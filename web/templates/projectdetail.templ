package templates

import (
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
	"daemontalk/internal/project"
)

templ ProjectDetailPage(ui i18n.UI, p project.Project, lang string, toc []post.TOCEntry) {
	<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
		<div class="mb-8">
			<div class="flex items-start gap-3 mb-3">
				<h1 class="display text-2xl sm:text-3xl font-semibold text-text font-mono flex-1">{ p.Name }</h1>
				@statusBadge(p.Status)
			</div>
			<p class="text-sm text-muted leading-relaxed mb-4">
				if lang == "id" && p.DescriptionID != "" {
					{ p.DescriptionID }
				} else {
					{ p.Description }
				}
			</p>
			if len(p.TechStack) > 0 {
				<div class="flex flex-wrap gap-1.5 mb-4">
					for _, tech := range p.TechStack {
						<span class="text-xs px-2 py-0.5 bg-chip text-muted rounded-none font-mono">{ tech }</span>
					}
				</div>
			}
			<div class="flex flex-wrap gap-3">
				if p.RepoURL != "" {
					<a
						href={ templ.SafeURL(p.RepoURL) }
						target="_blank"
						rel="noopener"
						class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 border border-border rounded-none text-muted hover:bg-hover hover:text-text transition-colors font-mono"
					>
						@IconGitHub()
						GitHub
					</a>
				}
				if p.DemoURL != "" {
					<a
						href={ templ.SafeURL(p.DemoURL) }
						target="_blank"
						rel="noopener"
						class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 border border-border rounded-none text-muted hover:bg-hover hover:text-text transition-colors font-mono"
					>
						<span>{ demoLabel(p.DemoURL) }</span>
						@IconArrowUpRight("w-3 h-3")
					</a>
				}
			</div>
		</div>
		if p.Body != "" {
			<div class="pt-8 lg:grid lg:grid-cols-[1fr_200px] lg:gap-16 lg:items-start">
				<div>
					if len(toc) > 0 {
						<details id="mobile-toc" class="lg:hidden mb-8 border border-border rounded-none">
							<summary class="px-4 py-3 text-sm font-medium text-text cursor-pointer select-none list-none flex items-center justify-between">
								<span>
									if lang == "id" {
										Daftar isi
									} else {
										Table of contents
									}
								</span>
								@IconChevronDown("toc-chevron w-4 h-4 text-muted transition-transform")
							</summary>
							<nav class="px-4 pb-4">
								@tocList(toc)
							</nav>
						</details>
					}
					<div id="prose-body" class="prose">
						@templ.Raw(string(p.Body))
					</div>
				</div>
				if len(toc) > 0 {
					<aside class="hidden lg:block">
						<div class="sticky top-24">
							<p class="text-xs font-medium text-muted uppercase tracking-wide mb-3">
								if lang == "id" {
									Daftar isi
								} else {
									On this page
								}
							</p>
							<nav>
								@tocList(toc)
							</nav>
						</div>
					</aside>
				}
			</div>
			<script src="/static/js/project.js" defer></script>
		}
		<a
			href={ templ.SafeURL(prefix(lang) + "/colophon#projects") }
			class="inline-flex items-center gap-1.5 text-sm text-link hover:underline mt-12 font-mono"
		>
			@IconArrowLeft("w-3.5 h-3.5")
			<span>{ ui.Nav_Colophon }</span>
		</a>
	</div>
}
