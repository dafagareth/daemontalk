package templates

import "daemontalk/internal/i18n"

templ topNav(ui i18n.UI, lang string, page string, currentPath string) {
	<!-- Header Wrapper -->
	<div id="site-header-wrapper" class="sticky top-0 z-40 w-full transition-transform duration-300 ease-in-out bg-[var(--c-nav)]">
		<header class="bg-[var(--c-nav)] text-text transition-colors">
			<!-- Top Row -->
			<div class="container-page py-4 sm:py-6 flex items-center justify-between gap-4 min-w-0">
				<div class="flex items-center gap-4 min-w-0">
					<a href={ templ.SafeURL(prefix(lang) + "/") } class="flex items-center shrink-0 hover:opacity-85 transition-opacity" aria-label="daemontalk">
						@BrandLogo("h-8 sm:h-10 md:h-11 w-auto")
					</a>
				</div>
				<!-- Search Popper -->
				<div class="hidden md:flex items-center gap-3 shrink-0 flex-1 justify-end">
					<div id="nav-search-container" class="relative w-full max-w-sm lg:max-w-md">
						<form action={ templ.SafeURL(prefix(lang) + "/search") } method="get" class="relative group w-full" onsubmit="handleNavSearchSubmit(event)">
							<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted group-focus-within:text-link transition-colors">
								@IconSearch("w-4 h-4")
							</div>
							<input
								id="header-search-input"
								type="search"
								name="q"
								placeholder="Search systems, articles..."
								class="w-full bg-surface border border-border text-text text-sm rounded-none focus:outline-none focus:border-[var(--c-link)] py-2.5 pl-10 pr-12 transition-colors placeholder:text-muted"
								autocomplete="off"
								aria-label="Search"
								hx-get={ string(templ.SafeURL(prefix(lang) + "/search?type=quick")) }
								hx-trigger="input changed delay:150ms"
								hx-target="#search-dropdown-results"
								onkeydown="handleSearchKeyNav(event)"
							/>
							<div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none">
								<kbd class="inline-flex items-center justify-center w-6 h-6 text-[11px] font-mono border border-border bg-bg text-muted">/</kbd>
							</div>
						</form>

						<!-- Popper -->
						<div
							id="search-dropdown-popper"
							class="hidden absolute top-full left-0 right-0 mt-1.5 z-50 bg-surface border-2 border-border shadow-2xl overflow-hidden"
						>
							<div id="search-dropdown-results">
								<!-- HTMX injects SearchDropdownResults here -->
							</div>
						</div>
					</div>

					<!-- Theme Toggle -->
					<button
						type="button"
						onclick="toggleTheme()"
						aria-label="Toggle theme"
						class="w-9 h-9 flex items-center justify-center border border-border bg-surface text-muted hover:text-text hover:bg-hover transition-colors cursor-pointer shrink-0"
						title="Toggle light/dark theme"
					>
						@sunIcon()
						@moonIcon()
					</button>
				</div>

				<!-- Mobile Buttons -->
				<div class="flex md:hidden items-center gap-2 shrink-0">
					<!-- Menu Button -->
					<button
						type="button"
						onclick="toggleMobileMenu()"
						aria-label="Open mobile navigation menu"
						class="w-9 h-9 flex items-center justify-center rounded-none border border-border bg-surface text-text hover:bg-hover transition-colors cursor-pointer shrink-0"
					>
						@IconMenu("w-5 h-5")
					</button>
				</div>
			</div>
		</header>

		<!-- Subnav -->
		<div class="hidden md:block border-b border-border bg-[var(--c-nav)] transition-colors">
			<div class="container-page h-11 flex items-center justify-between gap-4 min-w-0 overflow-x-auto scrollbar-none text-xs font-mono uppercase tracking-wider font-semibold">
				<div id="subnav-tags" class="flex items-center gap-4 sm:gap-6 shrink-0">
					<a href={ templ.SafeURL(prefix(lang) + "/") } data-tag="" class="subnav-tag text-text hover:text-link transition-colors">ALL</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/linux") } data-tag="linux" class="subnav-tag text-text hover:text-link transition-colors">Linux</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/ai") } data-tag="ai" class="subnav-tag text-text hover:text-link transition-colors">AI</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/systems") } data-tag="systems" class="subnav-tag text-text hover:text-link transition-colors">Systems</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/backend") } data-tag="backend" class="subnav-tag text-text hover:text-link transition-colors">Backend</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/docker") } data-tag="docker" class="subnav-tag text-text hover:text-link transition-colors">Docker</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/devops") } data-tag="devops" class="subnav-tag text-text hover:text-link transition-colors">DevOps</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/security") } data-tag="security" class="subnav-tag text-text hover:text-link transition-colors">Security</a>
					<a href={ templ.SafeURL(prefix(lang) + "/blog/tag/tools") } data-tag="tools" class="subnav-tag text-text hover:text-link transition-colors">Tools</a>
				</div>
			</div>
		</div>
	</div>
}

// mobileMenu renders a full-screen slide-in mobile navigation drawer.
templ mobileMenu(ui i18n.UI, lang string, page string, currentPath string) {
	<div
		id="mobile-menu-overlay"
		class="fixed inset-0 z-50 bg-surface flex flex-col justify-between p-6 overflow-y-auto transform translate-x-full transition-transform duration-300 ease-in-out md:hidden"
	>
		<!-- Top Bar -->
		<div class="flex items-center justify-between pb-4 mb-6">
			<a href={ templ.SafeURL(prefix(lang) + "/") } onclick="toggleMobileMenu()" class="flex items-center shrink-0 hover:opacity-85 transition-opacity" aria-label="daemontalk">
				@BrandLogo("h-8 sm:h-9 w-auto")
			</a>
			<button
				type="button"
				onclick="toggleMobileMenu()"
				aria-label="Close mobile menu"
				class="w-9 h-9 flex items-center justify-center rounded-none border border-border bg-surface text-text hover:bg-hover transition-colors cursor-pointer"
			>
				@IconClose("w-5 h-5")
			</button>
		</div>

		<!-- Nav Links -->
		<div class="flex-1 flex flex-col gap-6 py-2">
			
			<!-- Search -->
			<a
				href={ templ.SafeURL(prefix(lang) + "/search") }
				onclick="toggleMobileMenu()"
				class="flex items-center gap-3 px-4 py-3 border border-border bg-bg text-muted hover:text-text rounded-none transition-colors w-full"
			>
				@IconSearch("w-4 h-4")
				<span class="text-sm font-sans">Search articles...</span>
			</a>

			<!-- Tags -->
			<div class="pt-2">
				<div class="flex flex-wrap gap-2">
					for _, tg := range []string{"linux", "ai", "systems", "backend", "devops", "docker", "security", "tools"} {
						<a
							href={ templ.SafeURL(prefix(lang) + "/blog/tag/" + tg) }
							onclick="toggleMobileMenu()"
							class="text-xs font-sans px-3 py-1.5 rounded-none bg-chip hover:bg-hover text-text border border-border transition-colors uppercase"
						>
							{ tg }
						</a>
					}
				</div>
			</div>

			<!-- Links -->
			<div class="flex flex-col gap-2 font-sans text-base font-semibold pt-2">
				<a
					href={ templ.SafeURL(prefix(lang) + "/") }
					onclick="toggleMobileMenu()"
					class="py-3 text-text hover:text-link transition-colors"
				>
					<span>Live Dispatch</span>
				</a>
				if IsRadarEnabled() {
					<a
						href={ templ.SafeURL(prefix(lang) + "/graph") }
						onclick="toggleMobileMenu()"
						class="py-3 text-text hover:text-link transition-colors"
					>
						<span>Systems Radar & Graph</span>
					</a>
				}
				<a
					href={ templ.SafeURL(prefix(lang) + "/terminal") }
					onclick="toggleMobileMenu()"
					class="py-3 text-text hover:text-link transition-colors"
				>
					<span>Terminal Shell</span>
				</a>
				<a
					href={ templ.SafeURL(prefix(lang) + "/saved") }
					onclick="toggleMobileMenu()"
					class="py-3 text-text hover:text-link transition-colors"
				>
					<span>Reading List</span>
				</a>
				<a
					href={ templ.SafeURL(prefix(lang) + "/guestbook") }
					onclick="toggleMobileMenu()"
					class="py-3 text-text hover:text-link transition-colors"
				>
					<span>Guestbook Log</span>
				</a>
				<a
					href={ templ.SafeURL(prefix(lang) + "/behind") }
					onclick="toggleMobileMenu()"
					class="py-3 text-text hover:text-link transition-colors"
				>
					<span>Colophon</span>
				</a>
			</div>
		</div>

		<!-- Bottom Controls -->
		<div class="mt-auto pt-8 flex items-center gap-3">
			<button
				onclick="toggleTheme()"
				aria-label="Toggle theme"
				class="w-9 h-9 flex items-center justify-center border border-border bg-surface text-text cursor-pointer hover:bg-hover transition-colors"
			>
				@sunIcon()
				@moonIcon()
			</button>
			<a
				href={ templ.SafeURL(switchLangURL(lang, currentPath)) }
				class="text-xs font-sans px-3 py-2 rounded-none border border-border bg-surface text-link font-semibold"
			>
				{ ui.Lang_Switch }
			</a>
		</div>

		<!-- Socials -->
		<div class="pt-6 pb-2 flex items-center justify-start gap-5 text-muted flex-wrap">
			<a href="https://github.com/dafagareth" target="_blank" aria-label="GitHub" class="hover:text-text transition-colors">
				@IconGitHub()
			</a>
			<a href="https://x.com/daemontalk" target="_blank" aria-label="X (Twitter)" class="hover:text-text transition-colors">
				@IconX()
			</a>
			<a href="https://instagram.com/daemontalk" target="_blank" aria-label="Instagram" class="hover:text-text transition-colors">
				@IconInstagram()
			</a>
			<a href="https://threads.net/@daemontalk" target="_blank" aria-label="Threads" class="hover:text-text transition-colors">
				@IconThreads()
			</a>
			<a href="mailto:realdaemontalk@gmail.com" aria-label="Email" class="hover:text-text transition-colors">
				@IconEmail()
			</a>
			<a href={ templ.SafeURL(prefix(lang) + "/rss.xml") } target="_blank" aria-label="RSS Feed" class="hover:text-text transition-colors">
				@IconRSS()
			</a>
		</div>
	</div>
}

templ topNavItem(href string, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="font-mono text-sm font-medium text-text underline underline-offset-4 decoration-[var(--c-link)]">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="font-mono text-sm text-muted hover:text-text transition-colors">
			{ label }
		</a>
	}
}

templ sunIcon() {
	@IconSun("icon-sun w-3.5 h-3.5 shrink-0")
}

templ moonIcon() {
	@IconMoon("icon-moon w-3.5 h-3.5 shrink-0")
}

templ iconArrowLeft() {
	@IconArrowLeft("w-3.5 h-3.5 inline-block shrink-0 stroke-[2.5]")
}

templ iconArrowRight() {
	@IconArrowRight("w-3.5 h-3.5 inline-block shrink-0 stroke-[2.5]")
}

templ iconArrowUpRight() {
	@IconArrowUpRight("w-3.5 h-3.5 inline-block shrink-0 stroke-[2.5]")
}
