package templates

import (
	"fmt"
)

templ adminContentTab(stats AdminStats) {
	<div id="tab-content" class="hidden space-y-6">
		<!-- Header with Actions -->
		<div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-border/60">
			<div>
				<h1 class="text-lg font-semibold text-text">Channel Content & Dispatches</h1>
				<p class="text-xs text-muted mt-0.5">Manage, upload, and edit markdown dispatches directly.</p>
			</div>
			<div class="flex items-center gap-2">
				<button
					type="button"
					onclick="document.getElementById('admin-md-upload-input').click()"
					class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-chip border border-border text-text text-xs font-mono font-medium transition-colors hover:bg-hover cursor-pointer"
				>
					<span>Upload .md</span>
				</button>
				<form id="admin-md-upload-form" action="/admin/posts/upload-md" method="post" enctype="multipart/form-data" class="hidden">
					<input
						type="file"
						id="admin-md-upload-input"
						name="file"
						accept=".md,.markdown"
						multiple
						onchange="this.form.submit()"
					/>
				</form>
				<a
					href="/admin/posts/new"
					class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-none bg-[var(--c-text)] text-[var(--c-bg)] text-xs font-mono font-bold transition-opacity hover:opacity-90 shadow-sm"
				>
					+ New Post
				</a>
			</div>
		</div>

		<!-- Quick Drag & Drop Ingest Card -->
		<div
			id="admin-drop-zone"
			class="border-2 border-dashed border-border/80 bg-surface/40 hover:bg-surface/80 hover:border-[var(--c-link)] transition-all p-6 text-center cursor-pointer rounded-none"
			onclick="document.getElementById('admin-md-upload-input').click()"
		>
			<p class="text-xs font-mono font-medium text-text">
				Drag & drop your <span class="text-link">.md</span> or <span class="text-link">.markdown</span> files here to publish instantly
			</p>
			<p class="text-[11px] text-muted font-mono mt-1">
				Supports multiple files. Frontmatter (title, slug, date, tags) is parsed automatically.
			</p>
		</div>

		<!-- Web Posts Section (Created via Web Editor) -->
		if len(stats.WebPosts) > 0 {
			<div class="space-y-3">
				<div class="flex items-center justify-between">
					<h2 class="text-xs font-semibold text-text uppercase tracking-wider flex items-center gap-2">
						<span class="w-2 h-2 rounded-none bg-[var(--c-ok)]"></span>
						<span>Studio Articles ({ fmt.Sprintf("%d", len(stats.WebPosts)) })</span>
					</h2>
					<span class="text-xs text-muted">Saved in SQLite PostDB</span>
				</div>
				<div class="border border-border rounded-none overflow-hidden">
					<table class="w-full text-sm text-left">
						<thead class="border-b border-border text-xs text-muted bg-surface">
							<tr>
								<th class="px-4 py-2.5 font-medium">Title</th>
								<th class="px-4 py-2.5 font-medium">Status</th>
								<th class="px-4 py-2.5 font-medium">Language</th>
								<th class="px-4 py-2.5 font-medium">Last Modified</th>
								<th class="px-4 py-2.5 font-medium text-right">Views</th>
								<th class="px-4 py-2.5 font-medium text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[var(--c-border)]">
							for _, wp := range stats.WebPosts {
								<tr class="hover:bg-hover transition-colors">
									<td class="px-4 py-3">
										<div class="font-medium text-text">{ wp.Title }</div>
										<div class="text-xs font-mono text-muted mt-0.5">/{ wp.Slug }</div>
									</td>
									<td class="px-4 py-3 whitespace-nowrap">
										if wp.Draft {
											<span class="badge badge-draft">Draft</span>
										} else {
											<span class="badge badge-ok">Public</span>
										}
									</td>
									<td class="px-4 py-3 whitespace-nowrap">
										<span class="text-xs uppercase font-mono text-muted">{ wp.Lang }</span>
									</td>
									<td class="px-4 py-3 text-xs font-mono text-muted whitespace-nowrap">
										{ wp.UpdatedAt.Format("2006-01-02 15:04") }
									</td>
									<td class="px-4 py-3 text-right font-mono text-xs text-text">
										{ fmt.Sprintf("%d", stats.Views[wp.Slug]) }
									</td>
									<td class="px-4 py-3 text-right text-xs whitespace-nowrap">
										<div class="flex items-center justify-end gap-3">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d/edit", wp.ID)) }
												class="text-link hover:underline font-mono"
											>
												Edit
											</a>
											if !wp.Draft {
												<a
													href={ templ.SafeURL("/blog/" + wp.Slug) }
													target="_blank"
													class="inline-flex items-center gap-0.5 text-muted hover:text-text font-mono"
												>
													<span>View</span>
													@iconArrowUpRight()
												</a>
											}
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d/delete", wp.ID)) } data-confirm="Delete this post? This action cannot be undone." class="inline">
												<button type="submit" class="text-red-500 hover:underline font-mono">Delete</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}

		<!-- File-based Markdown Posts -->
		<div class="space-y-3">
			<div class="flex items-center justify-between">
				<h2 class="text-xs font-semibold text-text uppercase tracking-wider flex items-center gap-2">
					<span class="w-2 h-2 rounded-none bg-[var(--c-muted)]"></span>
					<span>Markdown Dispatches ({ fmt.Sprintf("%d", len(stats.Posts)) })</span>
				</h2>
				<span class="text-xs font-mono text-muted">{ "content/posts/*.md" }</span>
			</div>
			<div class="border border-border rounded-none overflow-hidden">
				<table class="w-full text-sm text-left">
					<thead class="border-b border-border text-xs text-muted bg-surface">
						<tr>
							<th class="px-4 py-2.5 font-medium">Title</th>
							<th class="px-4 py-2.5 font-medium">Status</th>
							<th class="px-4 py-2.5 font-medium">Date</th>
							<th class="px-4 py-2.5 font-medium text-right">Views</th>
							<th class="px-4 py-2.5 font-medium text-right">Comments</th>
							<th class="px-4 py-2.5 font-medium text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-[var(--c-border)]">
						for _, p := range stats.Posts {
							<tr class="hover:bg-hover transition-colors">
								<td class="px-4 py-2.5">
									<a href={ templ.SafeURL("/blog/" + p.Slug) } class="font-medium text-text hover:text-link">{ p.Title }</a>
									<span class="text-xs font-mono text-muted ml-2">/{ p.Slug }</span>
								</td>
								<td class="px-4 py-2.5 whitespace-nowrap">
									if p.Draft {
										<span class="badge badge-draft">Draft</span>
									} else {
										<span class="badge badge-ok">Public</span>
									}
								</td>
								<td class="px-4 py-2.5 text-xs font-mono text-muted whitespace-nowrap">{ fmtDate(p) }</td>
								<td class="px-4 py-2.5 text-right font-mono text-xs text-text">{ fmt.Sprintf("%d", stats.Views[p.Slug]) }</td>
								<td class="px-4 py-2.5 text-right font-mono text-xs text-muted">{ fmt.Sprintf("%d", adminCommentCount(stats.Comments, p.Slug)) }</td>
								<td class="px-4 py-2.5 text-right text-xs whitespace-nowrap">
									<div class="flex items-center justify-end gap-3 font-mono">
										<a
											href={ templ.SafeURL("/admin/posts/file-edit?slug=" + p.Slug) }
											class="text-link hover:underline"
										>
											Edit
										</a>
										<form method="post" action={ templ.SafeURL("/admin/posts/file-archive?slug=" + p.Slug) } data-confirm={ fmt.Sprintf("Archive post '%s'? It will be hidden from public feeds.", p.Slug) } class="inline">
											<button type="submit" class="text-muted hover:text-text">Archive</button>
										</form>
										<form method="post" action={ templ.SafeURL("/admin/posts/file-delete?slug=" + p.Slug) } data-confirm={ fmt.Sprintf("Permanently delete post '%s' and all image assets? This cannot be undone.", p.Slug) } class="inline">
											<button type="submit" class="text-red-500 hover:underline">Delete</button>
										</form>
										<a
											href={ templ.SafeURL("/admin/posts/export?slug=" + p.Slug) }
											class="text-muted hover:text-text"
											download
										>
											Export
										</a>
										if !p.Draft {
											<a
												href={ templ.SafeURL("/blog/" + p.Slug) }
												target="_blank"
												class="inline-flex items-center gap-0.5 text-muted hover:text-text"
											>
												<span>View</span>
												@iconArrowUpRight()
											</a>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
