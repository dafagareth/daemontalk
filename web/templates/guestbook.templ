package templates

import (
	"fmt"
	"strings"
	"daemontalk/internal/comment"
	"daemontalk/internal/i18n"
)

templ GuestbookPage(ui i18n.UI, entries []comment.Comment, lang string, visitorName string) {
	<section class="container-page py-6 sm:py-10">
		
		<!-- MONOLITHIC BOXED GRID CONTAINER -->
		<div class="border-2 border-border bg-bg shadow-sm">
			
			<!-- MODULE 1: HEADER & MASTHEAD -->
			<div class="p-6 sm:p-8 border-b-2 border-border bg-bg">
				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-border">
					<div>
						<div class="text-[11px] font-mono font-bold tracking-widest text-muted uppercase mb-1">
							DAEMONTALK LOGBOOK // PUBLIC DISPATCH
						</div>
						<h1 class="display text-2xl sm:text-3xl lg:text-4xl font-black text-text tracking-tight uppercase">
							{ ui.Guestbook_Title }
						</h1>
					</div>
					<div class="flex flex-wrap items-center gap-2 text-xs font-mono">
						<span class="px-3 py-1.5 bg-surface border border-border text-muted">
							STATUS: <strong class="text-text">ACTIVE</strong>
						</span>
						<span class="px-3 py-1.5 bg-surface border border-border text-muted">
							ENTRIES: <strong class="text-text">{ fmt.Sprintf("%d", len(entries)) }</strong>
						</span>
						<span class="px-3 py-1.5 bg-surface border border-border text-muted">
							SSH: <strong class="text-text">2222</strong>
						</span>
					</div>
				</div>
				<p class="text-xs sm:text-sm text-muted leading-relaxed mt-4 max-w-3xl font-sans">
					Public engineering transmission log. Broadcast feedback, systems architecture requests, or leave notes for the lab community.
				</p>
			</div>

			<!-- MODULE 2: INPUT FORM & SSH TERMINAL (SPLIT 7 : 5) -->
			<div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x-2 divide-border border-b-2 border-border">
				
				<!-- LEFT (7 cols): Submission Form -->
				<div class="lg:col-span-7 p-6 sm:p-7 flex flex-col justify-between bg-bg">
					<div>
						<div class="flex items-center justify-between pb-2.5 mb-4 border-b border-border">
							<span class="text-xs font-mono font-bold uppercase tracking-wider text-text">
								SUBMIT ENTRY
							</span>
							<span class="text-[10px] font-mono text-muted">500 CHARS MAX</span>
						</div>

						<form
							id="guestbook-form"
							hx-post={ prefix(lang) + "/guestbook" }
							hx-target="#guestbook-list-container"
							hx-swap="outerHTML"
							hx-disabled-elt="find button[type='submit']"
							hx-on::after-request="if(event.detail.successful){ this.reset(); var ta = this.querySelector('textarea'); if(ta) ta.value = ''; }"
							class="flex flex-col gap-4"
						>
							<!-- Honeypot -->
							<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true"/>

							<!-- Callsign & Topic Row -->
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
								<div>
									<label for="gb-author-name" class="block text-xs font-sans font-bold text-text uppercase mb-1">
										Callsign / Alias
									</label>
									<input
										type="text"
										id="gb-author-name"
										name="name"
										value={ visitorName }
										maxlength="30"
										placeholder={ visitorName }
										class="w-full bg-surface border border-border text-text text-xs sm:text-sm font-sans rounded-none py-2 px-3 focus:outline-none focus:border-link transition-colors"
									/>
								</div>

								<div>
									<label for="gb-category" class="block text-xs font-sans font-bold text-text uppercase mb-1">
										Topic Stream
									</label>
									<select
										id="gb-category"
										name="category"
										class="w-full bg-surface border border-border text-text text-xs sm:text-sm font-sans rounded-none py-2 px-3 focus:outline-none focus:border-link transition-colors cursor-pointer"
									>
										<option value="GENERAL">General</option>
										<option value="FEEDBACK">Feedback</option>
										<option value="SYSTEMS">Systems &amp; Linux</option>
										<option value="ARCHITECTURE">Architecture</option>
									</select>
								</div>
							</div>

							<!-- Message Payload -->
							<div>
								<label for="gb-message-body" class="block text-xs font-sans font-bold text-text uppercase mb-1">
									Message Payload
								</label>
								<textarea
									id="gb-message-body"
									name="body"
									required
									maxlength="500"
									rows="4"
									placeholder="Write your transmission message here..."
									class="w-full px-3 py-2.5 text-xs sm:text-sm font-sans rounded-none border border-border bg-surface text-text placeholder:text-muted focus:outline-none focus:border-link transition-colors resize-y leading-relaxed"
								></textarea>
							</div>

							<!-- Submit Action -->
							<div class="flex items-center justify-between pt-3 border-t border-border">
								<span class="text-[11px] font-mono text-muted">
									Logged to SQLite database
								</span>
								<button
									type="submit"
									class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider px-5 py-2.5 rounded-none bg-text text-bg hover:bg-link hover:text-white transition-all cursor-pointer shadow-sm group"
								>
									<span class="htmx-indicator spinner"></span>
									<span>{ ui.Guestbook_Submit }</span>
									@IconArrowRight("w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5")
								</button>
							</div>
						</form>
					</div>
				</div>

				<!-- RIGHT (5 cols): SSH Terminal Connection -->
				<div class="lg:col-span-5 p-6 sm:p-7 flex flex-col justify-between bg-surface/30">
					<div>
						<div class="flex items-center justify-between pb-2.5 mb-4 border-b border-border">
							<span class="text-xs font-mono font-bold uppercase tracking-wider text-text flex items-center gap-2">
								@IconTerminalPrompt("w-4 h-4 text-accent")
								TERMINAL INTERFACE
							</span>
							<span class="text-[10px] font-mono text-muted">PORT 2222</span>
						</div>

						<p class="text-xs sm:text-sm text-muted leading-relaxed mb-4 font-sans">
							Access and write to the guestbook directly from your terminal console via SSH.
						</p>

						<!-- Copyable Command Box -->
						<div class="relative bg-zinc-950 text-zinc-100 font-mono text-xs p-3.5 pr-10 border border-border overflow-hidden mb-4 group">
							<div class="overflow-x-auto select-all scrollbar-none whitespace-nowrap">
								<span class="text-zinc-500 mr-2">$</span>ssh ssh.daemontalk.com -p 2222
							</div>
							<button 
								onclick="navigator.clipboard.writeText('ssh ssh.daemontalk.com -p 2222'); var i=this.querySelector('svg'); i.style.color='#10b981'; setTimeout(()=>i.style.color='', 1000);" 
								title="Copy command" 
								aria-label="Copy command" 
								class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-white transition-colors opacity-80 group-hover:opacity-100 cursor-pointer"
							>
								@IconCopy("w-4 h-4 transition-colors")
							</button>
						</div>

						<!-- Rules -->
						<div class="space-y-1.5 text-xs font-sans text-muted">
							<div>• Public broadcast across nodes</div>
							<div>• No registration required</div>
							<div>• Plaintext and markdown supported</div>
						</div>
					</div>

					<div class="pt-4 mt-6 border-t border-border text-[10px] font-mono text-muted flex items-center justify-between">
						<span>Format: UTF-8</span>
						<a href={ templ.SafeURL(prefix(lang) + "/terminal") } class="text-link hover:underline font-bold inline-flex items-center gap-1 group">
							<span>Web Terminal Shell</span>
							@IconArrowRight("w-3 h-3 transition-transform group-hover:translate-x-0.5")
						</a>
					</div>
				</div>

			</div>

			<!-- MODULE 3: FILTER BAR -->
			<div class="p-3.5 sm:px-6 bg-surface flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-border">
				<div class="flex items-center gap-3">
					<span class="text-xs font-mono font-black uppercase tracking-wider text-text">
						TRANSMISSION ARCHIVE
					</span>
					<span class="text-[10px] font-mono px-2 py-0.5 bg-bg border border-border text-muted">
						{ fmt.Sprintf("%d ENTRIES", len(entries)) }
					</span>
				</div>
				
				<!-- Filter Pills -->
				<div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none text-[11px] font-mono">
					<button onclick="filterGuestbook('ALL')" class="gb-filter-btn px-2.5 py-1 bg-text text-bg font-bold border border-border cursor-pointer transition-colors" data-tag="ALL">ALL</button>
					<button onclick="filterGuestbook('GENERAL')" class="gb-filter-btn px-2.5 py-1 bg-bg text-muted hover:text-text border border-border cursor-pointer transition-colors" data-tag="GENERAL">GENERAL</button>
					<button onclick="filterGuestbook('FEEDBACK')" class="gb-filter-btn px-2.5 py-1 bg-bg text-muted hover:text-text border border-border cursor-pointer transition-colors" data-tag="FEEDBACK">FEEDBACK</button>
					<button onclick="filterGuestbook('SYSTEMS')" class="gb-filter-btn px-2.5 py-1 bg-bg text-muted hover:text-text border border-border cursor-pointer transition-colors" data-tag="SYSTEMS">SYSTEMS</button>
					<button onclick="filterGuestbook('ARCHITECTURE')" class="gb-filter-btn px-2.5 py-1 bg-bg text-muted hover:text-text border border-border cursor-pointer transition-colors" data-tag="ARCHITECTURE">ARCHITECTURE</button>
				</div>
			</div>

			<!-- MODULE 4: ENTRIES GRID -->
			@GuestbookList(ui, entries)

		</div>

	</section>
}

// GuestbookList renders the 2-column wireframe grid of transmission log cards.
templ GuestbookList(ui i18n.UI, entries []comment.Comment) {
	<div id="guestbook-list-container">
		if len(entries) == 0 {
			<div class="p-12 text-center bg-surface text-muted font-sans text-sm">
				<p class="mb-1 font-mono uppercase font-bold text-xs">[NO TRANSMISSIONS RECORDED]</p>
				<p class="text-text">Be the first engineer to transmit a message to the lab.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 bg-bg" id="guestbook-cards-grid">
				for idx, e := range entries {
					@guestbookCard(e, len(entries)-idx, idx, len(entries))
				}
			</div>
		}
	</div>
}

templ guestbookCard(e comment.Comment, logNum int, idx int, total int) {
	<article
		class={
			"gb-entry-card p-5 sm:p-6 flex flex-col justify-between transition-colors border-border hover:bg-hover/20",
			templ.KV("md:border-r-2", idx%2 == 0),
			templ.KV("border-b-2", idx < total-2 || (total%2 != 0 && idx < total-1) || (idx%2 == 0 && idx == total-2)),
			templ.KV("bg-surface/30", e.Name == "daemontalk" || e.Name == "Dafa Gareth"),
		}
		data-category={ getGuestbookTagOnly(e.Body) }
	>
		<div>
			<!-- Top Meta -->
			<div class="flex items-center justify-between gap-2 pb-2 mb-3 border-b border-border text-[10px] font-mono text-muted">
				<div class="flex items-center gap-2">
					<span class="font-bold text-text">#{ fmt.Sprintf("%04d", logNum) }</span>
					<span class="px-1.5 py-0.5 bg-chip text-text font-bold uppercase border border-border">
						[{ getGuestbookTagOnly(e.Body) }]
					</span>
				</div>
				<time datetime={ e.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") } class="comment-time">
					{ fmtCommentTime(e.CreatedAt) }
				</time>
			</div>

			<!-- Author Row -->
			<div class="flex items-center gap-2 mb-3">
				<span class="font-sans text-sm font-bold text-text">
					{ e.Name }
				</span>
				if e.Name == "daemontalk" || e.Name == "Dafa Gareth" {
					<span class="text-[9px] font-mono font-bold px-1.5 py-0.5 bg-text text-bg uppercase">
						Author
					</span>
				}
			</div>

			<!-- Message Content -->
			<div class="text-xs sm:text-sm text-text whitespace-pre-wrap break-words leading-relaxed font-sans">
				{ getGuestbookCleanBody(e.Body) }
			</div>
		</div>
	</article>
}

func getGuestbookTagOnly(body string) string {
	trimmed := strings.TrimSpace(body)
	if strings.HasPrefix(trimmed, "[") {
		endIdx := strings.Index(trimmed, "]")
		if endIdx > 1 && endIdx <= 20 {
			return strings.ToUpper(trimmed[1:endIdx])
		}
	}
	return "GENERAL"
}

func getGuestbookCleanBody(body string) string {
	trimmed := strings.TrimSpace(body)
	if strings.HasPrefix(trimmed, "[") {
		endIdx := strings.Index(trimmed, "]")
		if endIdx > 1 && endIdx <= 20 {
			return strings.TrimSpace(trimmed[endIdx+1:])
		}
	}
	return trimmed
}
