package templates

import (
	"daemontalk/internal/github"
	"daemontalk/internal/i18n"
	"daemontalk/internal/project"
)

templ Colophon(ui i18n.UI, lang string, projects []project.Project, ghStats github.Stats) {
	<section class="container-page py-8 sm:py-12 min-h-[75vh] font-sans">
		<div class="mb-8 sm:mb-10 font-sans">
			<a
				href={ templ.SafeURL(prefix(lang) + "/") }
				class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors mb-3 group select-none font-sans"
			>
				@IconArrowLeft("w-3.5 h-3.5")
				<span>
					if lang == "id" {
						Kembali ke Beranda
					} else {
						Back to Dispatches
					}
				</span>
			</a>
			<h1 class="display text-2xl sm:text-3xl font-black text-text tracking-tight uppercase font-sans">
				if lang == "id" {
					Spesifikasi & Kolofon
				} else {
					Colophon & Specifications
				}
			</h1>
		</div>
		<div class="border-0 sm:border border-border bg-transparent sm:bg-surface/10 font-sans sm:overflow-hidden">
			@colophonKpis(lang)
			@colophonSpecs()
			@colophonProjects(lang, projects)
			@colophonContacts(lang)
		</div>
	</section>
}
