package templates

import "daemontalk/internal/i18n"

templ ResumePage(ui i18n.UI, lang string) {
	<section class="container-page py-8 sm:py-12">
		<div class="max-w-3xl">
			<div class="pb-6 mb-8">
				<div class="flex items-start justify-between gap-4">
					<div>
						<h1 class="display text-2xl sm:text-3xl font-semibold text-text">Dafa</h1>
						<p class="text-sm text-muted mt-1">Information Systems Student · Go Backend Enthusiast</p>
						<div class="flex flex-wrap gap-x-4 gap-y-1 mt-3">
							<a href="mailto:dafagareth@gmail.com" class="text-xs text-muted hover:text-link transition-colors">dafagareth@gmail.com</a>
							<a href="https://github.com/dafagareth" target="_blank" rel="noopener" class="text-xs text-muted hover:text-link transition-colors">github.com/dafagareth</a>
							<a href="https://daemontalk.com" class="text-xs text-muted hover:text-link transition-colors">daemontalk.com</a>
						</div>
					</div>
					<button
						onclick="window.print()"
						class="shrink-0 text-xs px-3 py-1.5 border border-border rounded-none text-muted hover:bg-hover hover:text-text transition-colors font-mono"
					>
						Print / PDF
					</button>
				</div>
			</div>
			<section class="mb-8">
				<h2 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Summary</h2>
				<p class="text-sm text-text leading-relaxed">
					Software engineer and systems enthusiast focusing on Go backend development, REST API design, Linux system mechanics, and distributed architecture. Passionate about building fast, reliable, and minimal open-source software.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Education</h2>
				<div>
					<p class="text-sm font-medium text-text">Bachelor of Information Systems</p>
					<p class="text-xs text-muted mt-1 leading-relaxed">Relevant Coursework: Data Structures, Algorithms, Relational Database Systems (SQL), Operating Systems, Computer Networks.</p>
				</div>
			</section>
			<section class="mb-8">
				<h2 class="text-xs font-semibold text-muted uppercase tracking-wider mb-5">Independent & Open Source Projects</h2>
				<div class="flex flex-col gap-6">
					@resumeRole("daemontalk", "Creator & Developer", "2026", "Open Source", []string{
						"Built an independent tech publication and reading platform in Go using chi, templ, and Tailwind CSS.",
						"Implemented Ahead-of-Time (AOT) compiled HTML rendering and custom Markdown pre-processors for interactive carousels and FAQs.",
						"Designed an in-browser retro UNIX terminal emulator with command history and client-side virtual filesystem.",
					})
					@resumeRole("svault", "Creator & Developer", "2026", "Open Source", []string{
						"Developed a local-first encrypted secret vault CLI in Go utilizing AES-256-GCM, Argon2id key derivation, and Cobra.",
						"Implemented secure session-based memory management and zero external runtime dependencies.",
					})
				</div>
			</section>
			<section class="mb-8">
				<h2 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Technical Skills & Roadmap</h2>
				<div class="text-xs text-muted space-y-1.5 leading-relaxed">
					<p><strong class="text-text font-semibold">Languages:</strong> Go, Python, SQL, Bash, HTML/CSS, C & Rust (Planned Roadmap)</p>
					<p><strong class="text-text font-semibold">Backend & Web:</strong> Go (chi/stdlib), templ, HTMX, SQLite, PostgreSQL, REST APIs</p>
					<p><strong class="text-text font-semibold">Tools & OS:</strong> Linux, Git, Neovim, Make, Docker</p>
				</div>
			</section>
			<a
				href={ templ.SafeURL(prefix(lang) + "/colophon") }
				class="inline-flex items-center gap-1.5 text-sm text-link hover:underline mt-12 font-mono"
			>
				@IconArrowLeft("w-3.5 h-3.5")
				<span>{ ui.Nav_Colophon }</span>
			</a>
		</div>
	</section>
}

templ resumeRole(title string, company string, period string, location string, bullets []string) {
	<div>
		<div class="flex items-start justify-between gap-4">
			<div>
				<p class="text-sm font-medium text-text">{ title }</p>
				<p class="text-xs text-muted">{ company } · { location }</p>
			</div>
			<span class="text-xs text-muted shrink-0 font-mono">{ period }</span>
		</div>
		<ul class="mt-2 flex flex-col gap-1 pl-3">
			for _, b := range bullets {
				<li class="text-xs text-muted leading-relaxed list-disc list-inside">{ b }</li>
			}
		</ul>
	</div>
}
