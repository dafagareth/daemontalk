package templates

import "daemontalk/internal/i18n"

// AdminLayout is a minimal shell for the admin dashboard.
// Top navigation with text-only tabs, no sidebar, no decorative branding.
templ AdminLayout(page string, currentPath string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		@headTags(page, currentPath, PageMeta{}, true)
		<body class="min-h-screen flex flex-col bg-bg text-text antialiased selection:bg-[var(--c-link-bg)] selection:text-[var(--c-link-text)]">
			<header class="sticky top-0 z-30 bg-bg border-b border-border">
				<div class="max-w-6xl mx-auto px-4 sm:px-6">
					<div class="h-14 flex items-center justify-between gap-4">
						<div class="flex items-center gap-8 lg:gap-12">
							<a href="/admin" class="flex items-center gap-2 shrink-0" aria-label="daemontalk admin">
								@BrandLogo("h-5 w-auto")
								<span class="text-xs text-muted font-mono">admin</span>
							</a>
							<nav class="hidden sm:flex items-center gap-3 md:gap-4" id="admin-nav-links">
								<a href="/admin" onclick="switchAdminTab('dashboard', event)" data-tab="dashboard" data-tab-btn="dashboard" class="admin-tab active">Dashboard</a>
								<a href="/admin/content" onclick="switchAdminTab('content', event)" data-tab="content" data-tab-btn="content" class="admin-tab">Content</a>
								<a href="/admin/analytics" onclick="switchAdminTab('analytics', event)" data-tab="analytics" data-tab-btn="analytics" class="admin-tab">Analytics</a>
								<a href="/admin/comments" onclick="switchAdminTab('comments', event)" data-tab="comments" data-tab-btn="comments" class="admin-tab">Comments</a>
								<a href="/admin/digest" onclick="switchAdminTab('digest', event)" data-tab="digest" data-tab-btn="digest" class="admin-tab">Digest</a>
							</nav>
						</div>
						<div class="flex items-center gap-3">
							<a href="/" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1 text-xs text-muted hover:text-text px-2.5 py-1.5 transition-colors">
								<span>View Site</span>
								@iconArrowUpRight()
							</a>
							<button onclick="toggleTheme()" aria-label="Toggle theme" class="w-8 h-8 flex items-center justify-center rounded-none hover:bg-hover transition-colors text-muted hover:text-text">
								@sunIcon()
								@moonIcon()
							</button>
						</div>
					</div>
					<!-- Mobile tabs -->
					<div class="flex sm:hidden items-center gap-2 pb-2 overflow-x-auto -mt-1">
						<a href="/admin" onclick="switchAdminTab('dashboard', event)" data-tab="dashboard" data-tab-btn="dashboard" class="admin-tab active text-xs shrink-0">Dashboard</a>
						<a href="/admin/content" onclick="switchAdminTab('content', event)" data-tab="content" data-tab-btn="content" class="admin-tab text-xs shrink-0">Content</a>
						<a href="/admin/analytics" onclick="switchAdminTab('analytics', event)" data-tab="analytics" data-tab-btn="analytics" class="admin-tab text-xs shrink-0">Analytics</a>
						<a href="/admin/comments" onclick="switchAdminTab('comments', event)" data-tab="comments" data-tab-btn="comments" class="admin-tab text-xs shrink-0">Comments</a>
						<a href="/admin/digest" onclick="switchAdminTab('digest', event)" data-tab="digest" data-tab-btn="digest" class="admin-tab text-xs shrink-0">Digest</a>
					</div>
				</div>
			</header>
			<main class="flex-1 w-full bg-bg">
				@content
			</main>
			<script src="/static/js/admin.js" defer></script>
			@confirmModal(i18n.Get("en"))
		</body>
	</html>
}
