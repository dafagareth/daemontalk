package templates

import (
	"fmt"
	"daemontalk/internal/comment"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ BlogPostPage(ui i18n.UI, p post.Post, related []post.Post, comments []comment.Comment, views int, isAdmin bool, lang string, reactions map[string]int, seriesParts []post.Post, nav PostNav, userReaction string, visitorName string) {
	<!-- Reading progress bar (fixed at top with z-50 above all elements) -->
	<div id="reading-progress" class="fixed top-0 left-0 z-50 h-[3px] bg-[var(--c-link)] shadow-sm pointer-events-none transition-[width] duration-75" style="width:0%"></div>

	<!-- Back to top floating button -->
	<button
		id="back-to-top"
		onclick="window.scrollTo({top:0,behavior:'smooth'})"
		aria-label="Back to top"
		class="fixed bottom-6 right-6 z-40 p-2.5 rounded-none bg-surface border border-border text-muted hover:text-text hover:border-[var(--c-link)] shadow-md transition-all duration-200 opacity-0 pointer-events-none cursor-pointer"
	>
		@IconArrowUp()
	</button>

	<!-- Main Post Article Container (2 Column Layout) -->
	<div class="container-page py-8 sm:py-12 transition-all">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
			<!-- Left Column: Article Content -->
			<div class="lg:col-span-8">
				<article>
					<header class="mb-8">
						<div class="flex items-center justify-between gap-4 mb-4">
							<a href={ templ.SafeURL(homeURL(lang)) } class="text-xs font-mono text-muted hover:text-link transition-colors inline-flex items-center gap-1">
								@iconArrowLeft()
								<span>{ ui.Post_Back }</span>
							</a>
						</div>
						<!-- Series navigation (if part of a series) -->
						if len(seriesParts) > 1 {
							@seriesNav(seriesParts, p, lang)
						}
						<div class="mb-4">
							<h1 class="font-sans font-black text-2xl sm:text-3xl lg:text-4xl tracking-tight text-text leading-[1.15]">{ p.Title }</h1>
						</div>
						<div class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted mt-4">
							<span class="font-bold text-text">
								if p.Author != "" {
									{ p.Author }
								} else {
									daemontalk team
								}
							</span>
							<span>·</span>
							<span>{ fmtDate(p) }</span>
							<span>·</span>
							<span>{ fmt.Sprintf("%d %s", p.ReadTime, ui.Blog_MinRead) }</span>
						</div>
						if len(p.Tags) > 0 {
							<div class="flex flex-wrap gap-2 mt-3">
								for _, t := range p.Tags {
									<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/tag/" + t) } class="text-xs px-2 py-0.5 bg-chip text-muted rounded-none-none font-mono hover:text-text transition-colors">{ t }</a>
								}
							</div>
						}
					</header>
					if p.Cover != "" {
						<div class="mb-8 flex justify-center">
							<img src={ p.Cover } alt={ p.Title } loading="lazy" class="rounded-none-none max-h-72 w-auto max-w-full"/>
						</div>
					}
					<!-- Mobile Reading Tools -->
					<div class="lg:hidden flex flex-wrap items-center justify-between gap-3 mb-8 p-4 border border-border rounded-none-none bg-surface">
						<div class="flex items-center rounded-none-none border border-border overflow-hidden text-xs font-mono">
							<button onclick="adjustProseSize(-1)" aria-label="Decrease font size" class="px-3 py-1.5 hover:bg-hover text-text transition-colors border-r border-border">A-</button>
							<button onclick="adjustProseSize(1)" aria-label="Increase font size" class="px-3 py-1.5 hover:bg-hover text-text transition-colors border-r border-border">A+</button>
							<button onclick="toggleSerif()" aria-label="Toggle serif font" class="serif-toggle-btn px-3 py-1.5 font-serif hover:bg-hover text-muted transition-colors">Serif</button>
						</div>
						<div class="flex items-center gap-2">
							<button onclick="setTheme('light')" aria-label="White Theme" class="w-6 h-6 rounded-none border border-border bg-[#fafafa]"></button>
							<button onclick="setTheme('sepia')" aria-label="Sepia Theme" class="w-6 h-6 rounded-none border border-border bg-[#fbf0d9]"></button>
							<button onclick="setTheme('dark')" aria-label="Dark Theme" class="w-6 h-6 rounded-none border border-border bg-[#09090b]"></button>
						</div>
						<button onclick="toggleBookmark(this)" data-slug={ p.Slug } data-title={ p.Title } data-date={ p.Date.Format("2006-01-02") } class="bookmark-btn border border-border px-3 py-1 rounded-none-none bg-bg text-text">☆</button>
					</div>
					if len(p.TOC) > 0 {
						<details open class="mb-8 border border-border rounded-none-none bg-surface p-4 sm:p-5">
							<summary class="text-sm font-semibold text-text cursor-pointer select-none list-none flex items-center justify-between">
								<span class="font-mono text-xs uppercase tracking-wider text-muted">
									{ ui.Post_TOC }
								</span>
								@IconChevronDown("toc-chevron w-4 h-4 text-muted transition-transform")
							</summary>
							<nav class="mt-3 pt-3 border-t border-border/60">
								@tocList(p.TOC)
							</nav>
						</details>
					}
					<div id="prose-body" class="prose md:prose-lg max-w-none">
						@templ.Raw(string(p.Body))
					</div>
				</article>
			</div> <!-- Close left column -->

			<!-- Right Column: Sidebar -->
			<div class="lg:col-span-4 hidden lg:block">
				<div class="sticky top-20 flex flex-col gap-6">
					
					// Reading Tools & Share Widget
					<div class="border border-border bg-surface p-5 flex flex-col rounded-none-none">
						<h3 class="font-sans text-xs font-black uppercase tracking-wider text-text mb-4 pb-2 border-b border-border">
							READING TOOLS
						</h3>
						
						<div class="flex flex-col gap-4">
							<div class="flex items-center justify-between">
								<span class="text-xs font-mono text-muted uppercase tracking-wider">Font Size</span>
								<div class="flex items-center rounded-none-none border border-border overflow-hidden text-xs font-mono">
									<button onclick="adjustProseSize(-1)" aria-label="Decrease font size" class="px-3 py-1 hover:bg-hover text-muted hover:text-text transition-colors border-r border-border cursor-pointer">A-</button>
									<button onclick="adjustProseSize(1)" aria-label="Increase font size" class="px-3 py-1 hover:bg-hover text-muted hover:text-text transition-colors cursor-pointer">A+</button>
								</div>
							</div>
							
							<div class="flex items-center justify-between">
								<span class="text-xs font-mono text-muted uppercase tracking-wider">Typeface</span>
								<button onclick="toggleSerif()" aria-label="Toggle serif font" class="serif-toggle-btn text-xs font-serif px-3 py-1 border border-border rounded-none-none text-muted hover:text-text hover:bg-hover transition-colors cursor-pointer">
									Serif
								</button>
							</div>

							<div class="flex items-center justify-between mt-1">
								<span class="text-xs font-mono text-muted uppercase tracking-wider">Theme</span>
								<div class="flex items-center gap-2">
									<button onclick="setTheme('light')" aria-label="White Theme" class="w-5 h-5 rounded-none border border-border bg-[#fafafa] hover:ring-2 ring-offset-1 ring-[var(--c-link)] transition-all cursor-pointer"></button>
									<button onclick="setTheme('sepia')" aria-label="Sepia Theme" class="w-5 h-5 rounded-none border border-border bg-[#fbf0d9] hover:ring-2 ring-offset-1 ring-[var(--c-link)] transition-all cursor-pointer"></button>
									<button onclick="setTheme('dark')" aria-label="Dark Theme" class="w-5 h-5 rounded-none border border-border bg-[#09090b] hover:ring-2 ring-offset-1 ring-[var(--c-link)] transition-all cursor-pointer"></button>
								</div>
							</div>

							<div class="flex items-center justify-between">
								<span class="text-xs font-mono text-muted uppercase tracking-wider">Save Post</span>
								<button
									onclick="toggleBookmark(this)"
									data-slug={ p.Slug }
									data-title={ p.Title }
									data-date={ p.Date.Format("2006-01-02") }
									aria-label="Bookmark post"
									class="bookmark-btn text-xs font-mono px-3 py-1 border border-border rounded-none-none text-muted hover:text-text hover:bg-hover transition-colors cursor-pointer"
								>
									☆
								</button>
							</div>
							
							@langBadge(p.Lang)
						</div>
					</div>

					<div class="border border-border bg-surface p-5 flex flex-col rounded-none-none">
						<h3 class="font-sans text-xs font-black uppercase tracking-wider text-text mb-4 pb-2 border-b border-border">
							SHARE
						</h3>
						<div class="flex flex-col gap-2">
							<button
								onclick="copyPostLink(this)"
								class="flex items-center gap-2 text-xs px-3 py-2 border border-border rounded-none-none text-muted hover:bg-hover hover:text-text transition-colors font-mono uppercase tracking-wider w-full"
							>
								@IconCopy("w-3 h-3 shrink-0")
								Copy link
							</button>
							<a
								href={ templ.SafeURL("https://x.com/intent/tweet?url=" + "https://daemontalk.com/blog/" + p.Slug + "&text=" + p.Title) }
								target="_blank" rel="noopener"
								class="flex items-center gap-2 text-xs px-3 py-2 border border-border rounded-none-none text-muted hover:bg-hover hover:text-text transition-colors font-mono uppercase tracking-wider w-full"
							>
								@IconX()
								X / Twitter
							</a>
							<a
								href={ templ.SafeURL("https://wa.me/?text=" + p.Title + " https://daemontalk.com/blog/" + p.Slug) }
								target="_blank" rel="noopener"
								class="flex items-center gap-2 text-xs px-3 py-2 border border-border rounded-none-none text-muted hover:bg-hover hover:text-text transition-colors font-mono uppercase tracking-wider w-full"
							>
								@IconWhatsApp("w-3 h-3 shrink-0")
								WhatsApp
							</a>
						</div>
					</div>

				</div>
			</div>
		</div> <!-- Close Grid -->

		<!-- Bottom components (Reactions & Comments) aligned with left column -->
		<div class="lg:w-8/12 mt-10">
			<!-- Reactions -->
			@ReactionsBar(ui, reactions, p.Slug, lang, userReaction)

			<!-- Comments -->
			@commentsSection(ui, p.Slug, lang, comments, isAdmin, visitorName)
		</div>

		<!-- Related Posts (Full Width) -->
		if len(related) > 0 {
			<div class="mt-16 pt-8 border-t-4 border-[var(--c-text)]">
				<h3 class="text-xl font-bold font-sans text-text mb-6 uppercase tracking-widest">{ ui.Post_Related }</h3>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
					for _, rp := range related {
						@blogCardItem(ui, rp, lang, nil, false)
					}
				</div>
			</div>
		}
	</div> <!-- Close Main Container -->
	@blogPostScripts()
}



templ tocList(entries []post.TOCEntry) {
	<ul class="space-y-1.5 text-xs font-mono">
		for _, e := range entries {
			<li class={ templ.KV("pl-3 sm:pl-4", e.Level == 3), templ.KV("pl-6 sm:pl-8", e.Level == 4) }>
				<a
					href={ templ.SafeURL("#" + e.ID) }
					class="toc-link block py-0.5 text-muted hover:text-link font-mono transition-colors leading-relaxed truncate"
				>
					{ e.Title }
				</a>
			</li>
		}
	</ul>
}

// ReactionsBar renders the emoji reaction row for a post. Exported for the reaction handler.
templ ReactionsBar(ui i18n.UI, reactions map[string]int, slug string, lang string, userReaction string) {
	<div id="reactions-bar" class="flex flex-wrap items-center gap-2">
		<p class="text-xs text-muted w-full mb-1 font-medium uppercase tracking-wide">Reactions</p>
		for _, emoji := range []string{"👍", "❤️", "🔥", "🤯", "💡"} {
			<button
				class={ "reaction-btn", templ.KV("reaction-active", emoji == userReaction) }
				hx-post={ blogPrefix(lang) + "/blog/" + slug + "/reactions/" + emoji }
				hx-target="#reactions-bar"
				hx-swap="outerHTML"
			>
				{ emoji }
				if reactions[emoji] > 0 {
					<span class="reaction-count">{ fmt.Sprintf("%d", reactions[emoji]) }</span>
				}
			</button>
		}
	</div>
}

// seriesNav renders a compact series navigation card above the article.
templ seriesNav(parts []post.Post, current post.Post, lang string) {
	<div class="mb-8 p-4 border border-border rounded-none-none bg-surface">
		<p class="text-xs font-medium text-muted uppercase tracking-wide mb-3">
			Series · { current.Series }
		</p>
		<ol class="space-y-1.5">
			for i, part := range parts {
				<li class="flex items-start gap-2 text-sm">
					<span class="shrink-0 font-mono text-xs text-muted mt-0.5">{ fmt.Sprintf("%d.", i+1) }</span>
					if part.Slug == current.Slug {
						<span class="font-medium text-text">{ part.Title }</span>
					} else {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + part.Slug) } class="text-link hover:underline">{ part.Title }</a>
					}
				</li>
			}
		</ol>
	</div>
}

templ blogPostNav(nav PostNav, ui i18n.UI, lang string) {
	<nav class="mt-10 pt-6 grid grid-cols-2 gap-4">
		<div>
			if nav.HasPrev {
				<a
					href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + nav.Prev.Slug) }
					class="group flex flex-col gap-1 text-left"
				>
					<span class="text-xs text-muted font-mono inline-flex items-center gap-1">@iconArrowLeft() Older</span>
					<span class="text-sm text-link group-hover:underline line-clamp-2 leading-snug">{ nav.Prev.Title }</span>
				</a>
			}
		</div>
		<div class="text-right">
			if nav.HasNext {
				<a
					href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + nav.Next.Slug) }
					class="group flex flex-col gap-1 items-end"
				>
					<span class="text-xs text-muted font-mono inline-flex items-center gap-1">Newer @iconArrowRight()</span>
					<span class="text-sm text-link group-hover:underline line-clamp-2 leading-snug text-right">{ nav.Next.Title }</span>
				</a>
			}
		</div>
	</nav>
}
