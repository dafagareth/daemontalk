package templates

import (
	"fmt"
	"daemontalk/internal/comment"
	"daemontalk/internal/i18n"
	"daemontalk/internal/post"
)

templ BlogPostPage(ui i18n.UI, p post.Post, related []post.Post, comments []comment.Comment, views int, isAdmin bool, lang string, reactions map[string]int, seriesParts []post.Post, nav PostNav, userReaction string, visitorName string) {
	<!-- Reading progress bar (fixed at top with z-50 above all elements) -->
	<div id="reading-progress" class="fixed top-0 left-0 z-50 h-[3px] bg-[var(--c-link)] shadow-sm pointer-events-none transition-[width] duration-75" style="width:0%"></div>

	<!-- Back to top floating button -->
	<button
		id="back-to-top"
		onclick="window.scrollTo({top:0,behavior:'smooth'})"
		aria-label="Back to top"
		class="fixed bottom-6 right-6 z-40 p-2.5 rounded-none bg-surface border border-border text-muted hover:text-text hover:border-[var(--c-link)] shadow-md transition-all duration-200 opacity-0 pointer-events-none cursor-pointer"
	>
		@IconArrowUp()
	</button>

	<!-- Main Post Article Container (2 Column Layout) -->
	<div class="container-page py-8 sm:py-12 transition-all">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
			<!-- Left Column: Article Content -->
			<div class="lg:col-span-8">
				<article>
					@blogHeader(ui, p, lang, seriesParts)
					@blogContent(ui, p)
					if len(seriesParts) > 1 {
						@seriesBottomNav(seriesParts, p, lang)
					}
					</article>
			</div> <!-- Close left column -->

			<!-- Right Column: Sidebar -->
			<div class="lg:col-span-4 hidden lg:block">
				@blogSidebar(p)
			</div>
		</div> <!-- Close Grid -->

		<!-- Bottom components (Reactions & Comments) aligned with left column -->
		<div class="lg:w-8/12 mt-10">
			<!-- Reactions -->
			@ReactionsBar(ui, reactions, p.Slug, lang, userReaction)

			<!-- Comments -->
			@commentsSection(ui, p.Slug, lang, comments, isAdmin, visitorName)
		</div>

		@blogRelated(ui, related, lang)
	</div> <!-- Close Main Container -->
	@blogPostScripts()
}



templ tocList(entries []post.TOCEntry) {
	<ul class="space-y-2 text-sm sm:text-[15px] font-mono">
		for _, e := range entries {
			<li class={ templ.KV("pl-4 sm:pl-5 text-sm", e.Level == 3), templ.KV("pl-8 sm:pl-10 text-xs sm:text-sm", e.Level == 4) }>
				<a
					href={ templ.SafeURL("#" + e.ID) }
					class="toc-link block py-0.5 text-muted hover:text-link font-mono transition-colors leading-relaxed"
				>
					{ e.Title }
				</a>
			</li>
		}
	</ul>
}



func getSeriesCurrentIndex(parts []post.Post, slug string) int {
	for i, p := range parts {
		if p.Slug == slug {
			return i
		}
	}
	return 0
}

func getSeriesPart(parts []post.Post, idx int) *post.Post {
	if idx >= 0 && idx < len(parts) {
		return &parts[idx]
	}
	return nil
}

// seriesNav renders a structured series header card at top.
templ seriesNav(parts []post.Post, current post.Post, lang string) {
	<div class="mb-8 p-4 sm:p-5 border border-border bg-surface not-prose">
		<div class="flex items-center justify-between pb-2.5 mb-3 border-b border-border/70">
			<div class="flex items-center gap-2">
				<svg class="w-4 h-4 text-link shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
				<span class="font-mono text-xs font-bold uppercase tracking-wider text-text">SERIES: { current.Series }</span>
			</div>
			<span class="font-mono text-[11px] px-2 py-0.5 bg-chip border border-border text-muted">
				{ fmt.Sprintf("Part %d of %d", getSeriesCurrentIndex(parts, current.Slug)+1, len(parts)) }
			</span>
		</div>
		<ol class="space-y-1.5 m-0 p-0 list-none font-sans text-sm">
			for i, part := range parts {
				<li class="flex items-start gap-2.5 py-1 px-2 rounded-none transition-colors">
					<span class="shrink-0 font-mono text-xs font-bold text-muted mt-0.5">{ fmt.Sprintf("[%02d]", i+1) }</span>
					if part.Slug == current.Slug {
						<span class="font-semibold text-text border-l-2 border-link pl-2">{ part.Title } <span class="text-xs text-link font-mono font-normal">(Current)</span></span>
					} else {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + part.Slug) } class="text-muted hover:text-link transition-colors pl-2">{ part.Title }</a>
					}
				</li>
			}
		</ol>
	</div>
}

// seriesBottomNav renders dedicated Prev / Next episode buttons in series at the bottom.
templ seriesBottomNav(parts []post.Post, current post.Post, lang string) {
	if currIdx := getSeriesCurrentIndex(parts, current.Slug); currIdx >= 0 {
		if prevPart := getSeriesPart(parts, currIdx-1); prevPart != nil || getSeriesPart(parts, currIdx+1) != nil {
			<div class="my-8 p-4 border border-border bg-surface not-prose">
				<div class="text-[11px] font-mono text-muted uppercase tracking-wider mb-3">
					Series Navigation · { current.Series }
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					if prevPart != nil {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + prevPart.Slug) } class="flex flex-col gap-1 p-3 border border-border bg-bg/50 hover:border-link transition-colors group">
							<span class="text-[11px] font-mono text-muted flex items-center gap-1">@iconArrowLeft() Previous in Series</span>
							<span class="text-xs sm:text-sm font-medium text-text group-hover:text-link line-clamp-1">{ prevPart.Title }</span>
						</a>
					} else {
						<div></div>
					}
					if nextPart := getSeriesPart(parts, currIdx+1); nextPart != nil {
						<a href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + nextPart.Slug) } class="flex flex-col gap-1 p-3 border border-border bg-bg/50 hover:border-link transition-colors text-right group">
							<span class="text-[11px] font-mono text-muted flex items-center gap-1 justify-end">Next in Series @iconArrowRight()</span>
							<span class="text-xs sm:text-sm font-medium text-text group-hover:text-link line-clamp-1">{ nextPart.Title }</span>
						</a>
					}
				</div>
			</div>
		}
	}
}

templ blogPostNav(nav PostNav, ui i18n.UI, lang string) {
	if nav.HasPrev || nav.HasNext {
		<nav class="mt-8 pt-6 border-t border-border grid grid-cols-2 gap-4">
			<div>
				if nav.HasPrev {
					<a
						href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + nav.Prev.Slug) }
						class="group flex flex-col gap-1 text-left"
					>
						<span class="text-xs text-muted font-mono inline-flex items-center gap-1">@iconArrowLeft() Older</span>
						<span class="text-sm text-link group-hover:underline line-clamp-2 leading-snug">{ nav.Prev.Title }</span>
					</a>
				}
			</div>
			<div class="text-right">
				if nav.HasNext {
					<a
						href={ templ.SafeURL(blogPrefix(lang) + "/blog/" + nav.Next.Slug) }
						class="group flex flex-col gap-1 items-end"
					>
						<span class="text-xs text-muted font-mono inline-flex items-center gap-1">Newer @iconArrowRight()</span>
						<span class="text-sm text-link group-hover:underline line-clamp-2 leading-snug text-right">{ nav.Next.Title }</span>
					</a>
				}
			</div>
		</nav>
	}
}
