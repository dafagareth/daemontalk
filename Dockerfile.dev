# Development container image: includes Go, Node.js 22 LTS, Templ, Air, and live-reloading tools.

FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV GOCACHE=/tmp/go-cache
ENV GOPATH=/tmp/go-path
ENV HOME=/tmp

RUN curl -fsSL https://github.com/a-h/templ/releases/download/v0.3.1020/templ_Linux_x86_64.tar.gz \
        | tar -xz -C /usr/local/bin templ \
    && chmod +x /usr/local/bin/templ \
    && curl -fsSL https://github.com/air-verse/air/releases/download/v1.67.4/air_1.67.4_linux_amd64 \
        -o /usr/local/bin/air \
    && chmod +x /usr/local/bin/air \
    && curl -fsSL https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64 \
        -o /usr/local/bin/tailwindcss \
    && chmod +x /usr/local/bin/tailwindcss

EXPOSE 8080

CMD ["make", "dev"]
