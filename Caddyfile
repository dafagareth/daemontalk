# Caddyfile configuration for DaemonTalk
# Automatically manages Let's Encrypt / ZeroSSL certificates

daemontalk.com {
    redir https://www.daemontalk.com{uri} permanent
}

www.daemontalk.com {
    # Modern compression
    encode zstd gzip

    # Reverse proxy all HTTP traffic to DaemonTalk Docker container
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Access logs
    log {
        output file /var/log/caddy/daemontalk_access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
